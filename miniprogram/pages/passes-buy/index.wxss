.page {
  min-height: 100vh;
  background: #F9F4DF;
  padding-bottom: 160rpx;
}
.pt-safe {
  padding-top: calc(88rpx + env(safe-area-inset-top));
}
.head-row { align-items: center; }
.back-wrap { align-items: center; gap: 12rpx; }
.icon-back {
  width: 32rpx; height: 32rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M15 5L8 12L15 19" stroke="%231A1A23" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>') no-repeat center/contain;
}
.page-title {
  font-size: 48rpx; font-weight: 800; color: #1A1A23;
}

/* 我的次卡 */
.my-pass {
  margin-top: 32rpx;
  background: #1A1A23;
  border-radius: 28rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.mp-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
}
.mp-num {
  display: block;
  margin-top: 8rpx;
  font-size: 64rpx;
  font-weight: 800;
  color: #B9FF66;
  line-height: 1;
}
.mp-unit {
  font-size: 28rpx;
}
.mp-expire {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}
.mp-danger {
  color: #FF8FA3;
}
.mp-tag {
  padding: 10rpx 22rpx;
  border-radius: 30rpx;
  background: #B9FF66;
  color: #1A1A23;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.mp-tag-gray {
  background: #3A3A45;
  color: #B0AFA8;
}

/* 档位 */
.pkg-list {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.pkg {
  position: relative;
  background: #FFFFFF;
  border: 3rpx solid #E8E2CC;
  border-radius: 28rpx;
  padding: 28rpx;
}
.pkg-on {
  border-color: #1A1A23;
  background: #FFFDF4;
}
.pkg-head { align-items: center; }
.pkg-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #1A1A23;
}
.pkg-price {
  font-size: 40rpx;
  font-weight: 800;
  color: #5B57EB;
}
.pkg-meta {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6B6B76;
  font-weight: 600;
}
.pkg-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8A8A8A;
  line-height: 1.6;
  padding-right: 50rpx;
}
.pkg-check {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #1A1A23;
  color: #B9FF66;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 规则提示 */
.rule-tip {
  margin-top: 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 0 8rpx;
}
.rt-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #5B57EB;
  margin-top: 10rpx;
  flex-shrink: 0;
}
.rt-warn .rt-dot { background: #E5484D; }
.rt-txt {
  flex: 1;
  font-size: 24rpx;
  color: #6B6B76;
  line-height: 1.7;
}
.rt-warn .rt-txt { color: #B02E3C; }

/* 底部 CTA */
.cta-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #FFFFFF;
  border-top: 1rpx solid #E8E2CC;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  align-items: center;
  z-index: 10;
}
.cta-price {
  font-size: 40rpx;
  font-weight: 800;
  color: #1A1A23;
}
.cta-sub {
  font-size: 24rpx;
  color: #8A8A8A;
  margin-top: 4rpx;
}
.pay-btn {
  background: #1A1A23;
  color: #B9FF66;
  font-size: 30rpx;
  font-weight: 700;
  padding: 22rpx 64rpx;
  border-radius: 48rpx;
}
.btn-disabled {
  opacity: 0.5;
}
