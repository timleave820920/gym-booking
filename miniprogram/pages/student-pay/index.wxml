<view class="page" wx:if="{{course}}">
  <view class="page-pad pt-16">
    <!-- 课程信息卡：教练头像 + 课程名/时间段/年月日星期/场馆/原价 -->
    <view class="course-card flex-row">
      <image class="course-cover" src="{{course.coachAvatar || '/images/2_295.png'}}" mode="aspectFill"></image>
      <view class="flex-col flex-1 course-info">
        <text class="course-name">{{course.name}}</text>
        <text class="course-time">{{course.time}}</text>
        <text class="course-meta">{{course.dateText}}</text>
        <text class="course-meta">{{course.venue}}</text>
        <view class="flex-row price-row">
          <text class="course-price">¥{{course.price}}</text>
          <text class="price-origin">单次价</text>
        </view>
      </view>
    </view>

    <!-- 金额卡 -->
    <view class="amount-card flex-col">
      <text class="amount-label">{{usePass ? '本次抵扣（次数包）' : '需支付金额（元）'}}</text>
      <text class="amount-value">¥ {{totalPrice || (usePass ? 0 : course.price)}}</text>
      <text class="amount-sub" wx:if="{{usePass}}">次数包剩余 {{passRemaining}} 次，本次自动扣 1 次</text>
    </view>

    <!-- 次卡优先提示 -->
    <view class="pass-hint" wx:if="{{passHint}}">{{passHint}}</view>

    <!-- 支付方式（有可用次卡 → 置灰不可选，不默认选中任何一项） -->
    <view class="section-title">选择支付方式</view>
    <view class="method-list {{usePass ? 'method-list-off' : ''}}">
      <view class="method-row flex-between {{item.selected ? 'method-selected' : ''}} {{usePass ? 'method-row-off' : ''}}"
            wx:for="{{payMethods}}" wx:key="id"
            data-id="{{item.id}}" bindtap="selectMethod">
        <view class="flex-row method-left">
          <view class="method-icon flex-center {{item.id === 1 ? 'icon-wallet' : 'icon-card'}}"></view>
          <view class="flex-col">
            <text class="method-name">{{item.name}}</text>
            <text class="method-desc">{{item.desc}}</text>
            <!-- 会员折扣提示：余额支付享等级折扣 -->
            <text class="member-tip" wx:if="{{item.id === 2 && memberLevel && memberLevel.discount < 1 && !usePass}}">
              {{memberLevel.levelName}}会员价 ¥{{memberPrice}}（{{memberLevel.discountText}}）
            </text>
          </view>
        </view>
        <view class="radio {{item.selected ? 'radio-on' : ''}}">
          <view class="radio-dot" wx:if="{{item.selected}}"></view>
        </view>
      </view>
    </view>
    <!-- 次卡支付说明（置灰区下补充说明，避免用户困惑为什么不能选） -->
    <view class="pass-lock-tip" wx:if="{{usePass}}">本次使用次数包抵扣，无需选择支付方式</view>

    <!-- 候补自动取消时间（仅排位模式）：到期未转正自动退款 -->
    <view class="expire-section" wx:if="{{course.mode === 'waitlist'}}">
      <view class="section-title">自动取消时间</view>
      <text class="expire-sub">排位到期仍未转正，将自动取消并原路退款</text>
      <view class="expire-list flex-row">
        <view class="expire-item flex-col {{selectedExpire === item.id ? 'expire-on' : ''}}"
              wx:for="{{expireModes}}" wx:key="id"
              data-id="{{item.id}}" bindtap="selectExpire">
          <text class="expire-name">{{item.name}}</text>
          <text class="expire-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <view class="spacer"></view>
  </view>

  <!-- 底部 CTA -->
  <view class="cta-bar flex-between">
    <view class="flex-col">
      <text class="cta-price">¥ {{totalPrice || (usePass ? 0 : course.price)}}</text>
      <text class="cta-sub">{{payText}}</text>
    </view>
    <view class="pay-btn" bindtap="pay">
      <text>{{usePass ? '使用次数包' : '确认支付'}}</text>
    </view>
  </view>
</view>
