<view class="page">
  <view class="page-pad pt-safe">
    <view class="head-row">
      <text class="page-title">个人中心</text>
    </view>

    <!-- 用户卡 -->
    <view class="user-card flex-row">
      <image class="user-avatar" src="{{user.avatar}}" mode="aspectFill" binderror="avatarError"></image>
      <view class="flex-col flex-1">
        <text class="user-name">{{user.name}}</text>
        <text class="user-desc">{{user.desc}}</text>
      </view>
      <text class="icon-chevron"></text>
    </view>

    <!-- 储值余额 + 活动中心 -->
    <view class="balance-card flex-row" bindtap="goMemberCenter">
      <view class="flex-col flex-1">
        <text class="balance-label">储值余额</text>
        <text class="balance-value {{balanceAnim ? 'balance-anim' : ''}}">¥ {{balance}}</text>
      </view>
      <view class="flex-col coin-block">
        <text class="coin-block-label">⚡ 能量币</text>
        <text class="coin-block-value">{{coinBalance}}</text>
      </view>
      <view class="center-entry flex-row">
        <text class="center-entry-txt">活动中心</text>
        <text class="icon-chevron-sm"></text>
      </view>
    </view>

    <!-- 菜单组 -->
    <view class="menu-group" wx:for="{{menus}}" wx:key="index" wx:for-item="group">
      <view class="menu-row flex-row" wx:for="{{group}}" wx:key="name"
            data-url="{{item.url}}" bindtap="goMenu">
        <view class="menu-icon {{'icon-' + item.icon}}"></view>
        <text class="menu-name">{{item.name}}</text>
        <text class="icon-chevron-sm"></text>
      </view>
    </view>

    <!-- 测试入口（演示用） -->
    <view class="test-section">
      <text class="test-title">角色入口 · 演示</text>
      <view class="menu-group">
        <view class="menu-row flex-row" wx:for="{{testEntries}}" wx:key="name"
              data-url="{{item.url}}" bindtap="goMenu">
          <view class="menu-icon {{'icon-' + item.icon}}"></view>
          <text class="menu-name">{{item.name}}</text>
          <text class="icon-chevron-sm"></text>
        </view>
      </view>
      <text class="test-hint">正式版将按角色登录分流，此入口仅用于演示</text>
    </view>

    <!-- 退出登录 -->
    <view class="logout-btn" bindtap="logout">
      <text>退出登录</text>
    </view>

    <view class="list-spacer"></view>
  </view>
</view>
