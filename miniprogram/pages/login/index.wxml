<view class="page">
  <!-- 语言切换（左上角） -->
  <view class="lang-switch" bindtap="switchLang">
    <text class="lang-txt">{{lang === 'zh' ? 'EN' : '中'}}</text>
  </view>

  <!-- 品牌区 -->
  <view class="brand-area">
    <view class="logo-badge">
      <view class="logo-icon"></view>
    </view>
    <text class="brand-name">{{t.gymName}}</text>
    <text class="brand-slogan">{{t.brandSlogan}}</text>
  </view>

  <!-- 登录表单区 -->
  <view class="form-area">
    <!-- 微信一键登录 -->
    <view class="wx-btn flex-row" bindtap="login">
      <view class="wx-icon flex-center">
        <text class="wx-icon-in">微</text>
      </view>
      <text class="wx-btn-txt">{{loggingIn ? t.wxLoggingIn : t.wxLogin}}</text>
    </view>

    <!-- 或分隔线 -->
    <view class="or-divider flex-row">
      <view class="or-line"></view>
      <text class="or-txt">{{t.or}}</text>
      <view class="or-line"></view>
    </view>

    <!-- 手机号快捷登录（微信官方手机号授权） -->
    <button class="phone-btn flex-row" open-type="getPhoneNumber" bindgetphonenumber="phoneLogin">
      <view class="phone-icon flex-center">
        <view class="phone-svg"></view>
      </view>
      <text class="phone-btn-txt">{{t.phoneLogin}}</text>
    </button>

    <!-- 协议勾选 -->
    <view class="agree-row flex-row" bindtap="toggleAgree">
      <view class="agree-box flex-center {{agreed ? 'agree-on' : ''}}">
        <text class="agree-check" wx:if="{{agreed}}">✓</text>
      </view>
      <text class="agree-txt">{{t.agreeText}}</text>
    </view>

    <text class="login-hint">{{t.loginAsStudent}}</text>
    <text class="login-hint2">{{t.firstLoginHint}}</text>

    <!-- 演示身份入口 -->
    <view class="demo-divider flex-row">
      <view class="demo-line"></view>
      <text class="demo-txt">{{t.demoEntry}}</text>
      <view class="demo-line"></view>
    </view>
    <view class="demo-roles flex-row">
      <view class="demo-role" data-role="student" bindtap="quickLogin">
        <view class="demo-ico demo-ico-student"></view>
        <text class="demo-role-txt">{{t.roleStudent}}</text>
      </view>
      <view class="demo-role" data-role="coach" bindtap="quickLogin">
        <view class="demo-ico demo-ico-coach"></view>
        <text class="demo-role-txt">{{t.roleCoach}}</text>
      </view>
      <view class="demo-role" data-role="admin" bindtap="quickLogin">
        <view class="demo-ico demo-ico-admin"></view>
        <text class="demo-role-txt">{{t.roleAdmin}}</text>
      </view>
    </view>
    <text class="demo-hint">{{t.demoHint}}</text>
  </view>
</view>
