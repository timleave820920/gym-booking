<view class="page">
  <!-- 固定顶部：问候语 + 当前时间 + 周日期选择条（下滑时保持不动） -->
  <view class="courses-head">
    <view class="page-pad pt-safe">
      <view class="flex-between">
        <view class="flex-col">
          <text class="greet-title">{{greeting}}</text>
          <text class="greet-date">{{user.date}}</text>
        </view>

      </view>

      <!-- B3：课程搜索框（按课程名/教练名过滤当天列表） -->
      <view class="search-bar flex-row">
        <view class="search-ico"></view>
        <input class="search-input" placeholder="搜索课程 / 教练" placeholder-class="search-ph"
               value="{{searchKeyword}}" bindinput="onSearchInput" confirm-type="search" />
        <text class="search-clear" wx:if="{{searchKeyword}}" bindtap="onSearchClear">✕</text>
      </view>

      <!-- 周日期选择条 -->
      <view class="date-bar flex-row">
        <view class="date-item flex-col {{item.selected ? 'date-active' : ''}}"
              wx:for="{{weekDays}}" wx:key="full"
              data-full="{{item.full}}" data-date="{{item.date}}" bindtap="selectDate">
          <text class="date-week {{item.selected ? 'week-active' : ''}}">{{item.weekday}}</text>
          <text class="date-num {{item.selected ? 'num-active' : ''}}">{{item.date}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 可滚动区：仅课程列表滚动 -->
  <scroll-view scroll-y class="list-scroll">
    <view class="list-pad">
      <!-- 后端不可用提示 -->
      <text class="offline-tip" wx:if="{{offline}}">后端未连接，当前展示演示数据</text>

      <!-- 课程列表 -->
      <view class="course-list">
      <!-- 骨架屏：无缓存首屏加载时展示（替代白屏等待） -->
      <view class="sk-list" wx:if="{{loading}}">
        <view class="sk-card" wx:for="{{[1,2,3]}}" wx:key="*this">
          <view class="sk-row">
            <view class="sk-avatar"></view>
            <view class="sk-lines">
              <view class="sk-line w60"></view>
              <view class="sk-line w40"></view>
            </view>
          </view>
          <view class="sk-row">
            <view class="sk-line w30"></view>
            <view class="sk-chip"></view>
          </view>
          <view class="sk-row">
            <view class="sk-line w15"></view>
            <view class="sk-btn"></view>
          </view>
        </view>
      </view>
      <view class="course-card {{item.disabled && !item.isBooked ? 'card-full' : ''}}" wx:for="{{searchKeyword ? searchResult : courseList}}" wx:key="id"
            bindtap="goDetail" data-id="{{item.id}}" data-disabled="{{item.disabled}}" data-waitlist="{{item.canWaitlist}}">
        <!-- 剩余席位 0：金色"满员"斜条；1~5：红色"紧张"斜条 -->
        <view class="ribbon ribbon-full" wx:if="{{item.remaining === 0}}">满员</view>
        <view class="ribbon" wx:if="{{item.remaining > 0 && item.remaining < 5}}">紧张</view>

        <view class="cb-main">
          <!-- 顶行：教练头像（点击进教练介绍页）+ 课程名 + 难度点阵 -->
          <view class="cb-top">
            <image class="cb-avatar" src="{{item.coachAvatar}}" mode="aspectFill" data-idx="{{index}}" binderror="avatarError"
                   catchtap="goCoachProfile" data-coach-id="{{item.coachId}}"></image>
            <view class="cb-title">
              <text class="cb-name">{{item.name}}</text>
              <text class="cb-desc" wx:if="{{item.description}}">{{item.description}}</text>
            </view>
            <!-- 难度哑铃：余位>=5时显示；满员(0)/紧张(<5)斜条出现时隐藏 -->
            <view class="cb-stars" wx:if="{{item.remaining >= 5}}">
              <view class="cb-dumbbell" wx:for="{{[1,2,3,4,5]}}" wx:for-item="sIdx" wx:key="*this"
                    wx:if="{{sIdx <= item.level}}"></view>
            </view>
          </view>

          <!-- 中行：大数字时间 + 剩余席位读数 -->
          <view class="cb-mid">
            <text class="cb-time">{{item.start}} – {{item.end}}</text>
            <view class="cb-seats {{item.isFull ? 'cb-seats-full' : ''}}">
              <view class="icon-person"></view>
              <text class="cb-seat-num {{item.isFull ? 'cb-seat-zero' : ''}}">{{item.booked}}/{{item.capacity}}</text>
            </view>
          </view>

          <!-- 底行：价格（会员价紧跟右侧）+ 按钮 -->
          <view class="cb-bottom">
            <view class="cb-price">¥{{item.price}}<text class="cb-price-mem">（{{memberLevelName}}会员 ¥{{item.memberPrice}}）</text></view>
            <view class="cb-btn {{item.isBooked ? 'btn-booked' : ((item.waitlisted || item.canWaitlist) ? 'btn-waitlist' : (item.isFull ? 'btn-full' : (item.status === 'ongoing' ? 'btn-ongoing' : (item.status === 'ended' ? 'btn-ended' : ''))))}}" catchtap="goDetail" data-id="{{item.id}}" data-disabled="{{item.disabled}}" data-waitlist="{{item.canWaitlist}}">
              <view class="ico ico-booked" wx:if="{{item.isBooked}}"></view>
              <view class="ico ico-waitlist" wx:elif="{{item.waitlisted || item.canWaitlist}}"></view>
              <view class="ico ico-full" wx:elif="{{item.isFull}}"></view>
              <view class="ico ico-ongoing" wx:elif="{{item.status === 'ongoing'}}"></view>
              <view class="ico ico-ended" wx:elif="{{item.status === 'ended'}}"></view>
              <view class="ico ico-book" wx:else></view>
              <text wx:if="{{item.isBooked}}">已约</text>
              <text wx:elif="{{item.waitlisted}}">{{t.waitlisted}}</text>
              <text wx:elif="{{item.canWaitlist}}">{{t.waitlistBtn}}</text>
              <!-- 满员按钮显示排队人数（DESIGN #D3）：帮用户判断要不要付费排位；金色斜条已示满员 -->
              <text wx:elif="{{item.isFull}}">{{item.canWaitlist && item.waitlistCount > 0 ? item.waitlistCount + '人排队' : '已满'}}</text>
              <text wx:elif="{{item.status === 'ongoing'}}">{{t.ongoing}}</text>
              <text wx:elif="{{item.status === 'ended'}}">{{t.ended}}</text>
              <text wx:else>预约</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 空状态（DESIGN #D10：搜索无结果 / 未来空课日发布占位 / 今天及过去原空态） -->
      <view class="empty-state flex-col" wx:if="{{(searchKeyword ? searchResult.length : courseList.length) === 0}}">
        <text class="empty-icon">▦</text>
        <block wx:if="{{searchKeyword}}">
          <text class="empty-txt">未找到匹配的课程</text>
          <text class="empty-sub">换个关键字试试</text>
        </block>
        <block wx:elif="{{isFutureDay && nextPublishText}}">
          <text class="empty-txt">课表将于本周五（{{nextPublishText}} 22:00）更新</text>
          <text class="empty-sub">新一周课表发布后即可预约</text>
        </block>
        <block wx:else>
          <text class="empty-txt">当天暂无排课</text>
          <text class="empty-sub">试试选择其他日期</text>
        </block>
      </view>
      </view>

      <view class="list-spacer"></view>
    </view>
  </scroll-view>
</view>
