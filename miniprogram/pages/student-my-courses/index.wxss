.page {
  min-height: 100vh;
  background: #F9F4DF;
}
.pt-safe {
  padding-top: calc(88rpx + env(safe-area-inset-top));
}
/* 固定顶部：标题 + 分段切换（页面滚动时吸顶） */
.my-head {
  position: sticky;
  top: 0;
  background: #F9F4DF;
  z-index: 10;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.04);
}
.head-row { align-items: center; }
.page-title {
  font-size: 48rpx; font-weight: 800; color: #1A1A23;
}
.head-date { color: #6B6B76; font-size: 28rpx; }

/* 分段切换 */
.seg {
  margin-top: 32rpx;
  background: var(--divider);
  border-radius: 40rpx;
  padding: 8rpx;
}
.seg-item {
  flex: 1;
  height: 72rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #6B6B76;
}
.seg-active {
  background: #1A1A23;
  color: #FFFFFF;
  font-weight: 600;
}

/* 列表区（页面级滚动，无需内嵌 scroll-view） */
.list-pad {
  padding: 0 40rpx 240rpx;   /* 底部留白给自定义 TabBar */
}

/* 课程卡片 */
.my-list {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}
.my-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.05);
}
.card-top { align-items: center; }
.card-date {
  color: #6B6B76; font-size: 26rpx;
}
.card-body {
  margin-top: 24rpx;
  align-items: center;
}
.time-box {
  width: 128rpx;
  align-items: center;
  flex-shrink: 0;
}
.time-value {
  font-size: 36rpx; font-weight: 800; color: #1A1A23;
}
.time-dur {
  font-size: 22rpx; color: #6B6B76;
  margin-top: 4rpx;
}
.v-divider {
  width: 2rpx; height: 88rpx;
  background: var(--divider-strong);
  margin-right: 24rpx;
}
.info-box { justify-content: center; }
.course-name {
  font-size: 30rpx; font-weight: 700; color: #1A1A23;
}
.course-meta {
  font-size: 24rpx; color: #6B6B76;
  margin-top: 8rpx;
}
.card-actions {
  margin-top: 24rpx;
  justify-content: flex-end;
  gap: 20rpx;
}
.btn-sm {
  padding: 14rpx 36rpx;
  font-size: 26rpx;
  border-radius: 32rpx;
}

/* 空状态：改用全局标准组件（app.wxss .empty-state 系列，设计系统 v1 批2） */

.list-spacer { height: 60rpx; }

/* 已完成卡片：签到状态文字（DESIGN #D12：未签到标灰「缺席」，同 tag-gray 风格低调） */
.done-status {
  margin-left: auto;
  font-size: 26rpx;
  color: #B0AFA8;
  font-weight: 600;
}
.done-checked {
  color: #3D9970;
}
.done-absent {
  background: var(--divider);
  color: var(--ink-300);
  padding: 4rpx 18rpx;
  border-radius: 8rpx;
}
/* 底部提示：只显示最近7天 */
.list-hint {
  text-align: center;
  font-size: 22rpx;
  color: #B0AFA8;
  padding: 8rpx 0 24rpx;
}

/* 候补自动取消提示 */
.wait-expire {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #5B57EB;
  font-weight: 600;
}
/* 排位位置提示（DESIGN #D3）：灰色小字，区分于紫色到期提示 */
.wait-pos {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8A8A8A;
}
