#!/bin/sh
# ============================================================
# 安全网强制（pre-commit hook）：提交前自动跑测试，红则阻止提交
# 机制：git config core.hooksPath .githooks（见 README / CONVENTIONS.md）
# 绕过：仅限故意为之的 --no-verify，其余一律拦截
#
# 干净库模式（DB_PATH 指向临时库）：
#   每次提交都是「全新 schema + seed」验证，不再依赖开发后端是否在跑，
#   schema 类 bug 本地即可抓（BUG-LEDGER #1 教训），且不污染共享开发库。
#   2026-08-15: 库路径加 $$（进程号）后缀——并行会话同时提交时不互踩（原固定路径冲突导致测试失败）
# ============================================================
echo "▶ [安全网] 提交前自动测试（干净库模式）..."

DB_PATH=/tmp/gym-test-clean-$$.db node "$(dirname "$0")/../minitest/run-tests.js"
RESULT=$?
rm -f /tmp/gym-test-clean-$$.db* 2>/dev/null

# 判定：红 = 禁止提交
if [ $RESULT -ne 0 ]; then
  echo ""
  echo "✖✖✖ [安全网] 测试未全绿（退出码 $RESULT）——禁止提交！"
  echo "    请修复后重新 commit（或确认后用 git commit --no-verify 显式绕过）"
  exit 1
fi

echo "✓ [安全网] 测试全绿，放行提交"
exit 0
