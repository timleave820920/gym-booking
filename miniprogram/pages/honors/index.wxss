.page {
  min-height: 100vh;
  background: #F9F4DF;
}
.page-pad {
  padding: 24rpx 24rpx 60rpx;
}
.pt-safe {
  padding-top: 24rpx;
}

/* 荣誉主卡 */
.honor-hero {
  background: #1A1A23;
  border-radius: 24rpx;
  padding: 32rpx;
}
.hh-title {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  color: #FFFFFF;
}
.hh-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}
.medals {
  margin-top: 28rpx;
  display: flex;
  gap: 16rpx;
}
.medal {
  flex: 1;
  background: rgba(255,255,255,0.1);
  border-radius: 16rpx;
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.medal-v {
  font-size: 32rpx;
  font-weight: 800;
  color: #B9FF66;
}
.medal-l {
  font-size: 20rpx;
  color: rgba(255,255,255,0.6);
}

/* 荣誉列表 */
.sec-title {
  margin: 40rpx 0 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A23;
}
.honor-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.honor-medal {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.honor-medal-txt {
  font-size: 34rpx;
  font-weight: 800;
  color: #FFFFFF;
}
.honor-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A23;
}
.honor-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-300);
}

/* 查看更多 */
.more-btn {
  margin-top: 20rpx;
  background: #1A1A23;
  border-radius: 44rpx;
  padding: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.more-txt {
  font-size: 28rpx;
  font-weight: 700;
  color: #B9FF66;
}