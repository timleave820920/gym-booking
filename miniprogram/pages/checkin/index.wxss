/* 固定二维码自助签到页（DESIGN #D13）——简洁白底 + 墨黑主行动 */
.page {
  min-height: 100vh;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
}

.center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 48rpx;
}

.big-icon {
  font-size: 110rpx;
  line-height: 1;
}

.status-txt {
  margin-top: 32rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A23;
  text-align: center;
}

.status-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #6B6B76;
  text-align: center;
  line-height: 1.7;
}

.action-row {
  margin-top: 48rpx;
  display: flex;
  gap: 20rpx;
}

.action-btn {
  margin-top: 48rpx;
  min-width: 300rpx;
  height: 92rpx;
  padding: 0 48rpx;
  border-radius: 46rpx;
  background: #1A1A23;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn.ghost {
  background: #FFFFFF;
  color: #1A1A23;
  border: 3rpx solid #1A1A23;
}

/* 签到成功态 */
.ok-icon {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: #3D9970;
  color: #FFFFFF;
  font-size: 88rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ok-title {
  margin-top: 32rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #1A1A23;
}

.done-card {
  margin-top: 40rpx;
  width: 100%;
  background: #F9F4DF;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.done-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #1A1A23;
}

.done-meta {
  font-size: 26rpx;
  color: #6B6B76;
}

.done-tip {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: #B0AFA8;
}

/* 多课候选列表 */
.cand-list {
  margin-top: 40rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.cand-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #FFFFFF;
  border: 3rpx solid #EDEBE2;
  border-radius: 24rpx;
  padding: 26rpx 28rpx;
}

.cand-on {
  border-color: #1A1A23;
  background: #F9F4DF;
}

.radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #D8D5C9;
  flex-shrink: 0;
}

.radio-on {
  border-color: #1A1A23;
  background: #B9FF66;
}

.cand-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.cand-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A23;
}

.cand-time {
  font-size: 24rpx;
  color: #6B6B76;
}

.confirm-btn {
  width: 100%;
  margin-top: 40rpx;
}
