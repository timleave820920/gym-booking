.page {
  min-height: 100vh;
  background: #F9F4DF;
}
.page-pad {
  padding: 24rpx 40rpx 120rpx;
}

/* 使用说明 */
.tip-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--divider);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}
.tip-icon {
  font-size: 32rpx;
}
.tip-text {
  flex: 1;
  font-size: 24rpx;
  color: #6B6B76;
  line-height: 1.6;
}

/* 二维码卡片 */
.qr-card {
  margin-top: 32rpx;
  background: #FFFFFF;
  border: 3rpx solid #1A1A23;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.qr-head {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.qr-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1A1A23;
}
.qr-badge {
  font-size: 20rpx;
  color: #5B57EB;
  background: #F0EBFF;
  border-radius: 12rpx;
  padding: 4rpx 14rpx;
}
.qr-img {
  width: 360rpx;
  height: 360rpx;
}
.qr-hint {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #6B6B76;
}
.qr-note {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #B0AFA8;
}
