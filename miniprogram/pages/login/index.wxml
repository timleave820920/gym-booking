<view class="page" wx:if="{{booted}}">
  <!-- 语言切换（左上角） -->
  <view class="lang-switch" bindtap="switchLang">
    <text class="lang-txt">{{lang === 'zh' ? 'EN' : '中'}}</text>
  </view>

  <!-- 品牌区 -->
  <view class="brand-area">
    <view class="logo-badge">
      <view class="logo-icon"></view>
    </view>
    <text class="brand-name">{{t.gymName}}</text>
    <text class="brand-slogan">{{t.brandSlogan}}</text>
  </view>

  <!-- 登录表单区 -->
  <view class="form-area">
    <!-- 微信一键登录 -->
    <view class="wx-btn flex-row" bindtap="login">
      <view class="wx-icon flex-center">
        <text class="wx-icon-in">微</text>
      </view>
      <text class="wx-btn-txt">{{loggingIn ? t.wxLoggingIn : t.wxLogin}}</text>
    </view>

    <!-- 或分隔线 -->
    <view class="or-divider flex-row">
      <view class="or-line"></view>
      <text class="or-txt">{{t.or}}</text>
      <view class="or-line"></view>
    </view>

    <!-- 手机号快捷登录（微信官方手机号授权） -->
    <button class="phone-btn flex-row" open-type="getPhoneNumber" bindgetphonenumber="phoneLogin">
      <view class="phone-icon flex-center">
        <view class="phone-svg"></view>
      </view>
      <text class="phone-btn-txt">{{t.phoneLogin}}</text>
    </button>

    <!-- 协议勾选 -->
    <view class="agree-row flex-row" bindtap="toggleAgree">
      <view class="agree-box flex-center {{agreed ? 'agree-on' : ''}}">
        <text class="agree-check" wx:if="{{agreed}}">✓</text>
      </view>
      <text class="agree-txt">我已阅读并同意<text class="agree-link" catchtap="viewService">《服务协议》</text>和<text class="agree-link" catchtap="viewPrivacy">《隐私政策》</text></text>
    </view>

    <text class="login-hint">{{t.loginAsStudent}}</text>
    <text class="login-hint2">{{t.firstLoginHint}}</text>
  </view>

  <!-- 2026-08-15: 登录后完善资料（新用户/昵称为空时弹出；微信官方头像昵称填写能力——
       微信禁止静默获取头像昵称，此处已优化为最简：点头像选「微信头像」+ 键盘「填入微信昵称」一键 → 保存即完成注册） -->
  <view class="profile-mask" wx:if="{{showProfileSetup}}" catchtouchmove="noop">
    <view class="profile-dialog">
      <view class="profile-title">使用微信头像和昵称</view>
      <view class="profile-sub">点击头像选「微信头像」，昵称框键盘点「填入微信昵称」即可</view>
      <button class="profile-avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image class="profile-avatar" src="{{avatarPath || '/images/2_556.png'}}" mode="aspectFill"></image>
        <text class="profile-avatar-tip">点这里选微信头像</text>
      </button>
      <input class="profile-nick-input" type="nickname" placeholder="点输入，键盘上可一键填入微信昵称"
             value="{{nickDraft}}" bindinput="onProfileNick" />
      <button class="profile-save-btn" bindtap="saveProfile" disabled="{{savingProfile}}">
        {{savingProfile ? '保存中...' : '使用微信头像昵称，完成注册'}}
      </button>
      <text class="profile-skip" bindtap="skipProfile">稍后设置（先逛逛）</text>
    </view>
  </view>

  <!-- 隐私协议弹窗（首次启动，微信 2023.9 强制） -->
  <view class="privacy-mask" wx:if="{{showPrivacy}}" catchtouchmove="noop">
    <view class="privacy-dialog">
      <view class="privacy-title">用户隐私保护提示</view>
      <view class="privacy-body">
        <text class="privacy-text">我们重视您的隐私。为了向您提供课程预约、订课支付、签到等服务，我们会收集您的微信昵称、头像、手机号（可选）等信息。请阅读并同意</text>
        <text class="privacy-link" bindtap="viewPrivacy">《用户隐私保护协议》</text>
        <text class="privacy-text">后继续使用。</text>
      </view>
      <view class="privacy-actions">
        <view class="privacy-btn privacy-btn-outline" bindtap="rejectPrivacy">暂不使用</view>
        <button class="privacy-btn privacy-btn-primary" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="agreePrivacy">同意并继续</button>
      </view>
    </view>
  </view>
</view>

