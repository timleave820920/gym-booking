<view class="page">
  <view class="page-pad pt-safe">
    <!-- 顶部标题：左对齐大标题（与上课/我的页一致） -->
    <view class="head-row">
      <text class="page-title">活动中心</text>
    </view>

    <!-- 宣传视频位：videoUrl 为空时显示占位图（点击提示即将上线）；放入视频后自动切换播放 -->
    <view class="promo" bindtap="onPromoTap">
      <image class="promo-poster" src="{{videoUrl ? videoPoster : '/images/hyrox_adv_sled.jpg'}}" mode="aspectFill" wx:if="{{!playing}}"></image>
      <video class="promo-video" wx:if="{{videoUrl && playing}}"
             src="{{videoUrl}}" poster="{{videoPoster}}" controls
             object-fit="cover" bindended="onVideoEnd"></video>
      <view class="promo-play" wx:if="{{!videoUrl}}">
        <view class="promo-play-btn">▶</view>
        <text class="promo-play-txt">宣传片制作中 · 敬请期待</text>
      </view>
      <view class="promo-tag" wx:if="{{videoUrl && !playing}}">
        <view class="promo-play-btn-sm">▶</view>
        <text class="promo-play-txt">点击播放宣传片</text>
      </view>
    </view>

    <!-- 功能宫格 -->
    <view class="grid">
      <view class="grid-item" bindtap="go" data-url="/pages/member-level/index">
        <view class="g-icon gi-level"><view class="ico ico-level"></view></view>
        <view class="g-info"><text class="g-name">会员等级</text><text class="g-sub">{{gridSubs.level}}</text></view>
      </view>
      <view class="grid-item" bindtap="go" data-url="/pages/member-recharge/index">
        <view class="g-icon gi-wallet"><view class="ico ico-wallet"></view></view>
        <view class="g-info"><text class="g-name">储值会员</text><text class="g-sub">{{gridSubs.recharge}}</text></view>
      </view>
      <view class="grid-item" bindtap="go" data-url="/pages/invite/index">
        <view class="g-icon gi-invite"><view class="ico ico-invite"></view></view>
        <view class="g-info"><text class="g-name">邀请好友</text><text class="g-sub">{{gridSubs.invite}}</text></view>
      </view>
      <view class="grid-item" bindtap="go" data-url="/pages/passes-buy/index">
        <view class="g-icon gi-pass"><view class="ico ico-pass"></view></view>
        <view class="g-info"><text class="g-name">次卡包</text><text class="g-sub">{{gridSubs.pass}}</text></view>
      </view>
      <view class="grid-item" bindtap="goCoinShop">
        <view class="g-icon gi-shop"><view class="ico ico-shop"></view></view>
        <view class="g-info"><text class="g-name">能量商店</text><text class="g-sub">签到攒币换好礼</text></view>
      </view>
      <view class="grid-item" bindtap="go" data-url="/pages/about-us/index">
        <view class="g-icon gi-idea"><view class="ico ico-idea"></view></view>
        <view class="g-info"><text class="g-name">场馆理念</text><text class="g-sub">品牌故事</text></view>
      </view>
      <view class="grid-item" bindtap="go" data-url="/pages/honors/index">
        <view class="g-icon gi-honor"><view class="ico ico-honor"></view></view>
        <view class="g-info"><text class="g-name">参赛荣誉</text><text class="g-sub">{{gridSubs.honor}}</text></view>
      </view>
    </view>
  </view>
</view>
