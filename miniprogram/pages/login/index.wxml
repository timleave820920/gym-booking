<view class="page">
  <!-- 品牌区 -->
  <view class="brand-area">
    <view class="logo-badge">
      <view class="logo-icon"></view>
    </view>
    <text class="brand-name">综合训练馆</text>
    <text class="brand-slogan">挥洒汗水，遇见更好的自己</text>
  </view>

  <!-- 登录表单区 -->
  <view class="form-area">
    <!-- 微信一键登录 -->
    <view class="wx-btn flex-row" bindtap="login">
      <view class="wx-icon flex-center">
        <text class="wx-icon-in">微</text>
      </view>
      <text class="wx-btn-txt">{{loggingIn ? '登录中...' : '微信一键登录'}}</text>
    </view>

    <!-- 或分隔线 -->
    <view class="or-divider flex-row">
      <view class="or-line"></view>
      <text class="or-txt">或</text>
      <view class="or-line"></view>
    </view>

    <!-- 手机号快捷登录（微信官方手机号授权） -->
    <button class="phone-btn flex-row" open-type="getPhoneNumber" bindgetphonenumber="phoneLogin">
      <view class="phone-icon flex-center">
        <view class="phone-svg"></view>
      </view>
      <text class="phone-btn-txt">手机号快捷登录</text>
    </button>

    <!-- 协议勾选 -->
    <view class="agree-row flex-row" bindtap="toggleAgree">
      <view class="agree-box flex-center {{agreed ? 'agree-on' : ''}}">
        <text class="agree-check" wx:if="{{agreed}}">✓</text>
      </view>
      <text class="agree-txt">我已阅读并同意《用户协议》和《隐私政策》</text>
    </view>

    <text class="login-hint">登录即代表同意以学员身份使用本服务</text>
    <text class="login-hint2">首次登录将引导完善微信头像与昵称</text>
  </view>

  <!-- 完善资料弹层 -->
  <view class="profile-mask" wx:if="{{showProfile}}">
    <view class="profile-card">
      <text class="profile-title">完善资料</text>
      <text class="profile-sub">点击使用微信昵称，一键填写真实名字</text>

      <!-- 头像：微信官方 chooseAvatar -->
      <view class="avatar-row flex-row">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="avatar-img" src="{{tempAvatar}}" mode="aspectFill"></image>
          <view class="avatar-plus">+</view>
        </button>
        <view class="flex-col flex-1 avatar-hint">
          <text class="avatar-hint-t">点击上方圆圈选择微信头像</text>
          <text class="avatar-hint-s">已授权时自动使用微信头像</text>
        </view>
      </view>

      <!-- 昵称：微信官方 nickname 填写能力 -->
      <view class="nick-row flex-row">
        <text class="nick-label">昵称</text>
        <input class="nick-input" type="nickname" placeholder="点击输入，键盘上方可一键使用微信昵称"
               placeholder-class="nick-ph" value="{{tempNick}}" bindinput="onNickInput" />
      </view>

      <view class="profile-btn" bindtap="confirmProfile">
        <text>完成，进入训练馆</text>
      </view>
    </view>
  </view>
</view>
