.page {
  min-height: 100vh;
  background: #F9F4DF;
  padding-bottom: 220rpx;
}
.pt-safe {
  padding-top: calc(88rpx + env(safe-area-inset-top));
}
.head-row { align-items: center; }
.page-title {
  font-size: 48rpx; font-weight: 800; color: #1A1A23;
}
.icon-chevron {
  width: 36rpx; height: 36rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M9 6L15 12L9 18" stroke="%231A1A23" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>') no-repeat center/contain;
}

/* 菜单组 */
.menu-group {
  margin-top: 32rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 8rpx 0;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.04);
}
.menu-row {
  height: 104rpx;
  padding: 0 28rpx;
  align-items: center;
  border-bottom: 2rpx solid #F5F2E6;
}
.menu-group .menu-row:last-child {
  border-bottom: none;
}
.menu-icon {
  width: 40rpx; height: 40rpx;
  margin-right: 24rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}
.icon-check {
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M5 13L9 17L19 7" stroke="%231A1A23" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>');
}
.icon-trophy {
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M8 21H16M12 17V21M7 4H17V9C17 11.76 14.76 14 12 14C9.24 14 7 11.76 7 9V4ZM7 6H4C4 9.5 6.5 12 10 12M17 6H20C20 9.5 17.5 12 14 12" stroke="%231A1A23" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>');
}
.icon-wallet {
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><rect x="3" y="6" width="18" height="14" rx="2" stroke="%231A1A23" stroke-width="2"/><path d="M3 10H21" stroke="%231A1A23" stroke-width="2"/><circle cx="16.5" cy="15.5" r="1.5" fill="%231A1A23"/></svg>');
}
.icon-edit {
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M4 20H8L19 9C19.55 8.45 20 7.66 20 6.83C20 5.51 18.93 4.44 17.61 4.44C16.78 4.44 15.99 4.89 15.44 5.44L4 16.88V20Z" stroke="%231A1A23" stroke-width="2" stroke-linejoin="round"/></svg>');
}
.icon-coach {
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M5 8V16M3 10V14M19 8V16M21 10V14M5 12H19" stroke="%235B57EB" stroke-width="2" stroke-linecap="round"/></svg>');
}
.icon-admin {
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M4 20V10M10 20V4M16 20V13M21 20H3" stroke="%231A1A23" stroke-width="2" stroke-linecap="round"/></svg>');
}

/* 测试入口 */
.test-section {
  margin-top: 40rpx;
}
.test-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #B0AFA8;
  margin-left: 8rpx;
  margin-bottom: 16rpx;
  display: block;
}
.test-hint {
  font-size: 20rpx;
  color: #B0AFA8;
  margin-top: 12rpx;
  margin-left: 8rpx;
  display: block;
}
.menu-name {
  flex: 1;
  font-size: 28rpx; font-weight: 500; color: #1A1A23;
}
.icon-chevron-sm {
  width: 32rpx; height: 32rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M9 6L15 12L9 18" stroke="%236B6B76" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>') no-repeat center/contain;
}

.list-spacer { height: 60rpx; }

/* 退出登录 */
.logout-btn {
  margin-top: 32rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #FFFFFF;
  border: 2rpx solid #E8E2CC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #E5484D;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.04);
}

/* 会员卡预览（从活动页迁移） */
.vip-preview {
  margin-top: 20rpx;
  position: relative;
  background: #1A1A23;
  border-radius: 24rpx;
  padding: 28rpx;
  overflow: hidden;
}
.vip-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.vip-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
}
.vip-lv {
  background: #B9FF66;
  border: 3rpx solid #1A1A23;
  border-radius: 16rpx;
  padding: 4rpx 16rpx;
}
.vip-lv-txt {
  font-size: 22rpx;
  font-weight: 700;
  color: #1A1A23;
}
.vip-mid {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.vip-bal-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}
.vip-bal-value {
  display: block;
  margin-top: 4rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #B9FF66;
}
.vip-btn {
  background: #B9FF66;
  border: 3rpx solid #1A1A23;
  border-radius: 40rpx;
  padding: 14rpx 36rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A23;
}
.vip-hint {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #B9FF66;
}
.vip-loading {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
}
.reward-ribbon {
  margin-top: 16rpx;
  background: rgba(255,255,255,0.12);
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
}
.reward-ribbon text {
  font-size: 22rpx;
  color: #B9FF66;
}
.balance-anim {
  animation: balancePulse 1.2s ease 2;
}
@keyframes balancePulse {
  0% { transform: scale(1); color: #B9FF66; }
  50% { transform: scale(1.15); color: #FFFFFF; }
  100% { transform: scale(1); color: #B9FF66; }
}
.vip-coins {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
}
.vip-coins-label {
  font-size: 22rpx;
  color: #F8D044;
  font-weight: 600;
}
.vip-coins-value {
  font-size: 30rpx;
  font-weight: 800;
  color: #F8D044;
}
.vip-coins-go {
  margin-left: auto;
  font-size: 20rpx;
  color: rgba(255,255,255,0.6);
}

/* 会员体系图标（对齐菜单风格） */
.icon-card {
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><rect x="2" y="5" width="20" height="14" rx="2" stroke="%231A1A23" stroke-width="2"/><path d="M2 10H22" stroke="%231A1A23" stroke-width="2"/><circle cx="16" cy="15" r="1.5" fill="%23B9FF66" stroke="%231A1A23"/></svg>');
}
.icon-lv {
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="%231A1A23" stroke-width="2"/><path d="M8 9.5L12 15L16 9.5" stroke="%231A1A23" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>');
}
.icon-recharge {
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M12 5V19M5 12H19" stroke="%231A1A23" stroke-width="2.5" stroke-linecap="round"/><path d="M7 4H17C18.1 4 19 4.9 19 6V18C19 19.1 18.1 20 17 20H7C5.9 20 5 19.1 5 18V6C5 4.9 5.9 4 7 4Z" stroke="%231A1A23" stroke-width="1.5" stroke-dasharray="2 2"/></svg>');
}

/* 消息未读角标 */
.menu-badge {
  margin-left: auto;
  margin-right: 10rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 17rpx;
  background: #E5484D;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
