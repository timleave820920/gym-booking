.page {
  min-height: 100vh;
  background: #F9F4DF;
  display: flex;
  flex-direction: column;
  padding-top: calc(88rpx + env(safe-area-inset-top));
  /* 内容超高时允许滚动（演示身份入口在底部，需可滚动查看） */
  overflow-y: auto;
  box-sizing: border-box;
}

/* 品牌区 */
.brand-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 24rpx;
}
.logo-badge {
  width: 168rpx;
  height: 168rpx;
  border-radius: 48rpx;
  background: #1A1A23;
  box-shadow: 0 16rpx 44rpx rgba(0,0,0,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}
.logo-icon {
  width: 100rpx;
  height: 100rpx;
  background: #B9FF66;
  border-radius: 24rpx;
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" fill="none"><path d="M8.5 8.5V23.5M5 11.5V20.5M23.5 8.5V23.5M27 11.5V20.5M8.5 16H23.5" stroke="%231A1A23" stroke-width="2.4" stroke-linecap="round"/></svg>');
  background-repeat: no-repeat;
  background-position: center;
  background-size: 56rpx;
}
.brand-name {
  font-size: 56rpx;
  font-weight: 800;
  color: #1A1A23;
  margin-top: 24rpx;
}
.brand-slogan {
  font-size: 26rpx;
  color: #6B6B76;
  margin-top: 12rpx;
}

/* 登录表单区 */
.form-area {
  flex: 1;
  padding: 20rpx 56rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* 微信登录按钮 */
.wx-btn {
  height: 140rpx;
  border-radius: 70rpx;
  background: #1A1A23;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  box-shadow: 0 16rpx 36rpx rgba(26,26,35,0.25);
}
.wx-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 34rpx;
  background: #B9FF66;
}
.wx-icon-in {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A23;
}
.wx-btn-txt {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* 或分隔线 */
.or-divider {
  align-items: center;
  gap: 20rpx;
}
.or-line {
  flex: 1;
  height: 2rpx;
  background: var(--divider-strong);
}
.or-txt {
  font-size: 24rpx;
  color: #B0AFA8;
}

/* 手机号快捷登录 */
.phone-btn {
  height: 140rpx;
  border-radius: 70rpx;
  background: #FFFFFF;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  box-shadow: 0 16rpx 36rpx rgba(26,26,35,0.1);
  padding: 0;
  margin: 0;
  font-size: inherit;
  line-height: inherit;
}
.phone-btn::after {
  border: none;
}
.phone-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 34rpx;
  background: #E5FFC9;
}
.phone-svg {
  width: 36rpx;
  height: 36rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><rect x="7" y="2.5" width="10" height="19" rx="2.5" stroke="%231A1A23" stroke-width="2"/><path d="M10.5 18.5H13.5" stroke="%231A1A23" stroke-width="2" stroke-linecap="round"/></svg>') no-repeat center/contain;
}
.phone-btn-txt {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A23;
}

/* 协议 */
.agree-row {
  align-items: center;
  gap: 16rpx;
  justify-content: center;   /* 2026-08-14 协议勾选行水平居中 */
}
.agree-box {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  border: 3rpx solid var(--line-warm);
  background: #FFFFFF;
  flex-shrink: 0;
}
.agree-on {
  background: #B9FF66;
  border-color: #1A1A23;
}
.agree-check {
  font-size: 24rpx;
  font-weight: 700;
  color: #1A1A23;
}
.agree-txt {
  font-size: 24rpx;
  color: #6B6B76;
}

.login-hint {
  font-size: 22rpx;
  color: #B0AFA8;
  text-align: center;
}

.login-hint2 {
  font-size: 22rpx;
  color: #B0AFA8;
  text-align: center;
}

/* 完善资料弹层 */
.profile-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
}
.profile-card {
  width: 100%;
  background: #FFFFFF;
  border-radius: 48rpx;
  padding: 48rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 24rpx 80rpx rgba(0,0,0,0.2);
}
.profile-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1A1A23;
}
.profile-sub {
  font-size: 24rpx;
  color: #6B6B76;
  margin-top: 8rpx;
  text-align: center;
}

/* 头像 */
.avatar-row {
  margin-top: 40rpx;
  width: 100%;
  align-items: center;
  gap: 24rpx;
}
.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #1A1A23;
  background: #F0EDDF;
  padding: 0;
  margin: 0;
  position: relative;
  overflow: visible;
  flex-shrink: 0;
  /* 确保任何环境下都是正圆（覆盖 button 默认样式） */
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  line-height: 1;
  font-size: 0;
}
.avatar-btn::after {
  border: none;
}
.avatar-img {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
}
/* 未选择头像时的正圆占位（与选完后的头像同尺寸） */
.avatar-ph {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  background-color: var(--ink-300);
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.5" stroke="%23B0AFA8" stroke-width="2"/><path d="M4.5 20C4.5 16.13 7.86 13.5 12 13.5C16.14 13.5 19.5 16.13 19.5 20" stroke="%23B0AFA8" stroke-width="2" stroke-linecap="round"/></svg>');
  background-repeat: no-repeat;
  background-position: center;
  background-size: 64rpx;
}
.avatar-plus {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #B9FF66;
  border: 3rpx solid #1A1A23;
  color: #1A1A23;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-hint {
  justify-content: center;
}
.avatar-hint-t {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A23;
}
.avatar-hint-s {
  font-size: 22rpx;
  color: #B0AFA8;
  margin-top: 8rpx;
}

/* 完成按钮 */
.profile-btn {
  margin-top: 48rpx;
  width: 100%;
  height: 104rpx;
  border-radius: 52rpx;
  background: #B9FF66;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A23;
  box-shadow: 0 16rpx 40rpx rgba(185,255,102,0.5);
}

/* 语言切换（左上角） */
.lang-switch {
  position: fixed;
  top: calc(120rpx + env(safe-area-inset-top));
  left: 32rpx;
  z-index: 100;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #1A1A23;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.2);
}
.lang-txt {
  color: #B9FF66;
  font-size: 26rpx;
  font-weight: 800;
}

/* 隐私协议弹窗（2026-08-13 微信隐私合规） */
.privacy-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(26, 26, 35, 0.55);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}
.privacy-dialog {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.2);
}
.privacy-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A23;
  text-align: center;
  margin-bottom: 24rpx;
}
.privacy-body {
  font-size: 26rpx;
  color: #6B6B76;
  line-height: 1.7;
}
.privacy-text { color: #6B6B76; }

/* ===== 2026-08-15: 登录后完善资料弹窗 ===== */
.profile-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(26, 26, 35, 0.55);
  z-index: 998;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}
.profile-dialog {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.profile-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A23;
}
.profile-sub {
  font-size: 24rpx;
  color: #B0AFA8;
  margin-top: 8rpx;
  margin-bottom: 32rpx;
}
.profile-avatar-btn {
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  background: transparent;
  line-height: normal;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}
.profile-avatar-btn::after { border: none; }
.profile-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid #C6F04B;
  background: #F0EDDF;
}
.profile-avatar-tip {
  font-size: 22rpx;
  color: #6B6B76;
  margin-top: 8rpx;
}
.profile-nick-input {
  width: 100%;
  height: 88rpx;
  background: #F5F3E9;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1A1A23;
  box-sizing: border-box;
  margin-bottom: 28rpx;
}
.profile-save-btn {
  width: 100%;
  height: 88rpx;
  background: #C6F04B;
  color: #1A1A23;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #1A1A23;
  line-height: 84rpx;
}
.profile-save-btn::after { border: none; }
.profile-save-btn[disabled] { opacity: 0.6; }
.profile-skip {
  font-size: 24rpx;
  color: #6B6B76;
  margin-top: 24rpx;
  text-decoration: underline;
}
.privacy-link {
  color: #5B57EB;
  font-weight: 600;
}
.privacy-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}
.privacy-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}
.privacy-btn-outline {
  background: #FFFFFF;
  color: #6B6B76;
  border: 2rpx solid #D9D4C0;
}
.privacy-btn-primary {
  background: #1A1A23;
  color: #FFFFFF;
}

/* 官方授权按钮：重置 button 默认样式（继承 .privacy-btn 视觉） */
button.privacy-btn {
  padding: 0;
  margin: 0;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: normal;
}
button.privacy-btn::after {
  border: none;
}

/* 协议链接（勾选行内可点击） */
.agree-link {
  color: #5B57EB;
  font-weight: 600;
}

/* 昵称匹配提示 + 快捷登录 */
.nick-match {
  margin-top: 16rpx;
  background: #EEEDFE;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  align-items: center;
  justify-content: space-between;
}
.nick-match-txt {
  font-size: 24rpx;
  color: #1A1A23;
  font-weight: 600;
}
.nick-login-btn {
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: #5B57EB;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  flex-shrink: 0;
}
