.page {
  min-height: 100vh;
  background: #F9F4DF;
}
.page-pad {
  padding: 24rpx 24rpx 60rpx;
}
.pt-safe {
  padding-top: 24rpx;
}

/* 等级卡 */
.level-card {
  background: #1A1A23;
  border-radius: 24rpx;
  padding: 32rpx;
}
.lc-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.lc-name {
  font-size: 40rpx;
  font-weight: 800;
  color: #FFFFFF;
}
.lc-lv {
  font-size: 30rpx;
  font-weight: 700;
  color: #B9FF66;
}
.lc-progress-txt {
  display: block;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}
.lc-bar {
  margin-top: 12rpx;
  height: 16rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 8rpx;
  overflow: hidden;
}
.lc-bar-fill {
  height: 100%;
  background: #B9FF66;
  border-radius: 8rpx;
}
.lc-hint {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #B9FF66;
}

/* 等级权益 */
.sec-title {
  margin: 40rpx 0 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A23;
}
.levels-row {
  display: flex;
  gap: 12rpx;
}
.level-item {
  position: relative;
  flex: 1;
  background: #FFFFFF;
  border: 3rpx solid #1A1A23;
  border-radius: 24rpx;
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.level-current {
  border-color: #B9FF66;
}
.level-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.level-roman {
  font-size: 30rpx;
  font-weight: 800;
  color: #FFFFFF;
}
.level-name {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A23;
}
.level-discount {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #1A1A23;
}
.level-min {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: #8A8A8A;
}
.level-tag {
  position: absolute;
  top: -12rpx;
  background: #B9FF66;
  border: 3rpx solid #1A1A23;
  border-radius: 20rpx;
  padding: 2rpx 16rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #1A1A23;
}

.rule-txt {
  display: block;
  margin-top: 24rpx;
  font-size: 20rpx;
  color: #8A8A8A;
}

/* CTA */
.cta {
  margin-top: 48rpx;
  background: #1A1A23;
  border-radius: 44rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cta-txt {
  font-size: 30rpx;
  font-weight: 700;
  color: #B9FF66;
}
