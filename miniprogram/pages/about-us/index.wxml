<view class="page">
  <!-- 顶部导航：返回钮与教练详情页一致，标题与微信胶囊按钮水平对齐（2026-08-19） -->
  <view class="nav-bar" style="padding-top: {{statusBarH}}px;">
    <view class="nav-back" bindtap="goBack"><text class="icon-back"></text></view>
    <text class="nav-title">场馆理念</text>
    <view class="nav-sp"></view>
  </view>
  <view class="page-pad pt-safe">
    <!-- 品牌主卡 -->
    <view class="hero">
      <text class="hero-slogan">「让每一个普通人，都成为自己的英雄」</text>
      <text class="hero-from">—— 综合训练馆 · 创立初心</text>
      <view class="hero-line"></view>
      <text class="hero-text">我们相信：健身不是苦行，而是与自己对话的仪式。科学训练 × 社群陪伴 × 快乐坚持，让改变自然发生。</text>
    </view>

    <!-- 三大理念 -->
    <view class="sec-title">三大训练理念</view>
    <view class="ideas">
      <view class="idea">
        <view class="idea-icon ii-lime"><text class="idea-icon-txt">科</text></view>
        <text class="idea-name">科学训练</text>
        <text class="idea-desc">数据驱动，拒绝瞎练</text>
      </view>
      <view class="idea">
        <view class="idea-icon ii-purple"><text class="idea-icon-txt">伴</text></view>
        <text class="idea-name">社群陪伴</text>
        <text class="idea-desc">一起练，才能坚持</text>
      </view>
      <view class="idea">
        <view class="idea-icon ii-red"><text class="idea-icon-txt">乐</text></view>
        <text class="idea-name">快乐坚持</text>
        <text class="idea-desc">热爱，才不觉得累</text>
      </view>
    </view>

    <!-- 数据背书 -->
    <view class="sec-title">数据见证</view>
    <view class="data-card">
      <view class="data-item">
        <text class="data-v">3 年</text>
        <text class="data-l">经营沉淀</text>
      </view>
      <view class="data-item">
        <text class="data-v">2,000+</text>
        <text class="data-l">累计学员</text>
      </view>
      <view class="data-item">
        <text class="data-v">98%</text>
        <text class="data-l">学员满意度</text>
      </view>
    </view>

    <!-- 荣誉入口 -->
    <view class="honor-link" bindtap="goHonors">
      <text class="honor-link-txt">查看我们的参赛荣誉 →</text>
    </view>
  </view>
</view>
