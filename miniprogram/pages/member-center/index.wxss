.page {
  min-height: 100vh;
  background: #F9F4DF;
}
.page-pad {
  padding: 24rpx 24rpx 260rpx;   /* 底部留白给悬浮 TabBar */
}
.pt-safe {
  padding-top: calc(88rpx + env(safe-area-inset-top));   /* 自定义导航，给胶囊让位 */
}

/* 顶部大标题（与上课/我的页一致） */
.head-row { align-items: center; }
.page-title {
  font-size: 48rpx; font-weight: 800; color: #1A1A23;
}

/* 功能宫格 */
.grid {
  margin-top: 32rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.grid-item {
  width: 48%;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-sizing: border-box;
}
.g-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.gi-level { background: #534AB7; }   /* 会员等级 · 紫（尊贵/成长） */
.gi-wallet { background: #BA7517; }  /* 储值会员 · 金（金钱） */
.gi-invite { background: #3B6D11; }  /* 邀请好友 · 绿（活跃/裂变） */
.gi-pass   { background: #185FA5; }  /* 次卡包 · 蓝（卡/数字） */
.gi-shop   { background: #D85A30; }  /* 能量商店 · 橙（能量/闪电） */
.gi-idea   { background: #1A1A23; }  /* 场馆理念 · 墨黑（品牌根基） */
.gi-honor  { background: #A32D2D; }  /* 参赛荣誉 · 红（竞技/热忱） */
.g-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A23;
}
.g-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--ink-300);
}

/* 宣传视频位 */
.promo {
  margin-top: 32rpx;
  position: relative;
  height: 340rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #1A1A23;
}
.promo-poster {
  width: 100%;
  height: 340rpx;
  border-radius: 28rpx;
}
.promo-video {
  width: 100%;
  height: 340rpx;
  border-radius: 28rpx;
}
.promo-play {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  background: rgba(0,0,0,0.35);
}
.promo-play-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #B9FF66;
  color: #1A1A23;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.promo-play-txt {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
}
.promo-tag {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: rgba(0,0,0,0.28);
}
.promo-play-btn-sm {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #B9FF66;
  color: #1A1A23;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}