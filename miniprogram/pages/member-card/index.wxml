<view class="page">
  <view class="page-pad pt-safe">
    <!-- 电子会员卡 -->
    <view class="card" wx:if="{{level}}">
      <view class="card-top">
        <text class="card-name">综合训练馆 · 会员卡</text>
        <view class="card-lv">
          <text class="card-lv-txt">{{level.icon}} Lv.{{level.lv}}</text>
        </view>
      </view>
      <text class="card-no">{{cardNo}}</text>
      <text class="card-user">{{user.name}}</text>
      <view class="card-mid">
        <text class="card-bal-label">储值余额</text>
        <text class="card-bal-value">¥ {{balance}}</text>
      </view>
    </view>

    <!-- 会员码 -->
    <view class="scan-card">
      <view class="qr-box"><text class="qr-txt">▦</text></view>
      <view class="scan-info">
        <text class="scan-t1">到店出示会员码</text>
        <text class="scan-t2">签到 / 核销 / 消费一码搞定</text>
      </view>
    </view>

    <!-- 快捷入口 -->
    <view class="sec-title">会员服务</view>
    <view class="quicks">
      <view class="quick" bindtap="go" data-url="/pages/member-recharge/index">
        <view class="quick-icon qi-purple"><text class="quick-icon-txt">¥</text></view>
        <text class="quick-name">充值</text>
      </view>
      <view class="quick" bindtap="go" data-url="/pages/member-level/index">
        <view class="quick-icon qi-lime"><text class="quick-icon-txt">Lv</text></view>
        <text class="quick-name">等级</text>
      </view>
      <view class="quick" bindtap="go" data-url="/pages/student-orders/index">
        <view class="quick-icon qi-red"><text class="quick-icon-txt">≡</text></view>
        <text class="quick-name">记录</text>
      </view>
    </view>
  </view>
</view>
