.page {
  min-height: 100vh;
  background: #F9F4DF;
  padding-bottom: 220rpx;
}
.pt-safe {
  padding-top: calc(88rpx + env(safe-area-inset-top));
}

.greet-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1A1A23;
}
.greet-date {
  font-size: 26rpx;
  color: #6B6B76;
  margin-top: 8rpx;
  display: block;
}
.bell-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
}
.icon-bell {
  width: 40rpx; height: 40rpx;
  border-radius: 12rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M6 8C6 4.69 8.69 2 12 2C15.31 2 18 4.69 18 8V11C18 14.5 19.5 16 19.5 16H4.5C4.5 16 6 14.5 6 11V8Z" stroke="%231A1A23" stroke-width="2"/><path d="M10.3 20C10.73 20.61 11.31 21 12 21C12.69 21 13.27 20.61 13.7 20" stroke="%231A1A23" stroke-width="2" stroke-linecap="round"/></svg>') no-repeat center/contain;
}

/* Banner */
.banner {
  position: relative;
  margin-top: 32rpx;
  height: 300rpx;
  border-radius: 40rpx;
  overflow: hidden;
  background: linear-gradient(120deg, #FF6B35 0%, #FFCB47 100%);
}
.banner-tag {
  position: absolute; top: 36rpx; left: 40rpx;
  color: #FFFFFF; font-size: 24rpx; font-weight: 700;
  letter-spacing: 4rpx;
}
.banner-title {
  position: absolute; top: 88rpx; left: 40rpx;
  color: #1A1A23; font-size: 56rpx; font-weight: 900;
}
.banner-sub {
  position: absolute; top: 164rpx; left: 40rpx;
  color: #FFFFFF; font-size: 26rpx;
}
.banner-btn {
  position: absolute; top: 216rpx; left: 40rpx;
  background: #1A1A23; color: #FFFFFF;
  font-size: 26rpx; font-weight: 600;
  padding: 12rpx 32rpx; border-radius: 30rpx;
}
.banner-img {
  position: absolute; right: 0; top: 0;
  width: 300rpx; height: 300rpx;
}
.banner-deco {
  position: absolute; right: 80rpx; top: -40rpx;
  width: 180rpx; height: 180rpx; border-radius: 50%;
  background: linear-gradient(120deg, #B9FF66 0%, rgba(91,87,235,0.8) 100%);
}

/* 热门课程 */
.hot-head { margin-top: 40rpx; }
.section-title {
  font-size: 36rpx; font-weight: 700; color: #1A1A23;
}
.more { align-items: center; }
.more-txt { color: #6B6B76; font-size: 26rpx; margin-right: 4rpx; }
.icon-chevron {
  width: 28rpx; height: 28rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M9 6L15 12L9 18" stroke="%236B6B76" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>') no-repeat center/contain;
}

.hot-list { margin-top: 24rpx; display: flex; flex-direction: column; gap: 28rpx; }
/* 版本B：仪表盘数据卡片（与本周页一致） */
.course-card {
  position: relative;
  overflow: hidden;
  background: #FFFFFF;
  border: 3rpx solid #1A1A23;      /* 整条细边框 */
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.05);
  display: flex;
  align-items: stretch;
  gap: 24rpx;
}
/* 左侧能量条（紫→青柠渐变） */
.cb-bar {
  width: 12rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #5B57EB 0%, #B9FF66 100%);
  flex-shrink: 0;
}
.cb-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
/* 顶行：头像 + 课程名 + 会员价徽章 */
.cb-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.cb-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 4rpx solid #1A1A23;
  background: #F0EDDF;
  flex-shrink: 0;
}
.cb-name {
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  color: #1A1A23;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 中行：大数字时间 + 剩余席位读数 */
.cb-mid {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 16rpx;
}
/* 科技运动感数字字体栈：Windows=Bahnschrift/DIN，手机回退等宽 */
.cb-time {
  font-family: "Bahnschrift", "DIN Alternate", "Roboto Mono", "SF Mono", "Menlo", monospace;
  font-size: 40rpx;
  font-weight: 700;
  font-style: italic;                 /* 斜体提速感 */
  letter-spacing: 2rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1;
  color: #1A1A23;
}
.cb-seats {
  text-align: right;
  flex-shrink: 0;
}
/* 纯数字席位（如 4/20） */
.cb-seat-num {
  font-family: "Bahnschrift", "DIN Alternate", "Roboto Mono", "SF Mono", "Menlo", monospace;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1;
  color: #E5484D;
}
.cb-seat-zero {
  color: #EF9F27;   /* 满员时 0/20 金色 */
}
/* 底行：价格 + 难度点阵 + 按钮 */
.cb-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  gap: 16rpx;
}
.cb-price {
  font-family: "Bahnschrift", "DIN Alternate", "Roboto Mono", "SF Mono", "Menlo", monospace;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  color: #1A1A23;
  flex-shrink: 0;
  white-space: nowrap;   /* 会员价与真实价同行不换行 */
}
.cb-price-mem {
  font-size: 22rpx;
  color: #B0AFA8;
  font-weight: 400;
}
.cb-dots {
  display: flex;
  gap: 6rpx;
  flex-shrink: 0;
}
.cb-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #E5E2D4;
}
.cb-dot-on {
  background: #5B57EB;
}
/* 预约按钮 */
.cb-btn {
  background: #B9FF66;
  color: #1A1A23;
  font-size: 26rpx; font-weight: 800;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  border: 3rpx solid #1A1A23;
  flex-shrink: 0;
}
/* 已预订：深色底 */
.btn-booked {
  background: #1A1A23;
  color: #B9FF66;
}
/* 已排位 / 候补排位：紫色 */
.btn-waitlist {
  background: #5B57EB;
  color: #FFFFFF;
  border-color: #5B57EB;
}
/* 满员：置灰 */
.btn-full {
  background: #E5E2D4;
  color: #B0AFA8;
  border-color: #E0DCCB;
}
/* 进行中（红）/ 已结束（灰） */
.btn-ongoing {
  background: #E5484D;
  color: #FFFFFF;
  border-color: #E5484D;
}
.btn-ended {
  background: #E0DCCB;
  color: #8A8A8A;
  border-color: #D9D4C0;
}
/* 不可约状态：整卡弱化 */
.card-off {
  opacity: 0.72;
}
/* 剩余席位 <5：右上角"紧张"斜条 */
.ribbon {
  position: absolute;
  top: 22rpx;
  right: -76rpx;
  transform: rotate(45deg);
  background: #E5484D;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 90rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(229,72,77,0.3);
}
/* 满员：铺满右上角的深金斜条（深色文字保证可读） */
.ribbon-full {
  top: 6rpx;
  right: -130rpx;
  padding: 16rpx 180rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  background: #BA7517;
  color: #4A3200;
  box-shadow: none;
}
.offline-tip {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #B0AFA8;
  padding: 16rpx 0 0;
}
/* 今日无课空状态 */
.empty-today {
  align-items: center;
  padding: 80rpx 0;
}
.empty-today .empty-icon {
  font-size: 72rpx;
  color: #D9D4C0;
}
.empty-today .empty-txt {
  margin-top: 16rpx;
  color: #B0AFA8;
  font-size: 26rpx;
}

.list-spacer { height: 60rpx; }
