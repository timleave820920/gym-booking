<view class="page">
  <view class="page-pad pt-safe">
    <view class="head-row">
      <view class="flex-row back-wrap" bindtap="goBack">
        <text class="icon-back"></text>
        <text class="page-title">获取能量币</text>
      </view>
    </view>

    <!-- 规则列表 -->
    <view class="rule-list">
      <view class="rule-item" wx:for="{{rules}}" wx:key="name">
        <view class="rule-icon">{{item.icon}}</view>
        <view class="rule-info">
          <text class="rule-name">{{item.name}}</text>
          <text class="rule-desc">{{item.desc}}</text>
        </view>
        <text class="rule-reward">{{item.reward}}</text>
      </view>
    </view>

    <!-- 每日上限提示 -->
    <view class="limit-tip flex-row" wx:if="{{dailyLimitText}}">
      <text class="limit-dot"></text>
      <text class="limit-txt">{{dailyLimitText}}</text>
    </view>

    <!-- 底部按钮 -->
    <view class="btn-done" bindtap="goBack">我会好好练</view>

    <view class="list-spacer"></view>
  </view>
</view>
