.page {
  min-height: 100vh;
  background: #F9F4DF;
}
.page-pad {
  padding: 24rpx 24rpx 260rpx;   /* 底部留白给悬浮 TabBar */
}
.pt-safe {
  padding-top: calc(88rpx + env(safe-area-inset-top));   /* 自定义导航，给胶囊让位 */
}

/* 顶部大标题（与上课/我的页一致） */
.head-row { align-items: center; }
.page-title {
  font-size: 48rpx; font-weight: 800; color: #1A1A23;
}

/* 功能宫格 */
.grid {
  margin-top: 32rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.grid-item {
  width: 48%;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-sizing: border-box;
}
.g-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.gi-lime { background: #B9FF66; }
.gi-purple { background: #5B57EB; }
.gi-red { background: #F8B7B8; }
.gi-green { background: #3D9970; }
.gi-gold { background: var(--coin-gold); }
.gi-indigo { background: #8C84F2; }
.g-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A23;
}
.g-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--ink-300);
}

/* 宣传视频位 */
.promo {
  margin-top: 32rpx;
  position: relative;
  height: 340rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #1A1A23;
}
.promo-poster {
  width: 100%;
  height: 340rpx;
  border-radius: 28rpx;
}
.promo-video {
  width: 100%;
  height: 340rpx;
  border-radius: 28rpx;
}
.promo-play {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  background: rgba(0,0,0,0.35);
}
.promo-play-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #B9FF66;
  color: #1A1A23;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.promo-play-txt {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
}
.promo-tag {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: rgba(0,0,0,0.28);
}
.promo-play-btn-sm {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #B9FF66;
  color: #1A1A23;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}