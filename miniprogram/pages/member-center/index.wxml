<view class="page">
  <view class="page-pad pt-safe">
    <!-- 页头 -->
    <view class="head">
      <text class="head-title">活动中心</text>
      <text class="head-sub">会员特权 · 品牌故事 · 一起变强</text>
    </view>

    <!-- 会员卡预览 -->
    <view class="vip-preview" bindtap="go" data-url="/pages/member-card/index">
      <view class="vip-top">
        <text class="vip-name">我的会员卡</text>
        <view class="vip-lv" wx:if="{{level}}">
          <text class="vip-lv-txt">{{level.name}} LV.{{level.lv}}</text>
        </view>
      </view>
      <view class="vip-mid" wx:if="{{level}}">
        <view class="vip-bal">
          <text class="vip-bal-label">储值余额</text>
          <text class="vip-bal-value">¥ {{level.balance}}</text>
        </view>
        <view class="vip-btn" catchtap="goRecharge">去充值</view>
      </view>
      <view class="vip-hint" wx:if="{{level}}">{{level.hint}}</view>
      <view class="vip-loading" wx:else>加载中...</view>
      <!-- 未读奖励提示 -->
      <view class="reward-ribbon" wx:if="{{rewards > 0}}" bindtap="claimReward">
        <text>🎉 有 {{rewards}} 笔储值奖励待领取</text>
      </view>
    </view>

    <!-- 功能宫格 -->
    <view class="sec-title">全部功能</view>
    <view class="grid">
      <view class="grid-item" bindtap="go" data-url="/pages/member-level/index">
        <view class="g-icon gi-lime"><text class="g-icon-txt">Lv</text></view>
        <view class="g-info"><text class="g-name">会员等级</text><text class="g-sub">黄金85折</text></view>
      </view>
      <view class="grid-item" bindtap="go" data-url="/pages/member-recharge/index">
        <view class="g-icon gi-purple"><text class="g-icon-txt">¥</text></view>
        <view class="g-info"><text class="g-name">储值会员</text><text class="g-sub">充500送80</text></view>
      </view>
      <view class="grid-item" bindtap="go" data-url="/pages/invite/index">
        <view class="g-icon gi-red"><text class="g-icon-txt">+</text></view>
        <view class="g-info"><text class="g-name">邀请好友</text><text class="g-sub">各得储值</text></view>
      </view>
      <view class="grid-item" bindtap="go" data-url="/pages/about-us/index">
        <view class="g-icon gi-green"><text class="g-icon-txt">理</text></view>
        <view class="g-info"><text class="g-name">场馆理念</text><text class="g-sub">品牌故事</text></view>
      </view>
      <view class="grid-item" bindtap="go" data-url="/pages/honors/index">
        <view class="g-icon gi-gold"><text class="g-icon-txt">奖</text></view>
        <view class="g-info"><text class="g-name">参赛荣誉</text><text class="g-sub">32项荣誉</text></view>
      </view>
      <view class="grid-item" bindtap="go" data-url="/pages/student-orders/index">
        <view class="g-icon gi-indigo"><text class="g-icon-txt">≡</text></view>
        <view class="g-info"><text class="g-name">我的订单</text><text class="g-sub">支付记录</text></view>
      </view>
    </view>

    <!-- 活动横幅 -->
    <view class="banner" bindtap="goCourses">
      <view class="banner-l">
        <text class="banner-title">夏日燃脂季</text>
        <text class="banner-sub">全场团课 5 折起 · 立即开练</text>
      </view>
      <view class="banner-btn">去抢</view>
    </view>
  </view>
</view>
