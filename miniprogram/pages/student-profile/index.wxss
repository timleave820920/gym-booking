.page {
  min-height: 100vh;
  background: #F9F4DF;
  padding-bottom: 220rpx;
}
.pt-safe {
  padding-top: calc(88rpx + env(safe-area-inset-top));
}
.head-row { align-items: center; }
.page-title {
  font-size: 48rpx; font-weight: 800; color: #1A1A23;
}
.icon-chevron {
  width: 36rpx; height: 36rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M9 6L15 12L9 18" stroke="%231A1A23" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>') no-repeat center/contain;
}

/* 菜单组 */
.menu-group {
  margin-top: 32rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 8rpx 0;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.04);
}
.menu-row {
  height: 104rpx;
  padding: 0 28rpx;
  align-items: center;
  border-bottom: 2rpx solid #F5F2E6;
}
.menu-group .menu-row:last-child {
  border-bottom: none;
}
.menu-icon {
  width: 40rpx; height: 40rpx;
  margin-right: 24rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}
.icon-check {
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M5 13L9 17L19 7" stroke="%231A1A23" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>');
}
.icon-trophy {
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M8 21H16M12 17V21M7 4H17V9C17 11.76 14.76 14 12 14C9.24 14 7 11.76 7 9V4ZM7 6H4C4 9.5 6.5 12 10 12M17 6H20C20 9.5 17.5 12 14 12" stroke="%231A1A23" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>');
}
.icon-wallet {
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><rect x="3" y="6" width="18" height="14" rx="2" stroke="%231A1A23" stroke-width="2"/><path d="M3 10H21" stroke="%231A1A23" stroke-width="2"/><circle cx="16.5" cy="15.5" r="1.5" fill="%231A1A23"/></svg>');
}
.icon-edit {
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M4 20H8L19 9C19.55 8.45 20 7.66 20 6.83C20 5.51 18.93 4.44 17.61 4.44C16.78 4.44 15.99 4.89 15.44 5.44L4 16.88V20Z" stroke="%231A1A23" stroke-width="2" stroke-linejoin="round"/></svg>');
}
.icon-bell {
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M6 8C6 4.69 8.69 2 12 2C15.31 2 18 4.69 18 8V11C18 14.5 19.5 16 19.5 16H4.5C4.5 16 6 14.5 6 11V8Z" stroke="%231A1A23" stroke-width="2"/><path d="M10.3 20C10.73 20.61 11.31 21 12 21C12.69 21 13.27 20.61 13.7 20" stroke="%231A1A23" stroke-width="2" stroke-linecap="round"/></svg>');
}

.menu-name {
  flex: 1;
  font-size: 28rpx; font-weight: 500; color: #1A1A23;
}
.icon-chevron-sm {
  width: 32rpx; height: 32rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M9 6L15 12L9 18" stroke="%236B6B76" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>') no-repeat center/contain;
}

.list-spacer { height: 60rpx; }

/* 退出登录 */
.logout-btn {
  margin-top: 32rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #FFFFFF;
  border: 2rpx solid var(--line-warm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #E5484D;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.04);
}
.openid-hint {
  margin-top: 14rpx;
  text-align: center;
  font-size: 22rpx;
  color: #B0AD9F;
  word-break: break-all;
}

/* 会员卡预览（从活动页迁移） */
.vip-preview {
  margin-top: 20rpx;
  position: relative;
  background: #1A1A23;
  border-radius: 24rpx;
  padding: 28rpx;
  overflow: hidden;
}
.vip-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.vip-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 2026-08-15: 昵称行（编辑态/非编辑态）+ 完善资料提示条 */
.vip-name-row {
  position: relative;
  z-index: 3;              /* 在头像选择按钮(z-index:2)之上，保证昵称可点 */
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  max-width: 300rpx;
  min-height: 60rpx;       /* 扩大点击区域（昵称短时也易点中） */
  padding: 0 16rpx;
}
.nick-edit-ico {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  padding: 4rpx 8rpx;
}
.nick-input {
  width: 220rpx;
  height: 56rpx;
  background: rgba(255,255,255,0.18);
  border-radius: 12rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  color: #FFFFFF;
  box-sizing: border-box;
}
.nick-save {
  font-size: 24rpx;
  color: #C6F04B;
  padding: 6rpx 10rpx;
  font-weight: 600;
}
.profile-tip {
  margin-top: 16rpx;
  background: rgba(198, 240, 75, 0.18);
  border: 1rpx solid rgba(198, 240, 75, 0.5);
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
}
.profile-tip-txt {
  font-size: 22rpx;
  color: #C6F04B;
}
/* 头像 + 昵称（2026-08-14 替代"我的会员"文案） */
.vip-user {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}
.vip-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  border: 3rpx solid rgba(255,255,255,0.3);
  display: block;
  box-sizing: border-box;
}
/* 头像容器 + 透明 chooseAvatar 覆盖层（2026-08-14：button 直接包 image 会破坏 flex 横排，改用覆盖层） */
.avatar-wrap {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}
.avatar-picker {
  position: absolute;
  top: 0; left: 0;
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;        /* 收紧 button 默认最小尺寸，防撑大误触昵称 */
  min-height: 72rpx;
  max-width: 72rpx;
  max-height: 72rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0;
  background: transparent;
  opacity: 0;
  z-index: 2;
}
.avatar-picker::after {
  border: none;
}
/* 等级按钮组：按钮 + 升级提示（右对齐，提示在按钮下方） */
.vip-lv-group {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}
.vip-lv {
  background: #B9FF66;
  border: 3rpx solid #1A1A23;
  border-radius: 16rpx;
  padding: 4rpx 16rpx;
}
.vip-lv-txt {
  font-size: 22rpx;
  font-weight: 700;
  color: #1A1A23;
  line-height: 1;
}
/* 奖牌 emoji 与等级名同行垂直居中（text 混排共用基线导致中文偏低，拆分 flex 修正） */
.lv-inline {
  align-items: center;
  gap: 6rpx;
}
.lv-emoji {
  font-size: 30rpx;
  line-height: 1;
  transform: translateY(1rpx);   /* emoji 视觉中心微调 */
}
.vip-lv-hint {
  font-size: 20rpx;
  color: rgba(255,255,255,0.6);
}
.vip-loading {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
}
/* 统一信息行容器（次数包/储值/能量币共用） */
.vip-row {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
/* 次数包行（次卡信息：剩余次数/过期天数） */
.vip-pass {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255,255,255,0.1);
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
}
.vip-pass-left {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  min-width: 0;
}
.vip-pass-label {
  font-size: 22rpx;
  color: var(--coin-gold);
  font-weight: 600;
}
.vip-pass-num {
  font-size: 34rpx;
  color: #FFFFFF;
  font-weight: 700;
}
.vip-pass-total {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
  font-weight: 400;
}
.vip-pass-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.vip-pass-days {
  font-size: 22rpx;
  color: rgba(255,255,255,0.75);
}
.vip-pass-days-expired {
  color: var(--danger);
}
.vip-pass-go {
  font-size: 22rpx;
  color: var(--lime);
  font-weight: 600;
}
.vip-pass-empty .vip-pass-num {
  font-size: 26rpx;
  color: rgba(255,255,255,0.6);
  font-weight: 400;
}
/* 通用信息行（储值/能量币）：底框 + 左侧标签 + 数值 + 右侧"去xx →" */
.vip-row-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
}
.vip-row-label {
  font-size: 22rpx;
  color: var(--coin-gold);
  font-weight: 600;
}
.vip-row-value {
  font-size: 30rpx;
  font-weight: 800;
  color: #FFFFFF;
}
.vip-row-go {
  margin-left: auto;
  font-size: 20rpx;
  color: var(--lime);
  font-weight: 600;
}

/* 会员体系图标（对齐菜单风格） */
.icon-card {
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><rect x="2" y="5" width="20" height="14" rx="2" stroke="%231A1A23" stroke-width="2"/><path d="M2 10H22" stroke="%231A1A23" stroke-width="2"/><circle cx="16" cy="15" r="1.5" fill="%23B9FF66" stroke="%231A1A23"/></svg>');
}
.icon-lv {
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="%231A1A23" stroke-width="2"/><path d="M8 9.5L12 15L16 9.5" stroke="%231A1A23" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>');
}
.icon-recharge {
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M12 5V19M5 12H19" stroke="%231A1A23" stroke-width="2.5" stroke-linecap="round"/><path d="M7 4H17C18.1 4 19 4.9 19 6V18C19 19.1 18.1 20 17 20H7C5.9 20 5 19.1 5 18V6C5 4.9 5.9 4 7 4Z" stroke="%231A1A23" stroke-width="1.5" stroke-dasharray="2 2"/></svg>');
}

/* 消息未读角标 */
.menu-badge {
  margin-left: auto;
  margin-right: 10rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 17rpx;
  background: #E5484D;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
