<view class="page">
  <view class="page-pad">
    <!-- 使用说明 -->
    <view class="tip-card">
      <text class="tip-icon">👆</text>
      <text class="tip-text">长按下方二维码，点击「识别图中二维码」即可添加微信 / 进群</text>
    </view>

    <!-- 小助理微信 -->
    <view class="qr-card">
      <view class="qr-head">
        <text class="qr-title">小助理微信</text>
        <text class="qr-badge">咨询 · 售后 · 约课协助</text>
      </view>
      <image class="qr-img" src="/images/qr-assistant.png" mode="aspectFit"
             show-menu-by-longpress="true"></image>
      <text class="qr-hint">长按二维码识别，添加小助理微信</text>
    </view>

    <!-- 用户群 -->
    <view class="qr-card">
      <view class="qr-head">
        <text class="qr-title">用户交流群</text>
        <text class="qr-badge">约课搭子 · 训练交流 · 活动通知</text>
      </view>
      <image class="qr-img" src="/images/qr-group.png" mode="aspectFit"
             show-menu-by-longpress="true"></image>
      <text class="qr-hint">长按二维码识别，扫码加入用户群</text>
    </view>

    <view class="list-spacer"></view>
  </view>
</view>
