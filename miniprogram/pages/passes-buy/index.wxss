.page {
  min-height: 100vh;
  background: #F9F4DF;
  padding-bottom: 160rpx;
}
.pt-safe {
  padding-top: 0;  /* 状态栏由 nav-bar 内联 style 按 statusBarH 动态补偿，标题与胶囊水平对齐 */
}
.head-row { align-items: center; }
.back-wrap { align-items: center; gap: 12rpx; }
.icon-back {
  width: 32rpx; height: 32rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M15 5L8 12L15 19" stroke="%231A1A23" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>') no-repeat center/contain;
}
.page-title {
  font-size: 48rpx; font-weight: 800; color: #1A1A23;
}
/* ===== 顶部导航（2026-08-19 统一批：返回钮与教练详情页一致，标题同预约页「早上好」44rpx/800；覆盖上方旧版样式） ===== */
.nav-bar {
  display: flex;
  align-items: flex-start;  /* 顶部对齐：与微信胶囊按钮顶边齐平（2026-08-19） */
  padding: 0 24rpx;
  box-sizing: border-box;
}
.nav-back {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(6rpx);
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-bar .icon-back {
  width: 36rpx; height: 36rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 18" fill="none"><path d="M11 4L6 9L11 14" stroke="%231A1A23" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>') no-repeat center/contain;
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 44rpx;
  font-weight: 800;
  color: #1A1A23;

  line-height: 1;
  margin-top: 8px;  /* 用户拍板：15px 降太多，回调 8px（2026-08-19） */
}
.nav-sp { width: 72rpx; }

/* 我的次卡 */
.my-pass {
  margin-top: 32rpx;
  background: #1A1A23;
  border-radius: 28rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.mp-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
}
.mp-num {
  display: block;
  margin-top: 8rpx;
  font-size: 64rpx;
  font-weight: 800;
  color: #B9FF66;
  line-height: 1;
}
.mp-unit {
  font-size: 28rpx;
}
.mp-expire {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}
.mp-danger {
  color: #FF8FA3;
}
.mp-tag {
  padding: 10rpx 22rpx;
  border-radius: 30rpx;
  background: #B9FF66;
  color: #1A1A23;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.mp-tag-gray {
  background: #3A3A45;
  color: #B0AFA8;
}

/* 档位 */
.pkg-list {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.pkg {
  background: #FFFFFF;
  border: 3rpx solid #E8E2CC;
  border-radius: 28rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.pkg-on {
  border-color: #1A1A23;
  background: #FFFDF4;
}
.pkg-head { align-items: center; gap: 14rpx; }
.pkg-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #1A1A23;
}
.pkg-chip {
  font-size: 22rpx;
  font-weight: 600;
  color: #5B57EB;
  background: #EEEDFE;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  flex-shrink: 0;
}
.pkg-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8A8A8A;
  line-height: 1.5;
}
/* 中列：价格（与左信息、右圆点水平居中，三列对齐） */
.pkg-price {
  font-size: 40rpx;
  font-weight: 800;
  color: #5B57EB;
  line-height: 1;
  margin-left: 16rpx;
  flex-shrink: 0;
}
/* 右列：单选圆点（仿支付方式选择，垂直居中） */
.radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #D8D5CA;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin-left: 24rpx;
  flex-shrink: 0;
}
.radio-on {
  border-color: #1A1A23;
  background: #B9FF66;
}
.radio-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #1A1A23;
}
.pkg-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8A8A8A;
  line-height: 1.6;
  padding-right: 50rpx;
}

/* ===== 无限次卡分区（DESIGN #D14） ===== */
.unl-section {
  margin-top: 44rpx;
}
.unl-head {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}
.unl-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1A1A23;
}
.unl-sub {
  font-size: 22rpx;
  color: #8A8A8A;
}
/* 我的无限次卡（黑卡风，同 my-pass） */
.my-unl {
  margin-top: 24rpx;
  background: #5B57EB;
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.unl-left { flex: 1; }
.unl-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}
.unl-num {
  display: block;
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1;
}
.unl-unit {
  font-size: 26rpx;
  color: #D9D7FF;
}
.unl-expire {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}
.my-unl .mp-tag {
  background: #B9FF66;
}
.my-unl .mp-tag-gray {
  background: rgba(255,255,255,0.2);
  color: rgba(255,255,255,0.8);
}

/* 规则提示 */
.rule-tip {
  margin-top: 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 0 8rpx;
}
.rt-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #5B57EB;
  margin-top: 10rpx;
  flex-shrink: 0;
}
.rt-warn .rt-dot { background: #E5484D; }
.rt-txt {
  flex: 1;
  font-size: 24rpx;
  color: #6B6B76;
  line-height: 1.7;
}
.rt-warn .rt-txt { color: #B02E3C; }

/* 底部 CTA */
.cta-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #FFFFFF;
  border-top: 1rpx solid #E8E2CC;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  align-items: center;
  z-index: 10;
}
.cta-price {
  font-size: 40rpx;
  font-weight: 800;
  color: #1A1A23;
}
.cta-sub {
  font-size: 24rpx;
  color: #8A8A8A;
  margin-top: 4rpx;
}
.pay-btn {
  background: #1A1A23;
  color: #B9FF66;
  font-size: 30rpx;
  font-weight: 700;
  padding: 22rpx 64rpx;
  border-radius: 48rpx;
}
.btn-disabled {
  opacity: 0.5;
}
