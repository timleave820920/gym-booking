<view class="page">
  <view class="page-pad pt-safe">
    <view class="head-row">
      <text class="page-title">个人中心</text>
    </view>

    <!-- 会员卡预览（点击进电子会员卡） -->
    <view class="vip-preview" bindtap="goMemberCard">
      <view class="vip-top">
        <text class="vip-name">我的会员卡</text>
        <view class="vip-lv" wx:if="{{member}}">
          <text class="vip-lv-txt">{{member.icon}} Lv.{{member.lv}}</text>
        </view>
      </view>
      <view class="vip-mid" wx:if="{{member}}">
        <view class="vip-bal">
          <text class="vip-bal-label">储值余额</text>
          <text class="vip-bal-value">¥ {{member.balance}}</text>
        </view>
        <view class="vip-btn" catchtap="goRecharge">去充值</view>
      </view>
      <view class="vip-hint" wx:if="{{member}}">{{member.hint}}</view>
      <view class="vip-loading" wx:else>加载中...</view>
      <!-- 能量币行 -->
      <view class="vip-coins" wx:if="{{member}}" bindtap="goCoinShop">
        <text class="vip-coins-label">⚡ 能量币</text>
        <text class="vip-coins-value">{{coinBalance}}</text>
        <text class="vip-coins-go">去商店 →</text>
      </view>
      <!-- 未读奖励提示 -->
      <view class="reward-ribbon" wx:if="{{rewards > 0}}" bindtap="claimReward">
        <text>🎉 有 {{rewards}} 笔储值奖励待领取</text>
      </view>
    </view>

    <!-- 菜单组 -->
    <view class="menu-group" wx:for="{{menus}}" wx:key="index" wx:for-item="group">
      <view class="menu-row flex-row" wx:for="{{group}}" wx:key="name"
            data-url="{{item.url}}" bindtap="goMenu">
        <view class="menu-icon {{'icon-' + item.icon}}"></view>
        <text class="menu-name">{{item.name}}</text>
        <view class="menu-badge" wx:if="{{item.badge > 0}}">{{item.badge > 99 ? '99+' : item.badge}}</view>
        <text class="icon-chevron-sm"></text>
      </view>
    </view>

    <!-- 退出登录 -->
    <view class="logout-btn" bindtap="logout">
      <text>退出登录</text>
    </view>

    <view class="list-spacer"></view>
  </view>
</view>
