<view class="page">
  <!-- 顶部导航：返回钮与教练详情页一致，标题与微信胶囊按钮水平对齐（2026-08-19） -->
  <view class="nav-bar" style="padding-top: {{statusBarH}}px;">
    <view class="nav-back" bindtap="goBack"><text class="icon-back"></text></view>
    <text class="nav-title">次卡包</text>
    <view class="nav-sp"></view>
  </view>
  <view class="page-pad pt-safe">

    <!-- 当前卡 -->
    <view class="my-pass" wx:if="{{currentPass}}">
      <view class="mp-left">
        <text class="mp-label">我的次卡</text>
        <text class="mp-num">{{currentPass.remaining}} <text class="mp-unit">次</text></text>
        <text class="mp-expire" wx:if="{{!currentPass.expired}}">距过期 {{currentPass.daysLeft}} 天 · {{currentPass.expiresAt.slice(0, 10)}}</text>
        <text class="mp-expire mp-danger" wx:else>已过期（剩余次数作废）</text>
      </view>
      <view class="mp-tag" wx:if="{{!currentPass.expired}}">使用中</view>
      <view class="mp-tag mp-tag-gray" wx:else>已过期</view>
    </view>

    <!-- 档位 -->
    <view class="pkg-list">
      <view class="pkg {{selected.id === item.id ? 'pkg-on' : ''}}" wx:for="{{packages}}" wx:key="id"
            data-id="{{item.id}}" bindtap="selectPkg">
        <!-- 左：档位信息 -->
        <view class="pkg-left flex-col flex-1">
          <view class="flex-row pkg-head">
            <text class="pkg-name">{{item.name}}</text>
            <text class="pkg-chip">{{item.valid_days}} 天 · ¥{{item.unitPrice}}/次</text>
          </view>
          <text class="pkg-desc">{{item.desc}}</text>
        </view>
        <!-- 中：价格 -->
        <text class="pkg-price">¥{{item.price_fen / 100}}</text>
        <!-- 右：单选圆点 -->
        <view class="radio {{selected.id === item.id ? 'radio-on' : ''}}">
          <view class="radio-dot" wx:if="{{selected.id === item.id}}"></view>
        </view>
      </view>
    </view>

    <!-- 无限次卡分区（DESIGN #D14：季卡/年卡，有效期内订课 0 元） -->
    <view class="unl-section">
      <view class="unl-head">
        <text class="unl-title">无限次卡</text>
        <text class="unl-sub">有效期内不限次数订课</text>
      </view>
      <!-- 我的无限次卡 -->
      <view class="my-unl" wx:if="{{currentUnl}}">
        <view class="unl-left">
          <text class="unl-label">我的卡</text>
          <text class="unl-num">{{currentUnl.type === 'year' ? '年卡' : '季卡'}} <text class="unl-unit" wx:if="{{!currentUnl.expired}}">· 剩余 {{currentUnl.daysLeft}} 天</text></text>
          <text class="unl-expire">{{currentUnl.expired ? '已过期' : '有效期至 ' + currentUnl.expiresAt.slice(0, 10)}}</text>
        </view>
        <view class="mp-tag" wx:if="{{!currentUnl.expired}}">使用中</view>
        <view class="mp-tag mp-tag-gray" wx:else>已过期</view>
      </view>
      <!-- 档位卡片 -->
      <view class="pkg-list">
        <view class="pkg {{selectedUnl.id === item.id ? 'pkg-on' : ''}}" wx:for="{{unlPlans}}" wx:key="id"
              data-id="{{item.id}}" bindtap="selectUnl">
          <view class="pkg-left flex-col flex-1">
            <view class="flex-row pkg-head">
              <text class="pkg-name">{{item.name}}</text>
              <text class="pkg-chip">{{item.days}} 天不限次</text>
            </view>
            <text class="pkg-desc">有效期内订课 0 元 · 同一时间只能订一堂课</text>
          </view>
          <text class="pkg-price">¥{{item.price_fen / 100}}</text>
          <view class="radio {{selectedUnl.id === item.id ? 'radio-on' : ''}}">
            <view class="radio-dot" wx:if="{{selectedUnl.id === item.id}}"></view>
          </view>
        </view>
      </view>
      <view class="rule-tip" wx:if="{{unlPlans.length}}">
        <text class="rt-dot"></text>
        <text class="rt-txt">有卡自动使用（订课/候补 0 元）；已购卡再购新卡续期顺延（新卡从旧卡到期次日算起）；退订直接释放名额。</text>
      </view>
    </view>

    <!-- 规则提示 -->
    <view class="rule-tip">
      <text class="rt-dot"></text>
      <text class="rt-txt">订课时自动优先扣次卡次数，次卡不足或过期后依次扣储值余额、微信支付；重复购买次数与有效期叠加（作废日期顺延）。</text>
    </view>
    <view class="rule-tip rt-warn">
      <text class="rt-dot"></text>
      <text class="rt-txt">次卡逾期剩余次数作废，不予退款，请合理规划使用。</text>
    </view>

    <view class="spacer"></view>
  </view>

  <!-- 底部 CTA（跟随当前选中区：次卡 / 无限次卡） -->
  <view class="cta-bar flex-between">
    <view class="flex-col">
      <text class="cta-price" wx:if="{{activeTab === 'unl' ? selectedUnl : selected}}">¥{{(activeTab === 'unl' ? selectedUnl.price_fen : selected.price_fen) / 100}}</text>
      <text class="cta-sub">{{activeTab === 'unl' ? (selectedUnl ? selectedUnl.name + ' · ' + selectedUnl.days + ' 天不限次' : '请选择卡档位') : (selected ? selected.total_count + ' 次 · ' + selected.valid_days + ' 天' : '请选择档位')}}</text>
    </view>
    <view class="pay-btn {{paying ? 'btn-disabled' : ''}}" bindtap="buy">
      <text>{{paying ? '处理中...' : '立即购买'}}</text>
    </view>
  </view>
</view>
