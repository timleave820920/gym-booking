.page {
  min-height: 100vh;
  background: #F9F4DF;
  display: flex;
  flex-direction: column;
  padding-top: calc(88rpx + env(safe-area-inset-top));
}

/* 品牌区 */
.brand-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
}
.logo-badge {
  width: 200rpx;
  height: 200rpx;
  border-radius: 56rpx;
  background: #1A1A23;
  box-shadow: 0 16rpx 44rpx rgba(0,0,0,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}
.logo-icon {
  width: 116rpx;
  height: 116rpx;
  background: #B9FF66;
  border-radius: 28rpx;
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" fill="none"><path d="M8.5 8.5V23.5M5 11.5V20.5M23.5 8.5V23.5M27 11.5V20.5M8.5 16H23.5" stroke="%231A1A23" stroke-width="2.4" stroke-linecap="round"/></svg>');
  background-repeat: no-repeat;
  background-position: center;
  background-size: 64rpx;
}
.brand-name {
  font-size: 68rpx;
  font-weight: 800;
  color: #1A1A23;
  margin-top: 40rpx;
}
.brand-slogan {
  font-size: 28rpx;
  color: #6B6B76;
  margin-top: 16rpx;
}

/* 登录表单区 */
.form-area {
  flex: 1;
  padding: 20rpx 56rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* 微信登录按钮 */
.wx-btn {
  height: 140rpx;
  border-radius: 70rpx;
  background: #1A1A23;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  box-shadow: 0 16rpx 36rpx rgba(26,26,35,0.25);
}
.wx-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 34rpx;
  background: #B9FF66;
}
.wx-icon-in {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A23;
}
.wx-btn-txt {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* 协议 */
.agree-row {
  align-items: center;
  gap: 16rpx;
}
.agree-box {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  border: 3rpx solid #C9C7BC;
  background: #FFFFFF;
  flex-shrink: 0;
}
.agree-on {
  background: #B9FF66;
  border-color: #1A1A23;
}
.agree-check {
  font-size: 24rpx;
  font-weight: 700;
  color: #1A1A23;
}
.agree-txt {
  font-size: 24rpx;
  color: #6B6B76;
  flex: 1;
}

.login-hint {
  font-size: 22rpx;
  color: #B0AFA8;
  text-align: center;
}
