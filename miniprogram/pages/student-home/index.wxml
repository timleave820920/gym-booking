<view class="page">
  <!-- 顶部问候 -->
  <view class="page-pad pt-safe">
    <view class="flex-between">
      <view class="flex-col">
        <text class="greet-title">{{greeting}}</text>
        <text class="greet-date">{{user.date}}</text>
      </view>
      <view class="bell-btn flex-center" bindtap="goProfile">
        <text class="icon-bell"></text>
      </view>
    </view>

    <!-- 活动 Banner -->
    <view class="banner" bindtap="goCourses">
      <text class="banner-tag">SUMMER BURN</text>
      <text class="banner-title">{{t.summerPromo}}</text>
      <text class="banner-sub">{{t.promoSub}}</text>
      <view class="banner-btn">{{t.grabCourse}}</view>
      <image class="banner-img" src="/images/2_166.png" mode="aspectFill"></image>
      <view class="banner-deco"></view>
    </view>

    <!-- 今日课程 -->
    <view class="flex-between hot-head">
      <text class="section-title">{{t.todayCourses}}</text>
      <view class="flex-row more" bindtap="goCourses">
        <text class="more-txt">{{t.viewAll}}</text>
        <text class="icon-chevron"></text>
      </view>
    </view>

    <!-- 后端不可用提示 -->
    <text class="offline-tip" wx:if="{{offline}}">后端未连接，当前展示演示数据</text>

    <view class="hot-list">
      <view class="course-card {{item.disabled ? 'card-off' : ''}}" wx:for="{{hotCourses}}" wx:key="id"
            bindtap="goDetail" data-id="{{item.id}}" data-disabled="{{item.disabled}}" data-waitlist="{{item.canWaitlist}}">
        <!-- 教练圆形头像 -->
        <image class="coach-avatar" src="{{item.coachAvatar}}" mode="aspectFill" data-idx="{{index}}" binderror="avatarError"></image>

        <view class="course-info">
          <!-- 顶部：课程名（大字号） -->
          <text class="course-name">{{item.name}}</text>
          <!-- 时间（中等字号） -->
          <text class="time-txt">{{item.start}} - {{item.end}}</text>
          <!-- 价格 + 会员价（中等字号） -->
          <view class="price-row">
            <text class="price-txt">¥{{item.price}}</text>
            <text class="member-txt">（会员 ¥{{item.memberPrice}}）</text>
          </view>
          <!-- 难度与席位（小字号） -->
          <text class="meta-small">难度 {{item.level}} · 余 {{item.remaining}}/{{item.capacity}} 席</text>
        </view>

        <!-- 右侧按钮（不写价格） -->
        <view class="book-btn {{item.isBooked ? 'btn-booked' : ((item.waitlisted || item.canWaitlist) ? 'btn-waitlist' : (item.isFull ? 'btn-full' : (item.status === 'ongoing' ? 'btn-ongoing' : (item.status === 'ended' ? 'btn-ended' : ''))))}}" catchtap="goDetail" data-id="{{item.id}}" data-disabled="{{item.disabled}}" data-waitlist="{{item.canWaitlist}}">
          <text wx:if="{{item.isBooked}}">已预订</text>
          <text wx:elif="{{item.waitlisted}}">{{t.waitlisted}}</text>
          <text wx:elif="{{item.canWaitlist}}">{{t.waitlistBtn}}</text>
          <text wx:elif="{{item.isFull}}">已满</text>
          <text wx:elif="{{item.status === 'ongoing'}}">{{t.ongoing}}</text>
          <text wx:elif="{{item.status === 'ended'}}">{{t.ended}}</text>
          <text wx:else>预约</text>
        </view>

        <!-- 剩余席位 0：右上角金色"满员"斜条；1~5：红色"紧张"斜条 -->
        <view class="ribbon ribbon-full" wx:if="{{item.remaining === 0}}">满员</view>
        <view class="ribbon" wx:if="{{item.remaining > 0 && item.remaining < 5}}">紧张</view>
      </view>

      <!-- 今日暂无课程 -->
      <view class="empty-today flex-col" wx:if="{{loaded && hotCourses.length === 0}}">
        <text class="empty-icon">▦</text>
        <text class="empty-txt">{{t.noTodayCourse}}</text>
      </view>
    </view>

    <view class="list-spacer"></view>
  </view>
</view>
