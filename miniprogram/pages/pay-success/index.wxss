.page {
  min-height: 100vh;
  background: #F9F4DF;
  display: flex;
  flex-direction: column;
}

.flex-col { display: flex; flex-direction: column; }
.flex-row { display: flex; flex-direction: row; }
.flex-1 { flex: 1; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }

/* 成功区 */
.success-wrap {
  flex: 1;
  align-items: center;
  padding: 120rpx 48rpx 60rpx;
}

/* 成功图标（对勾圆圈，SVG） */
.success-ico {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="%233D9970"/><path d="M8 12.5L11 15.5L16.5 9.5" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>') no-repeat center/contain;
  box-shadow: 0 16rpx 40rpx rgba(61,153,112,0.25);
}

.success-title {
  margin-top: 40rpx;
  font-size: 48rpx;
  font-weight: 800;
  color: #1A1A23;
}

.success-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6B6B76;
}

/* 课程信息卡 */
.course-card {
  margin-top: 64rpx;
  width: 100%;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
}
.card-body {
  gap: 20rpx;
  align-items: center;
}
.course-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background: #F0EDDF;
  flex-shrink: 0;
}
.course-info {
  gap: 6rpx;
  min-width: 0;
}
.course-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A23;
}
.course-meta {
  font-size: 24rpx;
  color: #6B6B76;
}
.course-time {
  font-size: 24rpx;
  color: #B0AFA8;
}
.card-foot {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #F0EDDF;
}
.pay-label {
  font-size: 24rpx;
  color: #6B6B76;
}
.pay-amount {
  font-size: 36rpx;
  font-weight: 800;
  color: #1A1A23;
}

/* 查看按钮 */
.view-btn {
  margin-top: 80rpx;
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: #1A1A23;
  color: #B9FF66;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(0,0,0,0.18);
}

.tip-txt {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #B0AFA8;
}

/* 候补提示条 */
.wait-tip {
  margin-top: 32rpx;
  width: 100%;
  background: #F0EBFF;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
}
.wait-tip-txt {
  font-size: 22rpx;
  line-height: 1.7;
  color: #5B57EB;
}
