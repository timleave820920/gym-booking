/* ===== 后台公共样式（与 admin-students 保持一致）===== */
.admin-page {
  min-height: 100vh;
  background: #F0EDDF;
}

/* 顶栏 */
.admin-top {
  height: 96rpx;
  padding: 0 32rpx;
  background: #1A1A23;
  align-items: center;
}
.admin-brand {
  align-items: center;
  gap: 16rpx;
}
.brand-logo {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: #B9FF66;
}
.brand-name {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
}
.admin-user {
  align-items: center;
  gap: 16rpx;
}
.admin-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #5B57EB;
}
.admin-name {
  color: #FFFFFF;
  font-size: 24rpx;
}
.admin-exit {
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255,255,255,0.15);
  color: #FFFFFF;
  font-size: 24rpx;
}

/* 后台横向导航条 */
.admin-nav {
  background: #1A1A23;
  white-space: nowrap;
  width: 100%;
}
.nav-inner {
  display: flex;
  padding: 16rpx 24rpx 24rpx;
  gap: 12rpx;
}
.nav-item {
  flex-shrink: 0;
  padding: 14rpx 32rpx;
  border-radius: 36rpx;
  background: rgba(255,255,255,0.08);
  color: #B0AFA8;
  font-size: 26rpx;
}
.nav-active {
  background: #B9FF66;
  color: #1A1A23;
  font-weight: 700;
}

/* 内容 */
.admin-content {
  padding: 32rpx;
}
.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1A1A23;
}

/* 通用 flex */
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-row { display: flex; flex-direction: row; }
.flex-col { display: flex; flex-direction: column; }
.flex-1 { flex: 1; }

/* ===== 数据库信息卡 ===== */
.db-info-card {
  margin-top: 24rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 8rpx 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.05);
}
.db-info-row {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F0EDDF;
}
.db-info-row:last-child {
  border-bottom: none;
}
.db-label {
  font-size: 26rpx;
  color: #6B6B76;
}
.db-value {
  font-size: 26rpx;
  color: #1A1A23;
  font-weight: 600;
}
.db-path {
  font-size: 22rpx;
  color: #B0AFA8;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.db-num {
  color: #1A1A23;
  font-size: 32rpx;
  font-weight: 800;
}
.db-status-wrap { align-items: center; gap: 10rpx; }
.db-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.dot-on { background: #3D9970; }
.dot-off { background: #E5484D; }
.text-green { color: #3D9970; font-weight: 700; }
.text-red { color: #E5484D; font-weight: 700; }

/* ===== 危险操作区 ===== */
.danger-card {
  margin-top: 24rpx;
  background: #FFF5F5;
  border: 2rpx solid #FFD4D4;
  border-radius: 28rpx;
  padding: 28rpx;
}
.danger-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #E5484D;
}
.danger-desc {
  font-size: 24rpx;
  color: #C98A8A;
  margin-top: 8rpx;
}
.danger-btns {
  margin-top: 20rpx;
}
.danger-btn {
  height: 88rpx;
  border-radius: 24rpx;
  background: #E5484D;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
}

/* ===== 用户列表 ===== */
.panel {
  margin-top: 24rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.05);
}
.panel-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A23;
}
.panel-sub {
  font-size: 24rpx;
  color: #B0AFA8;
}
/* 用户行 */
.db-user-row {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F0EDDF;
  align-items: center;
  gap: 20rpx;
}
.db-user-row:last-child {
  border-bottom: none;
}
.db-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #F0EDDF;
  flex-shrink: 0;
}
.db-user-top {
  align-items: center;
  gap: 12rpx;
}
.db-user-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A23;
}
.db-role {
  font-size: 20rpx;
  color: #5B57EB;
  background: #EEECFF;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}
.db-user-sub {
  font-size: 24rpx;
  color: #6B6B76;
  margin-top: 4rpx;
}
.db-user-time {
  font-size: 22rpx;
  color: #B0AFA8;
  margin-top: 4rpx;
}
.db-del-btn {
  padding: 12rpx 28rpx;
  border-radius: 20rpx;
  border: 2rpx solid #E5484D;
  color: #E5484D;
  font-size: 24rpx;
  flex-shrink: 0;
}

/* 空状态 */
.empty-table {
  align-items: center;
  padding: 60rpx 0;
}
.empty-ico {
  width: 96rpx;
  height: 96rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><circle cx="9" cy="8" r="3.5" stroke="%23B0AFA8" stroke-width="1.6"/><path d="M2.5 20C2.5 16.13 5.41 13 9 13C12.59 13 15.5 16.13 15.5 20" stroke="%23B0AFA8" stroke-width="1.6" stroke-linecap="round"/></svg>') no-repeat center/contain;
}

.bottom-space {
  height: 80rpx;
}
