<view class="page">
  <view class="scan-content">
    <text class="scan-tip">请将学员的签到码对准扫描框</text>

    <!-- 扫描框 -->
    <view class="scan-frame">
      <view class="corner corner-tl"></view>
      <view class="corner corner-tr"></view>
      <view class="corner corner-bl"></view>
      <view class="corner corner-br"></view>
      <view class="scan-line"></view>
    </view>

    <!-- 课程信息 -->
    <view class="course-info flex-row">
      <view class="icon-clock"></view>
      <text class="course-txt">{{course.name}} · {{course.time}} · {{course.venue}}</text>
    </view>

    <!-- 操作按钮 -->
    <view class="action-row flex-row">
      <view class="action-btn outline" bindtap="manualCheckin">手动签到</view>
      <view class="action-btn lime" bindtap="chooseFromAlbum">从相册选择</view>
    </view>
  </view>
</view>
