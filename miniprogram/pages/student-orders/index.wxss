.page {
  min-height: 100vh;
  background: #F9F4DF;
}

.page-pad {
  padding: 32rpx 32rpx 0;
}
.pt-safe {
  padding-top: 24rpx;
}
.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flex-col {
  display: flex;
  flex-direction: column;
}

.head-row {
  margin-bottom: 28rpx;
}
.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1A1A23;
}
.head-date {
  font-size: 24rpx;
  color: #B0AFA8;
}

.loading-tip {
  text-align: center;
  color: #B0AFA8;
  padding: 80rpx 0;
  font-size: 26rpx;
}

/* 订单卡片 */
.order-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}
.order-top {
  align-items: center;
}
.order-no {
  font-size: 20rpx;
  color: #B0AFA8;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.order-status {
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
}
.st-pending {
  background: #FFF3E0;
  color: #E8890C;
}
.st-paid {
  background: #E3F5EA;
  color: #3D9970;
}
.st-cancelled {
  background: #F0EDDF;
  color: var(--ink-300);
}
.st-refunded {
  background: #FCEBEB;
  color: #E5484D;
}

.order-mid {
  margin-top: 16rpx;
  align-items: center;
}
.order-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A23;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.order-price {
  font-size: 30rpx;
  font-weight: 800;
  color: #1A1A23;
}
.order-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6B6B76;
}
.order-foot {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #F0EDDF;
  align-items: center;
}

/* 空状态 */
.empty-state {
  align-items: center;
  padding: 120rpx 0;
}
.empty-icon {
  font-size: 64rpx;
  color: var(--ink-300);
}
.empty-txt {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #6B6B76;
}
.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #B0AFA8;
}

.list-spacer {
  height: 40rpx;
}
