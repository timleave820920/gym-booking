<view class="page">
  <!-- 顶部问候 -->
  <view class="page-pad pt-safe">
    <view class="flex-between">
      <view class="flex-col">
        <text class="greet-title">{{greeting}}</text>
        <text class="greet-date">{{user.date}}</text>
      </view>
      <view class="bell-btn flex-center" bindtap="goProfile">
        <text class="icon-bell"></text>
      </view>
    </view>

    <!-- 活动 Banner -->
    <view class="banner" bindtap="goCourses">
      <text class="banner-tag">SUMMER BURN</text>
      <text class="banner-title">{{t.summerPromo}}</text>
      <text class="banner-sub">{{t.promoSub}}</text>
      <view class="banner-btn">{{t.grabCourse}}</view>
      <image class="banner-img" src="/images/2_166.png" mode="aspectFill"></image>
      <view class="banner-deco"></view>
    </view>

    <!-- 今日课程 -->
    <view class="flex-between hot-head">
      <text class="section-title">{{t.todayCourses}}</text>
      <view class="flex-row more" bindtap="goCourses">
        <text class="more-txt">{{t.viewAll}}</text>
        <text class="icon-chevron"></text>
      </view>
    </view>

    <!-- 后端不可用提示 -->
    <text class="offline-tip" wx:if="{{offline}}">后端未连接，当前展示演示数据</text>

    <view class="hot-list">
      <view class="course-card flex-row {{item.status !== 'upcoming' ? 'card-off' : ''}}" wx:for="{{hotCourses}}" wx:key="id"
            bindtap="goDetail" data-id="{{item.id}}">
        <image class="course-cover" src="{{item.img}}" mode="aspectFill"></image>
        <view class="flex-col flex-1 course-info">
          <view class="flex-row name-row">
            <text class="course-name">{{item.name}}</text>
            <text class="status-tag status-ongoing" wx:if="{{item.status === 'ongoing'}}">{{t.ongoing}}</text>
            <text class="status-tag status-ended" wx:if="{{item.status === 'ended'}}">{{t.ended}}</text>
          </view>
          <view class="flex-row course-meta">
            <text class="icon-clock"></text>
            <text class="meta-txt">{{item.metaText}}</text>
          </view>
          <view class="flex-between coach-row">
            <text class="coach-name">{{item.coachText}}</text>
            <view class="book-btn {{item.status === 'ongoing' ? 'book-ongoing' : (item.status === 'ended' ? 'book-ended' : '')}}" catchtap="goDetail" data-id="{{item.id}}">
              <text>{{item.status === 'ongoing' ? t.ongoing : (item.status === 'ended' ? t.ended : '¥' + item.price + ' ' + t.bookClass)}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 今日暂无课程 -->
      <view class="empty-today flex-col" wx:if="{{loaded && hotCourses.length === 0}}">
        <text class="empty-icon">▦</text>
        <text class="empty-txt">{{t.noTodayCourse}}</text>
      </view>
    </view>

    <view class="list-spacer"></view>
  </view>
</view>
