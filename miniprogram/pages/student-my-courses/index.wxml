<view class="page">
  <!-- 固定顶部：标题 + 待上课/已完成 分段切换（下滑时保持不动） -->
  <view class="my-head">
    <view class="page-pad pt-safe">
      <view class="flex-between head-row">
        <text class="page-title">上课</text>
        <text class="head-date">8月</text>
      </view>

      <!-- 分段切换 -->
      <view class="seg flex-row">
        <view class="seg-item {{tab === 0 ? 'seg-active' : ''}}" data-idx="0" bindtap="switchTab">
          <text>待上课</text>
        </view>
        <view class="seg-item {{tab === 1 ? 'seg-active' : ''}}" data-idx="1" bindtap="switchTab">
          <text>已完成</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 可滚动区：仅课程卡片滚动（页面级滚动，sticky 头部固定） -->
  <view class="list-scroll">
    <view class="list-pad">
      <!-- 加载中 -->
      <view class="empty-state flex-col" wx:if="{{loading}}">
        <text class="empty-txt">加载中...</text>
      </view>

      <!-- 待上课：课程卡片（订课 + 候补排位，界面一致；点卡片可进详情） -->
      <view class="my-list" wx:if="{{!loading && tab === 0 && courses.length > 0}}">
        <view class="my-card" wx:for="{{courses}}" wx:key="id" bindtap="goDetail" data-session="{{item.sessionId}}">
          <view class="flex-between card-top">
            <view class="tag {{item.isWait ? 'tag-purple' : 'tag-green'}}">{{item.status}}</view>
            <text class="card-date">{{item.date}}</text>
          </view>
          <view class="flex-row card-body">
            <view class="flex-col time-box">
              <text class="time-value">{{item.time}}</text>
              <text class="time-dur">{{item.duration}}</text>
            </view>
            <view class="v-divider"></view>
            <view class="flex-col flex-1 info-box">
              <text class="course-name">{{item.name}}</text>
              <text class="course-meta">教练 · {{item.coach}} · {{item.venue}}</text>
            </view>
          </view>
          <text class="wait-expire" wx:if="{{item.isWait}}">{{item.expireText}}</text>
          <view class="flex-row card-actions">
            <view class="btn-sm btn-outline" wx:if="{{!item.isWait}}" catchtap="refund" data-id="{{item.id}}" data-name="{{item.name}}">退订</view>
            <view class="btn-sm btn-outline" wx:if="{{item.isWait}}" catchtap="exitWaitlist" data-id="{{item.id}}" data-name="{{item.name}}">退出候补</view>
            <view class="btn-sm btn-primary" wx:if="{{!item.isWait && item.statusType === 'pending' && item.canCheckin}}" catchtap="checkin" data-id="{{item.id}}">签到</view>
            <view class="btn-sm btn-purple" wx:if="{{item.isWait}}" catchtap="showWaitHint">排位</view>
          </view>
        </view>
      </view>

      <!-- 空状态：待上课 -->
      <view class="empty-state flex-col" wx:if="{{!loading && tab === 0 && courses.length === 0}}">
        <text class="empty-icon">✓</text>
        <text class="empty-txt">您尚未订课</text>
        <text class="empty-sub">去课程列表挑一节喜欢的课吧</text>
        <view class="empty-btn" bindtap="goCourses">去选课</view>
      </view>

      <!-- 已完成：过去参与过的课程 -->
      <view class="my-list" wx:if="{{!loading && tab === 1 && completed.length > 0}}">
        <view class="my-card" wx:for="{{completed}}" wx:key="id">
          <view class="flex-between card-top">
            <view class="tag tag-gray">{{item.status}}</view>
            <text class="card-date">{{item.date}}</text>
          </view>
          <view class="flex-row card-body">
            <view class="flex-col time-box">
              <text class="time-value">{{item.time}}</text>
              <text class="time-dur">{{item.duration}}</text>
            </view>
            <view class="v-divider"></view>
            <view class="flex-col flex-1 info-box">
              <text class="course-name">{{item.name}}</text>
              <text class="course-meta">教练 · {{item.coach}} · {{item.venue}}</text>
            </view>
          </view>
          <text class="wait-expire" wx:if="{{item.isWait}}">{{item.expireText}}</text>
          <view class="flex-row card-actions">
            <text class="done-status {{item.checked ? 'done-checked' : ''}}">{{item.checked ? '已签到 ✓' : '未签到'}}</text>
          </view>
        </view>
        <!-- 只显示最近 7 天的提示 -->
        <view class="list-hint" wx:if="{{showDoneHint}}">只显示最近7天的已完成课程</view>
      </view>

      <!-- 空状态：暂无已完成 -->
      <view class="empty-state flex-col" wx:if="{{!loading && tab === 1 && completed.length === 0}}">
        <text class="empty-icon">▦</text>
        <text class="empty-txt">暂无已完成课程</text>
        <text class="empty-sub">去约一堂课，开启你的训练记录吧</text>
        <view class="empty-btn" bindtap="goCourses">去选课</view>
      </view>

    <view class="list-spacer"></view>
    </view>
  </view>
</view>
