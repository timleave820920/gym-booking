.page {
  min-height: 100vh;
  background: #F9F4DF;
  padding-bottom: 160rpx;
}

/* 顶部轮播 */
.hero-swiper {
  width: 100%;
  height: 480rpx;
  position: relative;
}
.hero-img {
  width: 100%;
  height: 480rpx;
}
.hero-ph {
  width: 100%;
  height: 480rpx;
  background: linear-gradient(135deg, #1A1A23 0%, #3A3A45 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}
.ph-num {
  font-size: 180rpx;
  font-weight: 800;
  color: #B9FF66;
}
.hero-nav {
  position: absolute;
  top: calc(24rpx + env(safe-area-inset-top));
  left: 0; right: 0;
  display: flex;
  justify-content: space-between;
  padding: 0 32rpx;
  z-index: 10;
}
.round-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(26,26,35,0.55);
  backdrop-filter: blur(6rpx);
}
.icon-back {
  width: 32rpx; height: 32rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M15 5L8 12L15 19" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>') no-repeat center/contain;
}
.icon-share {
  width: 30rpx; height: 30rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M12 3L8 7M12 3L16 7M12 3V15" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 12V19C5 19.55 5.45 20 6 20H18C18.55 20 19 19.55 19 19V12" stroke="white" stroke-width="2" stroke-linecap="round"/></svg>') no-repeat center/contain;
}

/* 内容区 */
.detail-content {
  padding: 28rpx 32rpx 0;
}
.title-row {
  align-items: flex-start;
  gap: 20rpx;
}
.course-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1A1A23;
  line-height: 1.3;
}
.course-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6B6B76;
}
.share-btn {
  flex-shrink: 0;
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #1A1A23;
  color: #B9FF66;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 40rpx;
  padding: 14rpx 28rpx;
}
.share-ico {
  width: 26rpx;
  height: 26rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M12 3L8 7M12 3L16 7M12 3V15" stroke="%23B9FF66" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 12V19C5 19.55 5.45 20 6 20H18C18.55 20 19 19.55 19 19V12" stroke="%23B9FF66" stroke-width="2" stroke-linecap="round"/></svg>') no-repeat center/contain;
}

/* 通用信息卡 */
.row-card {
  margin-top: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  align-items: center;
  gap: 20rpx;
}
.rc-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background-size: 40rpx;
  background-position: center;
  background-repeat: no-repeat;
}
.rc-time {
  background-color: #E8F5D8;
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="%234A7A2E" stroke-width="2"/><path d="M12 7V12L15 14" stroke="%234A7A2E" stroke-width="2" stroke-linecap="round"/></svg>');
}
.rc-loc {
  background-color: #E6F1FB;
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M12 21C12 21 5 14.5 5 10C5 6.13 8.13 3 12 3C15.87 3 19 6.13 19 10C19 14.5 12 21 12 21Z" stroke="%23185FA5" stroke-width="2"/><circle cx="12" cy="10" r="2.5" stroke="%23185FA5" stroke-width="2"/></svg>');
}
.rc-label {
  font-size: 22rpx;
  color: #8A8A8A;
}
.rc-value {
  display: block;
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A23;
}
.rc-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8A8A8A;
}
.nav-btn {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: #1A1A23;
  color: #B9FF66;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 16rpx;
  padding: 16rpx 26rpx;
}
.nav-ico {
  width: 28rpx;
  height: 28rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="%23B9FF66" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>') no-repeat center/contain;
}

/* 已预约 */
.booked-card {
  margin-top: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
}
.booked-head {
  align-items: center;
}
.booked-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A23;
}
.booked-count {
  font-size: 30rpx;
  font-weight: 800;
  color: #5B57EB;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.booked-total {
  font-size: 24rpx;
  color: #8A8A8A;
  font-weight: 400;
}
.avatar-scroll {
  margin-top: 20rpx;
  white-space: nowrap;
  width: 100%;
}
.avatar-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-right: 24rpx;
  width: 96rpx;
}
.avatar-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 3rpx solid #E8E2CC;
  background: #F0EDDF;
}
/* 头像右下角同堂次数小圆标（>9 前端显示 "..."；荧光绿底黑描边，对齐设计语言） */
.avatar-wrap {
  position: relative;
  width: 88rpx;
  height: 88rpx;
}
.co-tag {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #C6F04B;
  border: 2rpx solid #1A1A23;
  color: #1A1A23;
  font-size: 18rpx;
  font-weight: 500;
  line-height: 30rpx;
  text-align: center;
  box-sizing: border-box;
}
.avatar-name {
  font-size: 20rpx;
  color: #6B6B76;
  max-width: 96rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.booked-empty {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #B0AFA8;
}
/* 同堂次数说明小字（预约墙下方） */
.co-tip {
  display: block;
  margin-top: 16rpx;
  font-size: 20rpx;
  color: #B0AFA8;
}

/* 教练 */
.coach-card {
  margin-top: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  align-items: flex-start;
  gap: 24rpx;
}
.coach-left {
  align-items: center;
  flex-shrink: 0;
}
.coach-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #1A1A23;
  background: #F0EDDF;
}
.coach-name {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A23;
}
.coach-bio {
  flex: 1;
  font-size: 24rpx;
  color: #6B6B76;
  line-height: 1.8;
  padding-top: 8rpx;
}
/* 2026-08-15: 教练卡可点击进介绍页 */
.coach-bio-box { flex: 1; min-width: 0; }
.coach-more {
  display: block;
  font-size: 22rpx;
  color: #1A1A23;
  font-weight: 700;
  margin-top: 6rpx;
  text-decoration: underline;
}

/* 训练详情 */
.desc-card {
  margin-top: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
}
.desc-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #1A1A23;
}
.desc-text {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #4A4A55;
  line-height: 1.9;
}
.detail-spacer { height: 60rpx; }

/* 底部 CTA */
.cta-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #FFFFFF;
  border-top: 1rpx solid #E8E2CC;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  align-items: center;
  z-index: 20;
}
.price-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #1A1A23;
}
.price-sub {
  font-size: 22rpx;
  color: #8A8A8A;
  margin-top: 4rpx;
}
.book-btn {
  background: #1A1A23;
  color: #B9FF66;
  font-size: 30rpx;
  font-weight: 700;
  padding: 24rpx 56rpx;
  border-radius: 48rpx;
}
.booked {
  background: #E8E2CC;
  color: #B0AFA8;
}
.text-red { color: #E5484D; }
