<view class="page">
  <view class="success-wrap flex-col">
    <!-- 成功图标（SVG） -->
    <view class="success-ico"></view>
    <text class="success-title" wx:if="{{!isWaitlist}}">支付成功！</text>
    <text class="success-title" wx:else>排位成功！</text>
    <text class="success-sub" wx:if="{{!isWaitlist}}">已成功预订课程</text>
    <text class="success-sub" wx:else>已进入候补队列，有人退订将自动转正</text>

    <!-- 课程信息卡 -->
    <view class="course-card" wx:if="{{course}}">
      <view class="flex-row card-body">
        <image class="course-img" src="{{course.img}}" mode="aspectFill"></image>
        <view class="flex-col flex-1 course-info">
          <text class="course-name">{{course.name}}</text>
          <text class="course-meta">教练 · {{course.coach}} · {{course.venue}}</text>
          <text class="course-time">{{course.time}}</text>
        </view>
      </view>
      <view class="flex-between card-foot">
        <text class="pay-label">实付金额</text>
        <text class="pay-amount">¥{{course.price}}</text>
      </view>
    </view>

    <!-- 候补提示条 -->
    <view class="wait-tip" wx:if="{{isWaitlist}}">
      <text class="wait-tip-txt">候补说明：开课前有学员退订，将按排队顺序自动转正并保留席位；课程开始仍未排到将自动原路退款。</text>
    </view>

    <!-- 查看按钮 -->
    <view class="view-btn" bindtap="goProfile">
      <text>查看</text>
    </view>
    <text class="tip-txt" wx:if="{{!isWaitlist}}">可前往「上课」查看已订课程</text>
    <text class="tip-txt" wx:else>可前往「上课」查看候补进度</text>
  </view>
</view>
