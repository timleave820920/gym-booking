.page {
  min-height: 100vh;
  background: #F9F4DF;
  padding-bottom: 220rpx;
}
.pt-safe {
  padding-top: calc(88rpx + env(safe-area-inset-top));
}
.head-row { align-items: center; }
.page-title {
  font-size: 48rpx; font-weight: 800; color: #1A1A23;
}
.filter-btn {
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.05);
}
.icon-filter {
  width: 36rpx; height: 36rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 18" fill="none"><path d="M2 5H16M5 9H13M8 13H10" stroke="%231A1A23" stroke-width="2" stroke-linecap="round"/></svg>') no-repeat center/contain;
}

/* 日期选择条 */
.date-bar {
  margin-top: 32rpx;
  gap: 12rpx;
}
.date-item {
  flex: 1;
  height: 128rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  align-items: center;
  justify-content: center;
}
.date-active {
  background: #1A1A23;
}
.date-week {
  font-size: 22rpx; color: #6B6B76;
}
.week-active { color: #B9FF66; }
.date-num {
  font-size: 36rpx; font-weight: 700; color: #1A1A23;
  margin-top: 4rpx;
}
.num-active { color: #FFFFFF; font-weight: 800; }

/* 课程列表 */
.course-list { margin-top: 32rpx; display: flex; flex-direction: column; gap: 28rpx; }
/* 版本B：仪表盘数据卡片 */
.course-card {
  position: relative;
  overflow: hidden;
  background: #FFFFFF;
  border: 3rpx solid #1A1A23;      /* 整条细边框 */
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.05);
  display: flex;
  align-items: stretch;
  gap: 24rpx;
}
/* 左上角圆点徽章（方案C） */
.cb-dot {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #5B57EB;
  border: 3rpx solid #1A1A23;
}
.cb-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
/* 顶行：头像 + 课程名 + 会员价徽章 */
.cb-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.cb-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 4rpx solid #1A1A23;
  background: #F0EDDF;
  flex-shrink: 0;
}
.cb-name {
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  color: #1A1A23;
  flex: 1;
  min-width: 0;
  padding-right: 180rpx;   /* 给右上角星标让位（星标加大后） */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 中行：大数字时间 + 剩余席位读数 */
.cb-mid {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 16rpx;
}
/* 科技运动感数字字体栈：Windows=Bahnschrift/DIN，手机回退等宽 */
.cb-time {
  font-family: "Bahnschrift", "DIN Alternate", "Roboto Mono", "SF Mono", "Menlo", monospace;
  font-size: 40rpx;
  font-weight: 700;
  font-style: italic;                 /* 斜体提速感 */
  letter-spacing: 2rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1;
  color: #1A1A23;
}
.cb-seats {
  background: #FFFFFF;          /* 白底红边胶囊（方案B） */
  border: 3rpx solid #E5484D;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  text-align: center;
  flex-shrink: 0;
}
/* 满员：胶囊描边转金 */
.cb-seats-full {
  border-color: #EF9F27;
}
/* 纯数字席位（如 4/20） */
.cb-seat-num {
  font-family: "Bahnschrift", "DIN Alternate", "Roboto Mono", "SF Mono", "Menlo", monospace;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1;
  color: #E5484D;               /* 白底红字 */
}
.cb-seat-zero {
  color: #EF9F27;   /* 满员时 20/20 金色 */
}
/* 底行：价格 + 难度点阵 + 按钮 */
.cb-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  gap: 16rpx;
}
.cb-price {
  font-family: "Bahnschrift", "DIN Alternate", "Roboto Mono", "SF Mono", "Menlo", monospace;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  color: #1A1A23;
  flex-shrink: 0;
  white-space: nowrap;   /* 会员价与真实价同行不换行 */
}
.cb-price-mem {
  font-size: 22rpx;
  color: #B0AFA8;
  font-weight: 400;
}
.cb-stars {
  position: absolute;      /* 难度星标：右上角 */
  top: 22rpx;
  right: 24rpx;
  display: flex;
  gap: 2rpx;
  flex-shrink: 0;
}
.cb-star {
  font-size: 30rpx;          /* 与课程名字号相当 */
  line-height: 1;
  color: #E0DCCB;            /* 空星 */
}
.cb-star-on {
  color: #EF9F27;          /* 实星金色 */
}
/* 预约按钮 */
.cb-btn {
  background: #B9FF66;
  color: #1A1A23;
  font-size: 26rpx; font-weight: 800;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  border: 3rpx solid #1A1A23;
  flex-shrink: 0;
}
/* 已预订：深色底 */
.btn-booked {
  background: #1A1A23;
  color: #B9FF66;
}
/* 已排位 / 候补排位：紫色 */
.btn-waitlist {
  background: #5B57EB;
  color: #FFFFFF;
  border-color: #5B57EB;
}
/* 满员：置灰 */
.btn-full {
  background: #E5E2D4;
  color: #B0AFA8;
  border-color: #E0DCCB;
}
/* 进行中（红）/ 已结束（灰） */
.btn-ongoing {
  background: #E5484D;
  color: #FFFFFF;
  border-color: #E5484D;
}
.btn-ended {
  background: #E0DCCB;
  color: #8A8A8A;
  border-color: #D9D4C0;
}
/* 不可约状态：整卡弱化 */
.card-full {
  opacity: 0.75;
}
/* 剩余席位 <5：右上角"紧张"斜条 */
.ribbon {
  position: absolute;
  top: 22rpx;
  right: -76rpx;
  transform: rotate(45deg);
  background: #E5484D;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 90rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(229,72,77,0.3);
}
/* 满员：旋转方块铺满整个右上角（深金底 + 深色文字） */
.ribbon-full {
  position: absolute;
  top: -120rpx;
  right: -120rpx;
  width: 240rpx;
  height: 240rpx;
  transform: rotate(45deg);
  background: #BA7517;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 30rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #4A3200;
  box-shadow: none;
}

/* 空状态 */
.empty-state {
  align-items: center;
  padding: 120rpx 0;
}
.offline-tip {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #B0AFA8;
  padding: 16rpx 0 0;
}
.loading-tip {
  text-align: center;
  font-size: 26rpx;
  color: #B0AFA8;
  padding: 80rpx 0;
}
.empty-icon {
  font-size: 96rpx; color: #D9D4C0;
}
.empty-txt {
  margin-top: 24rpx; color: #6B6B76; font-size: 30rpx;
}
.empty-sub {
  margin-top: 8rpx; color: #B0AFA8; font-size: 24rpx;
}

.list-spacer { height: 60rpx; }
