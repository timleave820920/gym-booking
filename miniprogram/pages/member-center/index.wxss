.page {
  min-height: 100vh;
  background: #F9F4DF;
}
.page-pad {
  padding: 24rpx 24rpx 260rpx;   /* 底部留白给悬浮 TabBar */
}
.pt-safe {
  padding-top: calc(88rpx + env(safe-area-inset-top));   /* 自定义导航，给胶囊让位 */
}

/* 顶部大标题（与上课/我的页一致） */
.head-row { align-items: center; }
.page-title {
  font-size: 48rpx; font-weight: 800; color: #1A1A23;
}

/* 功能宫格 */
.grid {
  margin-top: 32rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.grid-item {
  width: 48%;
  background: #FFFFFF;
  border: 3rpx solid #1A1A23;
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-sizing: border-box;
}
.g-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.g-icon-txt {
  font-size: 30rpx;
  font-weight: 800;
}
.gi-lime { background: #B9FF66; }
.gi-purple { background: #5B57EB; }
.gi-red { background: #F8B7B8; }
.gi-green { background: #3D9970; }
.gi-gold { background: #F8D044; }
.gi-indigo { background: #8C84F2; }
.gi-purple .g-icon-txt, .gi-green .g-icon-txt, .gi-indigo .g-icon-txt { color: #FFFFFF; }
.gi-lime .g-icon-txt, .gi-red .g-icon-txt, .gi-gold .g-icon-txt { color: #1A1A23; }
.g-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A23;
}
.g-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8A8A8A;
}
