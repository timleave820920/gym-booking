<view class="page">
  <view class="page-pad pt-safe">
    <view class="flex-between head-row">
      <view class="flex-row back-wrap" bindtap="goBack">
        <text class="icon-back"></text>
        <text class="page-title">我的成就</text>
      </view>
      <view class="share-btn flex-row" bindtap="share">
        <text class="icon-share"></text>
        <text class="share-txt">分享</text>
      </view>
    </view>

    <!-- 加载中 -->
    <view class="empty-state flex-col" wx:if="{{loading}}">
      <text class="empty-txt">加载中...</text>
    </view>

    <!-- 数据卡组 -->
    <view class="stats-row flex-row" wx:if="{{!loading}}">
      <view class="stat-card flex-col stat-dark" wx:for="{{stats}}" wx:key="label">
        <text class="stat-value {{index === 0 ? 'value-lime' : (index === 1 ? 'value-purple' : 'value-orange')}}">{{item.value}}</text>
        <text class="stat-label">{{item.label}}</text>
      </view>
    </view>

    <!-- 连续打卡（无箭头） -->
    <view class="streak-card flex-row">
      <text class="icon-flame"></text>
      <view class="flex-col flex-1">
        <text class="streak-title">已连续坚持 {{streak}} 天</text>
        <text class="streak-sub">刷新本月最长记录，继续保持！</text>
      </view>
    </view>

    <!-- 本周记录（无达标标签） -->
    <view class="week-card" wx:if="{{!loading}}">
      <view class="flex-between">
        <text class="card-title">本周锻炼记录</text>
        <text class="week-total">{{weekCount}} 次</text>
      </view>
      <view class="week-row flex-row">
        <view class="day-item flex-col {{item.today ? 'day-today' : (item.active ? 'day-on' : '')}}"
              wx:for="{{weekRecord}}" wx:key="weekday">
          <text class="day-week {{item.today ? 'text-lime' : (item.active ? '' : 'text-muted')}}">{{item.weekday}}</text>
          <text class="day-count {{item.today ? 'text-white' : (item.active ? '' : 'text-placeholder')}}">{{item.today ? '今天' : item.count}}</text>
        </view>
      </view>
    </view>

    <!-- 成就时间线（30 项 · 阶段分组） -->
    <view class="ach-section" wx:if="{{!loading}}">
      <view class="flex-between ach-head">
        <text class="card-title">成就时间线</text>
        <text class="ach-progress {{unlockedAll ? 'ach-progress-full' : ''}}">{{unlockedAll ? '全部达成 🏆' : '已解锁 ' + unlockedTotal + ' / 30'}}</text>
      </view>

      <view class="ach-stage" wx:for="{{stages}}" wx:key="label" wx:for-item="stage">
        <view class="stage-head flex-row">
          <text class="stage-name">{{stage.name}}</text>
          <text class="stage-label">{{stage.label}}</text>
          <text class="stage-count">{{stage.unlockedCount}}/{{stage.items.length}}</text>
        </view>
        <view class="ach-grid">
          <view class="ach-item flex-col" wx:for="{{stage.items}}" wx:for-item="ach" wx:key="id">
            <!-- 奖牌 + 缎带 -->
            <view class="badge">
              <view class="badge-ring">
                <view class="badge-core" style="background: {{ach.unlocked ? ach.color : '#EDEBE2'}}">
                  <text class="badge-icon {{ach.unlocked ? '' : 'badge-icon-off'}}">{{ach.unlocked ? ach.icon : '?'}}</text>
                </view>
              </view>
              <view class="ribbon ribbon-l" style="background: {{ach.unlocked ? ach.color : '#D8D5CA'}}"></view>
              <view class="ribbon ribbon-r" style="background: {{ach.unlocked ? ach.color : '#D8D5CA'}}"></view>
            </view>
            <text class="ach-name {{ach.unlocked ? '' : 'ach-name-off'}}">{{ach.name}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 后端不可用 -->
    <view class="empty-state flex-col" wx:if="{{offline}}">
      <text class="empty-icon">▦</text>
      <text class="empty-txt">后端未连接</text>
      <text class="empty-sub">无法加载成就数据，请确认服务已启动</text>
    </view>

    <view class="list-spacer"></view>
  </view>
</view>
