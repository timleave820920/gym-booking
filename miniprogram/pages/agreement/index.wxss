/* 协议详情页（设计系统 v1.1：奶油画布 + 墨黑文字） */
.page {
  min-height: 100vh;
  background: var(--cream);
}
.page-pad {
  padding: 32rpx 40rpx 80rpx;
}

.doc-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink-900);
  line-height: 1.3;
}
.doc-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-500);
}

.doc-section {
  margin-top: 40rpx;
}
.doc-section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink-900);
}

.doc-para {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--ink-900);
}

.doc-li {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 12rpx;
}
.doc-li-dot {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--lime);
  flex-shrink: 0;
}
.doc-li-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--ink-900);
  flex: 1;
}

.contact-card {
  margin-top: 48rpx;
  background: var(--ink-0);
  border-radius: var(--r-card);
  padding: 28rpx;
  box-shadow: var(--shadow-card);
}
.contact-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink-900);
}
.contact-line {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink-500);
}

.doc-foot {
  display: block;
  margin-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-300);
}
