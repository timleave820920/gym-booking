<view class="page">
  <view class="page-pad pt-safe">
    <view class="flex-between head-row">
      <view class="flex-col">
        <text class="greet-title">{{greeting}}</text>
        <text class="greet-sub">{{summary}}</text>
      </view>
      <image class="coach-avatar" src="/images/2_645.png" mode="aspectFill"></image>
    </view>

    <!-- 今日概览（DESIGN #D13：教练核销移除，卡片纯展示） -->
    <view class="today-card flex-row">
      <view class="icon-calendar"></view>
      <view class="flex-col flex-1">
        <text class="today-title">{{dateText}}</text>
        <text class="today-sub">{{firstTime || '记得提前到场'}}</text>
      </view>
      <text class="icon-chevron"></text>
    </view>

    <!-- 后端不可用提示 -->
    <text class="offline-tip" wx:if="{{offline}}">后端未连接，当前无法加载真实课表</text>

    <!-- 课表列表 -->
    <view class="schedule-list">
      <view class="loading-tip" wx:if="{{loading}}">加载中...</view>

      <view class="schedule-card flex-row" wx:for="{{schedule}}" wx:key="id"
            data-id="{{item.id}}" bindtap="goStudents">
        <view class="flex-col time-box">
          <text class="time-value">{{item.time}}</text>
          <text class="time-dur">{{item.duration}}</text>
        </view>
        <view class="flex-col flex-1 info-box">
          <text class="course-name">{{item.name}}</text>
          <view class="course-meta flex-row">
            <text>{{item.venue}}</text>
            <text class="meta-dot">·</text>
            <view class="icon-person meta-ico"></view>
            <text>已报名 {{item.enrolled}}/{{item.capacity}}</text>
          </view>
        </view>
        <view class="tag {{item.statusType === 'green' ? 'tag-green' : (item.statusType === 'orange' ? 'tag-orange' : 'tag-gray')}}">
          {{item.status}}
        </view>
      </view>

      <!-- 空状态：今日无课 -->
      <view class="empty-state flex-col" wx:if="{{!loading && schedule.length === 0 && !offline}}">
        <text class="empty-icon">▦</text>
        <text class="empty-txt">今天没有排课</text>
        <text class="empty-sub">休息日也要好好放松</text>
      </view>
    </view>

    <view class="list-spacer"></view>
  </view>

  <!-- 教练端 TabBar -->
  <view class="tabbar-wrap safe-bottom">
    <view class="tabbar-pill">
      <view class="tab-item active admin-active">
        <text class="tab-icon">▦</text>
        <text>课表</text>
      </view>
      <view class="tab-item" bindtap="goStudents" data-id="1">
        <text class="tab-icon">●</text>
        <text>学员</text>
      </view>
      <view class="tab-item" bindtap="goProfile">
        <text class="tab-icon">⌂</text>
        <text>退出</text>
      </view>
    </view>
  </view>
</view>
