<view class="page">
  <view class="page-pad pt-safe">
    <view class="head-row">
      <text class="page-title">个人中心</text>
    </view>

    <!-- 会员卡预览（点击进会员等级页；能量币行 catchtap 防冒泡——BUG-LEDGER #11 修复） -->
    <view class="vip-preview">
      <!-- 第一行：头像+昵称 + 等级按钮（升级提示右对齐在按钮下方） -->
      <view class="vip-top" bindtap="goMemberLevel">
        <view class="vip-user">
          <view class="avatar-wrap">
            <image class="vip-avatar" src="{{user.avatar}}" mode="aspectFill" binderror="avatarError"></image>
            <!-- 透明 chooseAvatar 按钮覆盖头像：触发微信头像选择（不破坏布局） -->
            <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar"></button>
          </view>
          <text class="vip-name">{{user.name}}</text>
        </view>
        <view class="vip-lv-group" wx:if="{{member}}">
          <view class="vip-lv" bindtap="goMemberLevel">
            <text class="vip-lv-txt">{{member.icon}} Lv.{{member.lv}}</text>
          </view>
          <text class="vip-lv-hint" wx:if="{{member.hint}}">{{member.hint}}</text>
        </view>
      </view>
      <view class="vip-loading" wx:if="{{!member}}">加载中...</view>

      <!-- 第二行：次数包（已购：剩余次数/过期天数；未购：引导去购买） -->
      <view class="vip-row" wx:if="{{member}}">
        <view class="vip-pass" wx:if="{{passInfo.hasPass}}" catchtap="goPass">
          <view class="vip-pass-left">
            <text class="vip-pass-label">🎟️ 次数包</text>
            <text class="vip-pass-num">{{passInfo.remaining}}<text class="vip-pass-total"> / {{passInfo.total}} 次</text></text>
          </view>
          <view class="vip-pass-right">
            <text class="vip-pass-days" wx:if="{{!passInfo.expired}}">剩余 {{passInfo.daysLeft}} 天</text>
            <text class="vip-pass-days vip-pass-days-expired" wx:else>已过期</text>
            <text class="vip-pass-go">详情 →</text>
          </view>
        </view>
        <!-- 未购次数包：引导去购买 -->
        <view class="vip-pass vip-pass-empty" wx:else catchtap="goPass">
          <view class="vip-pass-left">
            <text class="vip-pass-label">🎟️ 次数包</text>
            <text class="vip-pass-num">尚未购买次数包</text>
          </view>
          <view class="vip-pass-right">
            <text class="vip-pass-go">去购买 →</text>
          </view>
        </view>

        <!-- 第三行：储值信息（底框 + 去充值改为去商店式表达） -->
        <view class="vip-row-item" bindtap="goRecharge">
          <text class="vip-row-label">💰 储值余额</text>
          <text class="vip-row-value">¥ {{member.balance}}</text>
          <text class="vip-row-go">去充值 →</text>
        </view>

        <!-- 能量币行 -->
        <view class="vip-row-item" catchtap="goCoinShop">
          <text class="vip-row-label">⚡ 能量币</text>
          <text class="vip-row-value">{{coinBalance}}</text>
          <text class="vip-row-go">去商店 →</text>
        </view>
      </view>
    </view>

    <!-- 菜单组 -->
    <view class="menu-group" wx:for="{{menus}}" wx:key="index" wx:for-item="group">
      <view class="menu-row flex-row" wx:for="{{group}}" wx:key="name"
            data-url="{{item.url}}" bindtap="goMenu">
        <view class="menu-icon {{'icon-' + item.icon}}"></view>
        <text class="menu-name">{{item.name}}</text>
        <view class="menu-badge" wx:if="{{item.badge > 0}}">{{item.badge > 99 ? '99+' : item.badge}}</view>
        <text class="icon-chevron-sm"></text>
      </view>
    </view>

    <!-- 退出登录 -->
    <view class="logout-btn" bindtap="logout">
      <text>退出登录</text>
    </view>

    <view class="list-spacer"></view>
  </view>
</view>
