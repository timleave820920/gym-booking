<view class="page">
  <view class="page-pad pt-safe">
    <view class="flex-between head-row">
      <text class="page-title">全部课程</text>
      <view class="filter-btn flex-center">
        <text class="icon-filter"></text>
      </view>
    </view>

    <!-- 周日期选择条 -->
    <view class="date-bar flex-row">
      <view class="date-item flex-col {{item.selected ? 'date-active' : ''}}"
            wx:for="{{weekDays}}" wx:key="full"
            data-full="{{item.full}}" data-date="{{item.date}}" bindtap="selectDate">
        <text class="date-week {{item.selected ? 'week-active' : ''}}">{{item.weekday}}</text>
        <text class="date-num {{item.selected ? 'num-active' : ''}}">{{item.date}}</text>
      </view>
    </view>

    <!-- 后端不可用提示 -->
    <text class="offline-tip" wx:if="{{offline}}">后端未连接，当前展示演示数据</text>

    <!-- 课程列表 -->
    <view class="course-list">
      <view class="loading-tip" wx:if="{{loading}}">加载中...</view>
      <view class="course-card flex-row {{item.isFull || item.isBooked ? 'card-full' : ''}}" wx:for="{{courseList}}" wx:key="id"
            bindtap="goDetail" data-id="{{item.id}}" data-full="{{item.isFull}}" data-booked="{{item.isBooked}}">
        <image class="course-cover" src="{{item.img}}" mode="aspectFill"></image>
        <view class="flex-col flex-1 course-info">
          <text class="course-name">{{item.name}}</text>
          <view class="flex-row course-meta">
            <text class="icon-clock"></text>
            <text class="meta-txt">{{item.start}}-{{item.end}} · {{item.category}}</text>
          </view>
          <view class="flex-between coach-row">
            <text class="coach-name">教练 · {{item.coach}}</text>
            <text class="seat-count {{item.isFull ? 'seat-full' : ''}}">{{item.seatText}}</text>
            <view class="book-btn {{item.isBooked ? 'btn-booked' : (item.isFull ? 'btn-full' : '')}}" catchtap="goDetail" data-id="{{item.id}}" data-full="{{item.isFull}}" data-booked="{{item.isBooked}}">
              <text wx:if="{{item.isBooked}}">已预订</text>
              <text wx:elif="{{item.isFull}}">已满</text>
              <text wx:else>¥{{item.price}} 约课</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state flex-col" wx:if="{{courseList.length === 0}}">
        <text class="empty-icon">▦</text>
        <text class="empty-txt">当天暂无排课</text>
        <text class="empty-sub">试试选择其他日期</text>
      </view>
    </view>

    <view class="list-spacer"></view>
  </view>
</view>
