<view class="page">
  <view class="page-pad pt-safe">
    <view class="head-row">
      <text class="page-title">个人中心</text>
    </view>

    <!-- 会员卡预览（点击进会员等级页；能量币行 catchtap 防冒泡——BUG-LEDGER #11 修复） -->
    <view class="vip-preview">
      <!-- 第一行：头像+昵称（点头像只换头像，不跳等级）+ 等级按钮（点击进等级页） -->
      <view class="vip-top">
        <view class="vip-user">
          <view class="avatar-wrap">
            <image class="vip-avatar" src="{{user.avatar}}" mode="aspectFill" binderror="avatarError" bindtap="onTapAvatar"></image>
            <!-- 2026-08-15: 改用 wx.chooseAvatar API（弃用 open-type=chooseAvatar 覆盖按钮——button 默认点击区域会误触昵称/保存按钮） -->
          </view>
          <!-- 昵称：非编辑态显示 + 铅笔入口；编辑态为微信昵称输入（键盘可一键填入微信昵称） -->
          <view class="vip-name-row" wx:if="{{!editingNick}}" bindtap="startEditNick">
            <text class="vip-name">{{user.name}}</text>
            <text class="nick-edit-ico">✎</text>
          </view>
          <view class="vip-name-row" wx:else>
            <input class="nick-input" type="nickname" placeholder="点输入，可一键填入微信昵称"
                   placeholder-class="invite-ph" value="{{nickDraft}}" bindinput="onNickInput"
                   bindblur="autoSaveNick" focus="{{true}}" />
            <text class="nick-save" bindtap="saveNick">保存</text>
          </view>
        </view>
        <view class="vip-lv-group" wx:if="{{member}}">
          <view class="vip-lv" bindtap="goMemberLevel">
            <view class="flex-row lv-inline">
              <text class="lv-emoji">{{member.icon}}</text>
              <text class="vip-lv-txt">{{member.name}}</text>
            </view>
          </view>
          <text class="vip-lv-hint" wx:if="{{member.hint}}">{{member.hint}}</text>
        </view>
      </view>
      <!-- 2026-08-15: 新用户完善资料提示（可选，点头像换微信头像 / 点昵称填微信昵称） -->
      <view class="profile-tip" wx:if="{{showProfileTip}}" bindtap="startEditNick">
        <text class="profile-tip-txt">设置微信头像昵称（可选）— 点头像换微信头像，点昵称一键填入 →</text>
      </view>
      <view class="vip-loading" wx:if="{{!member}}">加载中...</view>

      <!-- 第二行：次数包（已购：剩余次数/过期天数；未购：引导去购买） -->
      <view class="vip-row" wx:if="{{member}}">
        <view class="vip-pass" wx:if="{{passInfo.hasPass}}" catchtap="goPass">
          <view class="vip-pass-left">
            <text class="vip-pass-label">🎟️ 次数包</text>
            <text class="vip-pass-num">{{passInfo.remaining}}<text class="vip-pass-total"> / {{passInfo.total}} 次</text></text>
          </view>
          <view class="vip-pass-right">
            <text class="vip-pass-days" wx:if="{{!passInfo.expired}}">剩余 {{passInfo.daysLeft}} 天</text>
            <text class="vip-pass-days vip-pass-days-expired" wx:else>已过期</text>
            <text class="vip-pass-go">详情 →</text>
          </view>
        </view>
        <!-- 未购次数包：引导去购买 -->
        <view class="vip-pass vip-pass-empty" wx:else catchtap="goPass">
          <view class="vip-pass-left">
            <text class="vip-pass-label">🎟️ 次数包</text>
            <text class="vip-pass-num">尚未购买次数包</text>
          </view>
          <view class="vip-pass-right">
            <text class="vip-pass-go">去购买 →</text>
          </view>
        </view>

        <!-- 第三行：储值信息（底框 + 去充值改为去商店式表达） -->
        <view class="vip-row-item" bindtap="goRecharge">
          <text class="vip-row-label">💰 储值余额</text>
          <text class="vip-row-value">¥ {{member.balance}}</text>
          <text class="vip-row-go">去充值 →</text>
        </view>

        <!-- 能量币行 -->
        <view class="vip-row-item" catchtap="goCoinShop">
          <text class="vip-row-label">⚡ 能量币</text>
          <text class="vip-row-value">{{coinBalance}}</text>
          <text class="vip-row-go">去商店 →</text>
        </view>
      </view>
    </view>

    <!-- 社交画像卡（DESIGN #D5-3）：性别/生日自填 → 首次送 20 能量币 + 生日月首订 8 折 -->
    <view class="profile-card" wx:if="{{profile}}">
      <view class="profile-card-head">
        <text class="profile-card-title">🎯 完善画像</text>
        <text class="profile-card-sub" wx:if="{{!profileSaved}}">首次填写奖励 20 能量币</text>
        <text class="profile-card-sub" wx:else>已完善，可随时修改</text>
      </view>
      <view class="profile-row">
        <text class="profile-label">性别</text>
        <view class="gender-group">
          <view class="gender-item {{genderSel === 0 ? 'on' : ''}}" data-g="0" bindtap="onGenderTap">未知</view>
          <view class="gender-item {{genderSel === 1 ? 'on' : ''}}" data-g="1" bindtap="onGenderTap">男</view>
          <view class="gender-item {{genderSel === 2 ? 'on' : ''}}" data-g="2" bindtap="onGenderTap">女</view>
        </view>
      </view>
      <view class="profile-row">
        <text class="profile-label">生日</text>
        <picker mode="date" end="{{todayStr}}" value="{{birthdaySel}}" bindchange="onBirthdayChange">
          <view class="birthday-pick {{birthdaySel ? '' : 'ph'}}">{{birthdaySel || '选择生日'}}</view>
        </picker>
      </view>
      <view class="profile-bday-tip" wx:if="{{profile.in_birthday_month}}">🎂 本月是您的生日月，首次订课享 8 折</view>
      <view class="profile-save" bindtap="saveProfile">保存画像</view>
    </view>

    <!-- 菜单组 -->
    <view class="menu-group" wx:for="{{menus}}" wx:key="index" wx:for-item="group">
      <view class="menu-row flex-row" wx:for="{{group}}" wx:key="name"
            data-url="{{item.url}}" bindtap="goMenu">
        <view class="menu-icon {{'icon-' + item.icon}}"></view>
        <text class="menu-name">{{item.name}}</text>
        <view class="menu-badge" wx:if="{{item.badge > 0}}">{{item.badge > 99 ? '99+' : item.badge}}</view>
        <text class="icon-chevron-sm"></text>
      </view>
    </view>

    <!-- 退出登录 -->
    <view class="logout-btn" bindtap="logout">
      <text>退出登录</text>
    </view>
    <!-- 当前账号 openid（管理页绑定教练时核对用） -->
    <view class="openid-hint">openid：{{openid}}</view>

    <view class="list-spacer"></view>
  </view>
</view>
