<view class="page" wx:if="{{course}}">
  <!-- 顶部轮播图：最多5张（服务器端图，未配置显示 1-5 数字占位），3秒自动右滑循环 -->
  <swiper class="hero-swiper" autoplay="{{true}}" interval="{{3000}}" duration="450" circular="{{true}}"
          indicator-dots="{{gallery.length > 1}}" indicator-color="rgba(255,255,255,0.4)" indicator-active-color="#B9FF66">
    <swiper-item wx:for="{{gallery}}" wx:key="*this">
      <image wx:if="{{!isPlaceholder}}" class="hero-img" src="{{item}}" mode="aspectFill"></image>
      <view wx:else class="hero-ph">
        <text class="ph-num">{{item}}</text>
      </view>
    </swiper-item>
  </swiper>
  <view class="hero-nav">
    <view class="round-btn flex-center" bindtap="goBack">
      <text class="icon-back"></text>
    </view>
  </view>

  <!-- 内容区 -->
  <view class="detail-content">
    <!-- 课程名 + 简要标题 + 分享 -->
    <view class="flex-row title-row">
      <view class="flex-col flex-1">
        <text class="course-title">{{course.name}}</text>
        <text class="course-sub">{{course.sub}}</text>
      </view>
      <button class="share-btn" open-type="share">
        <text class="share-ico"></text>
        <text>分享</text>
      </button>
    </view>

    <!-- 课程时间：起止 + 年月日小字 -->
    <view class="row-card flex-row">
      <view class="rc-icon rc-time"></view>
      <view class="flex-col flex-1">
        <text class="rc-label">课程时间</text>
        <text class="rc-value">{{course.start}} - {{course.end}}</text>
        <text class="rc-sub">{{course.dateText}}</text>
      </view>
    </view>

    <!-- 地点 + 导航 -->
    <view class="row-card flex-row" bindtap="openMap">
      <view class="rc-icon rc-loc"></view>
      <view class="flex-col flex-1">
        <text class="rc-label">上课地点</text>
        <text class="rc-value">{{course.address}}</text>
      </view>
      <view class="nav-btn">
        <text class="nav-ico"></text>
        <text>导航</text>
      </view>
    </view>

    <!-- 已预约人数 + 头像墙（横向滑动） -->
    <view class="booked-card">
      <view class="flex-between booked-head">
        <text class="booked-label">已预约</text>
        <view class="booked-count flex-row">
          <view class="icon-person"></view>
          <text>{{bookedCount}}<text class="booked-total"> / {{course.capacity}}</text></text>
        </view>
      </view>
      <scroll-view class="avatar-scroll" scroll-x wx:if="{{bookedUsers.length}}" enhanced show-scrollbar="{{false}}">
        <view class="avatar-item" wx:for="{{bookedUsers}}" wx:key="openid">
          <view class="avatar-wrap">
            <image class="avatar-img" src="{{item.avatar || '/images/2_556.png'}}" mode="aspectFill"></image>
            <view class="co-tag">{{item.coCount > 9 ? '...' : item.coCount}}</view>
          </view>
          <text class="avatar-name">{{item.nickname || '微信用户'}}</text>
        </view>
      </scroll-view>
      <text class="co-tip" wx:if="{{bookedUsers.length}}">*数字代表您与该健身达人的同堂次数</text>
      <text class="booked-empty" wx:else>还没有人预约，快来抢占第一个席位</text>
    </view>

    <!-- 教练：头像 + 名字 + 右侧说明（点击进入教练介绍页，2026-08-15） -->
    <view class="coach-card flex-row" bindtap="goCoachProfile" data-coach="{{course.coachId}}">
      <view class="flex-col coach-left">
        <image class="coach-avatar" src="{{course.coachAvatar || '/images/2_295.png'}}" mode="aspectFill"></image>
        <text class="coach-name">{{course.coach}}</text>
      </view>
      <view class="coach-bio-box">
        <text class="coach-bio">{{course.coachBio}}</text>
        <text class="coach-more">查看教练介绍 ›</text>
      </view>
    </view>

    <!-- 训练详情 -->
    <view class="desc-card">
      <text class="desc-title">训练详情</text>
      <text class="desc-text">{{descText}}</text>
    </view>

    <view class="detail-spacer"></view>
  </view>

  <!-- 底部 CTA -->
  <view class="cta-bar flex-between">
    <view class="flex-col price-box">
      <text class="price-value">¥ {{course.price}}</text>
      <text class="price-sub">单次 ¥{{course.price}} · 约课后直接支付</text>
    </view>
    <view class="flex-col wait-col">
      <view class="book-btn {{isBooked || isWaitlisted ? 'booked' : (status === 'ongoing' || status === 'ended' ? 'booked' : '')}}" bindtap="bookNow" data-booked="{{isBooked}}">
        <text wx:if="{{isBooked}}">已预订</text>
        <text wx:elif="{{isWaitlisted}}">排位中</text>
        <text wx:elif="{{status === 'ongoing'}}">{{t.ongoing}}</text>
        <text wx:elif="{{status === 'ended'}}">{{t.ended}}</text>
        <text wx:else>{{t.bookImmediate}}</text>
      </view>
      <!-- 排位人数提示（DESIGN #D3）：已排位=您前面还有 N 人；满员未排位=当前 N 人排队中 -->
      <view class="waitlist-hint" wx:if="{{isWaitlisted && myWaitPosition !== null}}">您前面还有 {{myWaitPosition}} 人</view>
      <view class="waitlist-hint" wx:elif="{{!isBooked && !isWaitlisted && waitlistCount > 0}}">当前 {{waitlistCount}} 人排队中</view>
    </view>
  </view>
</view>
