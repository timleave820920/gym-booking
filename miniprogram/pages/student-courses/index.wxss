.page {
  min-height: 100vh;
  background: #F9F4DF;
  padding-bottom: 220rpx;
}
.pt-safe {
  padding-top: calc(88rpx + env(safe-area-inset-top));
}
.head-row { align-items: center; }
.page-title {
  font-size: 48rpx; font-weight: 800; color: #1A1A23;
}
.filter-btn {
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.05);
}
.icon-filter {
  width: 36rpx; height: 36rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 18" fill="none"><path d="M2 5H16M5 9H13M8 13H10" stroke="%231A1A23" stroke-width="2" stroke-linecap="round"/></svg>') no-repeat center/contain;
}

/* 日期选择条 */
.date-bar {
  margin-top: 32rpx;
  gap: 12rpx;
}
.date-item {
  flex: 1;
  height: 128rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  align-items: center;
  justify-content: center;
}
.date-active {
  background: #1A1A23;
}
.date-week {
  font-size: 22rpx; color: #6B6B76;
}
.week-active { color: #B9FF66; }
.date-num {
  font-size: 36rpx; font-weight: 700; color: #1A1A23;
  margin-top: 4rpx;
}
.num-active { color: #FFFFFF; font-weight: 800; }

/* 课程列表 */
.course-list { margin-top: 32rpx; display: flex; flex-direction: column; gap: 28rpx; }
.course-card {
  position: relative;
  overflow: hidden;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.05);
  display: flex;
  align-items: center;
  gap: 24rpx;
}
/* 教练圆形头像 */
.coach-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  border: 3rpx solid #1A1A23;
  background: #F0EDDF;
  flex-shrink: 0;
}
.course-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
/* 顶部：课程名（大字号） */
.course-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #1A1A23;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 时间（中等字号） */
.time-txt {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #6B6B76;
}
/* 价格 + 会员价（中等字号） */
.price-row {
  margin-top: 8rpx;
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}
.price-txt {
  font-size: 28rpx;
  font-weight: 800;
  color: #1A1A23;
}
.member-txt {
  font-size: 24rpx;
  color: #B0AFA8;
}
/* 难度与席位（小字号） */
.meta-small {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #B0AFA8;
}
.book-btn {
  background: #B9FF66;
  color: #1A1A23;
  font-size: 24rpx; font-weight: 700;
  padding: 12rpx 28rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
}
/* 满员：按钮置灰 */
.btn-full {
  background: #E5E2D4;
  color: #B0AFA8;
}
/* 已预订：按钮用品牌深色 */
.btn-booked {
  background: #1A1A23;
  color: #B9FF66;
}
/* 满员/不可约：整卡降透明度 */
.card-full {
  opacity: 0.75;
}
/* 进行中（红）/ 已结束（灰） */
.btn-ongoing {
  background: #E5484D;
  color: #FFFFFF;
}
.btn-ended {
  background: #E0DCCB;
  color: #8A8A8A;
}
/* 候补排位按钮（紫色强调） */
.btn-waitlist {
  background: #5B57EB;
  color: #FFFFFF;
}
/* 剩余席位 <5：右上角"紧张"斜条 */
.ribbon {
  position: absolute;
  top: 22rpx;
  right: -76rpx;
  transform: rotate(45deg);
  background: #E5484D;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 90rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(229,72,77,0.3);
}

/* 空状态 */
.empty-state {
  align-items: center;
  padding: 120rpx 0;
}
.offline-tip {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #B0AFA8;
  padding: 16rpx 0 0;
}
.loading-tip {
  text-align: center;
  font-size: 26rpx;
  color: #B0AFA8;
  padding: 80rpx 0;
}
.empty-icon {
  font-size: 96rpx; color: #D9D4C0;
}
.empty-txt {
  margin-top: 24rpx; color: #6B6B76; font-size: 30rpx;
}
.empty-sub {
  margin-top: 8rpx; color: #B0AFA8; font-size: 24rpx;
}

.list-spacer { height: 60rpx; }
