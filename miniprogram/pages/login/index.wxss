.page {
  min-height: 100vh;
  background: #F9F4DF;
  display: flex;
  flex-direction: column;
  padding-top: calc(88rpx + env(safe-area-inset-top));
}

/* 品牌区 */
.brand-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
}
.logo-badge {
  width: 200rpx;
  height: 200rpx;
  border-radius: 56rpx;
  background: #1A1A23;
  box-shadow: 0 16rpx 44rpx rgba(0,0,0,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}
.logo-icon {
  width: 116rpx;
  height: 116rpx;
  background: #B9FF66;
  border-radius: 28rpx;
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" fill="none"><path d="M8.5 8.5V23.5M5 11.5V20.5M23.5 8.5V23.5M27 11.5V20.5M8.5 16H23.5" stroke="%231A1A23" stroke-width="2.4" stroke-linecap="round"/></svg>');
  background-repeat: no-repeat;
  background-position: center;
  background-size: 64rpx;
}
.brand-name {
  font-size: 68rpx;
  font-weight: 800;
  color: #1A1A23;
  margin-top: 40rpx;
}
.brand-slogan {
  font-size: 28rpx;
  color: #6B6B76;
  margin-top: 16rpx;
}

/* 登录表单区 */
.form-area {
  flex: 1;
  padding: 20rpx 56rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* 微信登录按钮 */
.wx-btn {
  height: 140rpx;
  border-radius: 70rpx;
  background: #1A1A23;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  box-shadow: 0 16rpx 36rpx rgba(26,26,35,0.25);
}
.wx-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 34rpx;
  background: #B9FF66;
}
.wx-icon-in {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A23;
}
.wx-btn-txt {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* 或分隔线 */
.or-divider {
  align-items: center;
  gap: 20rpx;
}
.or-line {
  flex: 1;
  height: 2rpx;
  background: #D9D4C0;
}
.or-txt {
  font-size: 24rpx;
  color: #B0AFA8;
}

/* 手机号快捷登录 */
.phone-btn {
  height: 140rpx;
  border-radius: 70rpx;
  background: #FFFFFF;
  border: 3rpx solid #1A1A23;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  box-shadow: 0 16rpx 36rpx rgba(26,26,35,0.1);
  padding: 0;
  margin: 0;
  font-size: inherit;
  line-height: inherit;
}
.phone-btn::after {
  border: none;
}
.phone-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 34rpx;
  background: #E5FFC9;
}
.phone-svg {
  width: 36rpx;
  height: 36rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><rect x="7" y="2.5" width="10" height="19" rx="2.5" stroke="%231A1A23" stroke-width="2"/><path d="M10.5 18.5H13.5" stroke="%231A1A23" stroke-width="2" stroke-linecap="round"/></svg>') no-repeat center/contain;
}
.phone-btn-txt {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A23;
}

/* 协议 */
.agree-row {
  align-items: center;
  gap: 16rpx;
}
.agree-box {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  border: 3rpx solid #C9C7BC;
  background: #FFFFFF;
  flex-shrink: 0;
}
.agree-on {
  background: #B9FF66;
  border-color: #1A1A23;
}
.agree-check {
  font-size: 24rpx;
  font-weight: 700;
  color: #1A1A23;
}
.agree-txt {
  font-size: 24rpx;
  color: #6B6B76;
  flex: 1;
}

.login-hint {
  font-size: 22rpx;
  color: #B0AFA8;
  text-align: center;
}

.login-hint2 {
  font-size: 22rpx;
  color: #B0AFA8;
  text-align: center;
}

/* 完善资料弹层 */
.profile-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
}
.profile-card {
  width: 100%;
  background: #FFFFFF;
  border-radius: 48rpx;
  padding: 48rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 24rpx 80rpx rgba(0,0,0,0.2);
}
.profile-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1A1A23;
}
.profile-sub {
  font-size: 24rpx;
  color: #6B6B76;
  margin-top: 8rpx;
  text-align: center;
}

/* 头像 */
.avatar-row {
  margin-top: 40rpx;
  width: 100%;
  align-items: center;
  gap: 24rpx;
}
.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #1A1A23;
  background: #F0EDDF;
  padding: 0;
  margin: 0;
  position: relative;
  overflow: visible;
  flex-shrink: 0;
}
.avatar-btn::after {
  border: none;
}
.avatar-img {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
}
.avatar-plus {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #B9FF66;
  border: 3rpx solid #1A1A23;
  color: #1A1A23;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-hint {
  justify-content: center;
}
.avatar-hint-t {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A23;
}
.avatar-hint-s {
  font-size: 22rpx;
  color: #B0AFA8;
  margin-top: 8rpx;
}

/* 昵称 */
.nick-row {
  margin-top: 40rpx;
  width: 100%;
  height: 96rpx;
  border-radius: 28rpx;
  background: #F0EDDF;
  align-items: center;
  padding: 0 28rpx;
  gap: 20rpx;
}
.nick-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #6B6B76;
  flex-shrink: 0;
}
.nick-input {
  flex: 1;
  font-size: 26rpx;
  color: #1A1A23;
}
.nick-ph {
  color: #B0AFA8;
}

/* 完成按钮 */
.profile-btn {
  margin-top: 48rpx;
  width: 100%;
  height: 104rpx;
  border-radius: 52rpx;
  background: #B9FF66;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A23;
  box-shadow: 0 16rpx 40rpx rgba(185,255,102,0.5);
}
