.page {
  min-height: 100vh;
  background: #F9F4DF;
}

/* ===== 顶部导航（2026-08-19 统一批：返回钮与教练详情页一致，标题同预约页「早上好」44rpx/800） ===== */
.nav-bar {
  display: flex;
  align-items: flex-start;  /* 顶部对齐：与微信胶囊按钮顶边齐平（2026-08-19） */
  padding: 0 24rpx;
  box-sizing: border-box;
}
.nav-back {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(6rpx);
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon-back {
  width: 36rpx; height: 36rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 18" fill="none"><path d="M11 4L6 9L11 14" stroke="%231A1A23" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>') no-repeat center/contain;
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 44rpx;
  font-weight: 800;
  color: #1A1A23;

  line-height: 1;
  margin-top: 8px;  /* 用户拍板：15px 降太多，回调 8px（2026-08-19） */
}
.nav-sp { width: 72rpx; }
.page-pad {
  padding: 24rpx 24rpx 60rpx;
}
.pt-safe {
  padding-top: 0;  /* 状态栏由 nav-bar 内联 style 按 statusBarH 动态补偿，标题与胶囊水平对齐 */
}

/* 等级卡 */
.level-card {
  background: #1A1A23;
  border-radius: 24rpx;
  padding: 32rpx;
}
.lc-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.lc-name {
  font-size: 40rpx;
  font-weight: 800;
  color: #FFFFFF;
}
.lc-lv {
  font-size: 30rpx;
  font-weight: 700;
  color: #B9FF66;
}
.lc-progress-txt {
  display: block;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}
.lc-bar {
  margin-top: 12rpx;
  height: 16rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 8rpx;
  overflow: hidden;
}
.lc-bar-fill {
  height: 100%;
  background: #B9FF66;
  border-radius: 8rpx;
}
.lc-hint {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #B9FF66;
}

/* 等级权益 */
.sec-title {
  margin: 40rpx 0 8rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A23;
}
.sec-sub {
  display: block;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #8A8A93;
}
.levels-row {
  display: flex;
  gap: 12rpx;
}
.level-item {
  position: relative;
  flex: 1;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.level-current {
  border-color: #B9FF66;
}
.level-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.level-roman {
  font-size: 30rpx;
  font-weight: 800;
  color: #FFFFFF;
}
.level-name {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A23;
}
.level-discount {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #1A1A23;
}
.level-min {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: var(--ink-300);
}
.level-tag {
  position: absolute;
  top: -12rpx;
  background: #B9FF66;
  border: 3rpx solid #1A1A23;
  border-radius: 20rpx;
  padding: 2rpx 16rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #1A1A23;
}

.rule-txt {
  display: block;
  margin-top: 24rpx;
  font-size: 20rpx;
  color: var(--ink-300);
}

/* CTA */
.cta {
  margin-top: 48rpx;
  background: #1A1A23;
  border-radius: 44rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cta-txt {
  font-size: 30rpx;
  font-weight: 700;
  color: #B9FF66;
}