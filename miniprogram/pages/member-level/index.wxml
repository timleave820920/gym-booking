<view class="page">
  <view class="page-pad pt-safe">
    <!-- 等级卡 -->
    <view class="level-card" wx:if="{{level}}">
      <view class="lc-top">
        <text class="lc-name">{{level.name}}学员</text>
        <text class="lc-lv">{{level.icon}} Lv.{{level.lv}}</text>
      </view>
      <text class="lc-progress-txt">升级进度 {{level.total}} / {{level.nextMin ? level.nextMin : 'MAX'}} 节课</text>
      <view class="lc-bar">
        <view class="lc-bar-fill" style="width: {{level.progress}}%;"></view>
      </view>
      <text class="lc-hint">{{level.hint}}</text>
    </view>

    <!-- 等级权益 -->
    <view class="sec-title">等级权益</view>
    <view class="levels-row">
      <view class="level-item {{index === currentIdx ? 'level-current' : ''}}" wx:for="{{levels}}" wx:key="name">
        <view class="level-badge" style="background: {{item.color}};">
          <text class="level-roman">{{item.icon}}</text>
        </view>
        <text class="level-name">{{item.name}}</text>
        <text class="level-discount">{{item.discountText}}</text>
        <text class="level-min">{{item.min === 0 ? '0 节课起' : item.min + ' 节课'}}</text>
        <view class="level-tag" wx:if="{{index === currentIdx}}">当前</view>
      </view>
    </view>

    <text class="rule-txt">· 每上 1 节课 = 1 点经验 · 升级后长期有效 · 会员价自动生效</text>

    <!-- 充值 CTA -->
    <view class="cta" bindtap="goRecharge">
      <text class="cta-txt">充值会员  →</text>
    </view>
  </view>
</view>
