.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #F9F4DF;
}
.pt-safe {
  padding-top: calc(88rpx + env(safe-area-inset-top));
}
/* 固定顶部：问候语 + 当前时间 + 周选择条（下滑时保持不动） */
.courses-head {
  flex-shrink: 0;
  background: #F9F4DF;
  z-index: 10;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.04);
}
.greet-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1A1A23;
}
.greet-date {
  font-size: 26rpx;
  color: #6B6B76;
  margin-top: 8rpx;
  display: block;
}

/* 日期选择条 */
.date-bar {
  margin-top: 32rpx;
  gap: 12rpx;
}
.date-item {
  flex: 1;
  height: 128rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  align-items: center;
  justify-content: center;
}
.date-active {
  background: #1A1A23;
}
.date-week {
  font-size: 22rpx; color: #6B6B76;
}
.week-active { color: #B9FF66; }
.date-num {
  font-size: 36rpx; font-weight: 700; color: #1A1A23;
  margin-top: 4rpx;
}
.num-active { color: #FFFFFF; font-weight: 800; }

/* 可滚动列表区（仅课程列表滚动，头部固定） */
.list-scroll {
  flex: 1;
  min-height: 0;
}
.list-pad {
  padding: 0 40rpx 240rpx;   /* 底部留白给自定义 TabBar */
}

/* 课程列表 */
.course-list { margin-top: 32rpx; display: flex; flex-direction: column; gap: 28rpx; }
/* 设计系统 v1.1：统一无描边白卡（去黑描边/紫圆点/粗边头像，视觉重心让位给课程名） */
.course-card {
  position: relative;
  overflow: hidden;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.05);
  display: flex;
  align-items: stretch;
  gap: 24rpx;
}
/* 左上角圆点徽章（方案C） */
.cb-dot {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #5B57EB;
  border: 3rpx solid #1A1A23;
}
.cb-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
/* 顶行：头像 + 课程名 + 会员价徽章 */
.cb-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 18rpx;      /* 标题行（头像+课程名）压场，与内容行分层 */
}
.cb-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--divider);
  flex-shrink: 0;
}
.cb-title {
  flex: 1;
  min-width: 0;
  padding-right: 230rpx;   /* 给右上角火焰让位 */
}
.cb-name {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  color: #1A1A23;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 课程描述：小一号 + 灰色 */
.cb-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-300);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 中行：时间 + 席位（无描边风格下正常块级，不再斜体压场） */
.cb-mid {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
/* 时间：无衬线数字，与卡片风格统一（去斜体/去等宽） */
.cb-time {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
  color: #1A1A23;
}
.cb-seats {
  background: #FCEBEB;      /* 浅红底徽章（无描边，与卡片统一语法） */
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
/* 满员：徽章底转金 */
.cb-seats-full {
  background: #FFF0D6;
}
/* 席位数字（无描边风格：无衬线，与时间统一） */
.cb-seat-num {
  font-size: 28rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 1.3;
  color: var(--danger);               /* 浅红底红字 */
}
.cb-seat-zero {
  color: var(--seat-full);   /* 满员时 20/20 金色 */
}
/* 底行：价格 + 按钮（基线对齐，价格不再抢戏） */
.cb-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  gap: 16rpx;
}
.cb-price {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A23;
  flex-shrink: 0;
  white-space: nowrap;   /* 会员价与真实价同行不换行 */
}
.cb-price-mem {
  font-size: 22rpx;
  color: var(--ink-300);
  font-weight: 400;
}
.cb-stars {
  position: absolute;      /* 难度火焰：右上角，与课程名水平对齐 */
  top: 40rpx;              /* 与课程名中线对齐（头像行 72rpx 垂直居中） */
  right: 24rpx;
  display: flex;
  gap: 2rpx;
  flex-shrink: 0;
}
.cb-dumbbell {
  width: 30rpx;               /* 小哑铃：黑描边线性图标，与课程名/全局 icon 语言一致 */
  height: 30rpx;
  background: url('data:image/svg+xml;base64,') no-repeat center/contain;
}
/* 预约按钮（2026-08-14 图标+文字：纯线性 SVG，同个人中心 icon-* 语言） */
.cb-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--lime);
  color: var(--ink-900);
  font-size: 24rpx; font-weight: 700;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}
.cb-btn .ico {
  width: 32rpx;
  height: 32rpx;
}
/* 已预订：深色底 */
.btn-booked {
  background: var(--ink);
  color: #FFFFFF;
}
/* 已排位 / 候补排位：紫色 */
.btn-waitlist {
  background: var(--accent);
  color: #FFFFFF;
}
/* 满员：置灰 */
.btn-full {
  background: var(--divider);
  color: var(--ink-300);
}
/* 进行中（红）/ 已结束（灰） */
.btn-ongoing {
  background: var(--danger);
  color: #FFFFFF;
}
.btn-ended {
  background: var(--divider);
  color: var(--ink-300);
}
/* 不可约状态：整卡弱化 */
.card-full {
  opacity: 0.75;
}
/* 剩余席位 <5：右上角"紧张"斜条 */
.ribbon {
  position: absolute;
  top: 16rpx;
  right: -58rpx;
  transform: rotate(45deg);
  background: #E5484D;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  padding: 5rpx 70rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(229,72,77,0.3);
}
/* 满员：与「紧张」同款斜条带（2026-08-14 用户要求形状统一）；橙=满员警示色（非红，区分紧张） */
.ribbon-full {
  position: absolute;
  top: 16rpx;
  right: -58rpx;
  transform: rotate(45deg);
  background: var(--seat-full);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  padding: 5rpx 70rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(239,159,39,0.3);
}

/* 空状态 */.offline-tip {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #B0AFA8;
  padding: 16rpx 0 0;
}
.loading-tip {
  text-align: center;
  font-size: 26rpx;
  color: #B0AFA8;
  padding: 80rpx 0;
}

/* ===== 骨架屏（首屏秒开优化 2026-08-14） ===== */
.sk-list {
  padding: 0 0 8rpx;
}
.sk-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  animation: sk-breathe 1.2s ease-in-out infinite;
}
.sk-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.sk-row:last-child {
  margin-bottom: 0;
}
.sk-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #EFEDE6;
  flex-shrink: 0;
}
.sk-lines {
  flex: 1;
  margin-left: 18rpx;
}
.sk-line {
  height: 24rpx;
  border-radius: 8rpx;
  background: #EFEDE6;
  margin-bottom: 14rpx;
}
.sk-line:last-child {
  margin-bottom: 0;
}
.sk-chip {
  width: 120rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: #EFEDE6;
}
.sk-btn {
  width: 140rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #EFEDE6;
}
.w60 { width: 60%; }
.w40 { width: 40%; }
.w30 { width: 30%; }
.w15 { width: 15%; }
@keyframes sk-breathe {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}

