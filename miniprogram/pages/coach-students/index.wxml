<view class="page">
  <view class="page-pad">
    <!-- 课程信息 -->
    <view class="course-bar flex-row">
      <view class="flex-col flex-1">
        <text class="course-name">{{course.name}}</text>
        <text class="course-meta">{{course.time}} · {{course.venue}}</text>
      </view>
      <view class="count-badge">已签到 {{checked}}/{{total}}</view>
    </view>

    <!-- 统计行 -->
    <view class="stats-row flex-row">
      <view class="stat-item flex-col">
        <text class="stat-value text-green">{{checked}}</text>
        <text class="stat-label">已签到</text>
      </view>
      <view class="stat-item flex-col">
        <text class="stat-value text-orange">{{unchecked}}</text>
        <text class="stat-label">未签到</text>
      </view>
      <view class="stat-item flex-col">
        <text class="stat-value">{{total}}</text>
        <text class="stat-label">总报名</text>
      </view>
    </view>

    <!-- 学员列表 -->
    <view class="student-list">
      <view class="student-row flex-row" wx:for="{{students}}" wx:key="id"
            data-id="{{item.id}}" bindtap="toggleCheck">
        <image class="stu-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
        <view class="flex-col flex-1">
          <text class="stu-name">{{item.name}}</text>
          <text class="stu-meta">{{item.meta}}</text>
        </view>
        <view class="tag {{item.checked ? 'tag-green' : 'tag-orange'}}">
          {{item.checked ? '已签到' : '未签到'}}
        </view>
      </view>
    </view>

    <view class="scan-btn" bindtap="goScan">扫码签到</view>
  </view>
</view>
