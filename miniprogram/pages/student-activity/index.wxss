.page {
  min-height: 100vh;
  background: #F9F4DF;
  padding-bottom: 220rpx;
}
.pt-safe {
  padding-top: calc(88rpx + env(safe-area-inset-top));
}

.greet-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1A1A23;
}
.greet-date {
  font-size: 26rpx;
  color: #6B6B76;
  margin-top: 8rpx;
  display: block;
}

/* Banner */
.banner {
  position: relative;
  margin-top: 32rpx;
  height: 300rpx;
  border-radius: 40rpx;
  overflow: hidden;
  background: linear-gradient(120deg, #FF6B35 0%, #FFCB47 100%);
}
.banner-tag {
  position: absolute; top: 36rpx; left: 0;   /* 与页面正文左对齐 */
  color: #FFFFFF; font-size: 24rpx; font-weight: 700;
  letter-spacing: 4rpx;
}
.banner-title {
  position: absolute; top: 88rpx; left: 0;   /* 与页面正文左对齐 */
  color: #1A1A23; font-size: 60rpx; font-weight: 900;
}
.banner-sub {
  position: absolute; top: 164rpx; left: 0;   /* 与页面正文左对齐 */
  color: #FFFFFF; font-size: 26rpx;
}
.banner-btn {
  position: absolute; top: 216rpx; left: 0;   /* 与页面正文左对齐 */
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #1A1A23; color: #FFFFFF;
  font-size: 24rpx; font-weight: 600;
  padding: 12rpx 24rpx; border-radius: 30rpx;
}
.banner-btn .ico {
  width: 30rpx;
  height: 30rpx;
}
.banner-img {
  position: absolute; right: 0; top: 0;
  width: 300rpx; height: 300rpx;
}
.banner-deco {
  position: absolute; right: 80rpx; top: -40rpx;
  width: 180rpx; height: 180rpx; border-radius: 50%;
  background: linear-gradient(120deg, #B9FF66 0%, rgba(91,87,235,0.8) 100%);
}

/* 热门课程 */
.hot-head { margin-top: 40rpx; }
.section-title {
  font-size: 36rpx; font-weight: 700; color: #1A1A23;
}
.more { align-items: center; }
.more-txt { color: #6B6B76; font-size: 26rpx; margin-right: 4rpx; }
.icon-chevron {
  width: 28rpx; height: 28rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M9 6L15 12L9 18" stroke="%236B6B76" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>') no-repeat center/contain;
}

.hot-list { margin-top: 24rpx; display: flex; flex-direction: column; gap: 28rpx; }
/* 版本B：仪表盘数据卡片（与本周页一致） */
.course-card {
  position: relative;
  overflow: hidden;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.05);
  display: flex;
  align-items: stretch;
  gap: 24rpx;
}
/* 左上角圆点徽章（方案C） */
.cb-dot {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #5B57EB;
  border: 3rpx solid #1A1A23;
}
.cb-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
/* 顶行：头像 + 课程名 + 会员价徽章 */
.cb-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 18rpx;      /* 标题行（头像+课程名）压场，与内容行分层 */
}
.cb-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 5rpx solid #1A1A23;
  background: #F0EDDF;
  flex-shrink: 0;
}
.cb-title {
  flex: 1;
  min-width: 0;
  padding-right: 230rpx;   /* 给右上角火焰让位 */
}
.cb-name {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  color: #1A1A23;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 课程描述：小一号 + 灰色 */
.cb-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-300);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 中行：大数字时间 + 剩余席位读数 */
.cb-mid {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 16rpx;
}
/* 科技运动感数字字体栈：Windows=Bahnschrift/DIN，手机回退等宽 */
.cb-time {
  font-family: "Bahnschrift", "DIN Alternate", "Roboto Mono", "SF Mono", "Menlo", monospace;
  font-size: 40rpx;
  font-weight: 700;
  font-style: italic;                 /* 斜体提速感 */
  letter-spacing: 2rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1;
  color: #1A1A23;
}
.cb-seats {
  background: #FFFFFF;          /* 白底红边胶囊（方案B） */
  border: 3rpx solid #E5484D;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  text-align: center;
  flex-shrink: 0;
}
/* 满员：胶囊描边转金 */
.cb-seats-full {
  border-color: var(--seat-full);
}
/* 纯数字席位（如 4/20） */
.cb-seat-num {
  font-family: "Bahnschrift", "DIN Alternate", "Roboto Mono", "SF Mono", "Menlo", monospace;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1;
  color: #E5484D;               /* 白底红字 */
}
.cb-seat-zero {
  color: var(--seat-full);   /* 满员时 20/20 金色 */
}
/* 底行：价格 + 难度点阵 + 按钮 */
.cb-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  gap: 16rpx;
}
.cb-price {
  font-family: "Bahnschrift", "DIN Alternate", "Roboto Mono", "SF Mono", "Menlo", monospace;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  color: #1A1A23;
  flex-shrink: 0;
  white-space: nowrap;   /* 会员价与真实价同行不换行 */
}
.cb-price-mem {
  font-size: 22rpx;
  color: #B0AFA8;
  font-weight: 400;
}
.cb-stars {
  position: absolute;      /* 难度火焰：右上角，与课程名水平对齐 */
  top: 52rpx;              /* 与课程名中线对齐（头像行 96rpx 垂直居中） */
  right: 24rpx;
  display: flex;
  gap: 2rpx;
  flex-shrink: 0;
}
.cb-star {
  font-size: 40rpx;          /* 与课程名字号一致，emoji 自带配色 */
  line-height: 1;
}
/* 预约按钮（2026-08-14 图标+文字：纯线性 SVG，同个人中心 icon-* 语言） */
.cb-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #B9FF66;
  color: #1A1A23;
  font-size: 24rpx; font-weight: 700;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  border: 3rpx solid #1A1A23;
  flex-shrink: 0;
}
.cb-btn .ico {
  width: 32rpx;
  height: 32rpx;
}
/* 已预订：深色底 */
.btn-booked {
  background: #1A1A23;
  color: #B9FF66;
}
/* 已排位 / 候补排位：紫色 */
.btn-waitlist {
  background: #5B57EB;
  color: #FFFFFF;
  border-color: #5B57EB;
}
/* 满员：置灰 */
.btn-full {
  background: var(--divider);
  color: #B0AFA8;
  border-color: var(--divider-strong);
}
/* 进行中（红）/ 已结束（灰） */
.btn-ongoing {
  background: #E5484D;
  color: #FFFFFF;
  border-color: #E5484D;
}
.btn-ended {
  background: var(--divider);
  color: var(--ink-300);
  border-color: var(--divider-strong);
}
/* 不可约状态：整卡弱化 */
.card-off {
  opacity: 0.72;
}
/* 剩余席位 <5：右上角"紧张"斜条 */
.ribbon {
  position: absolute;
  top: 16rpx;
  right: -58rpx;
  transform: rotate(45deg);
  background: #E5484D;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  padding: 5rpx 70rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(229,72,77,0.3);
}
/* 满员：旋转方块覆盖右上角（深金底 + 深色文字），面积较满铺版小40%（与预约页一致） */
.ribbon-full {
  position: absolute;
  top: -92rpx;
  right: -92rpx;
  width: 184rpx;
  height: 184rpx;
  transform: rotate(45deg);
  background: var(--coin-gold-deep);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 0 20rpx 0;      /* 覆盖 .ribbon 的 6rpx 90rpx，避免文字被挤 */
  box-sizing: border-box;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #4A3200;
  box-shadow: none;
}
.offline-tip {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #B0AFA8;
  padding: 16rpx 0 0;
}
/* 今日无课空状态 */
.empty-today {
  align-items: center;
  padding: 80rpx 0;
}
.empty-today .empty-icon {
  font-size: 72rpx;
  color: var(--ink-300);
}
.empty-today .empty-txt {
  margin-top: 16rpx;
  color: #B0AFA8;
  font-size: 26rpx;
}

.list-spacer { height: 60rpx; }

/* ===== 功能入口（7 项，2026-08-14）===== */
.entry-grid {
  margin-top: 28rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.entry-item {
  width: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 0 20rpx;
  background: var(--ink-0);
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
}
.entry-ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background-color: #F0EDDF;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 40rpx;
}
.entry-name {
  font-size: 24rpx;
  color: var(--ink-900);
  font-weight: 500;
}
/* 图标（24 网格 · 2~2.5px 描边 · 圆头端点 · 墨黑，同个人中心 icon-* 语言） */
