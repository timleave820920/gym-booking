.page {
  min-height: 100vh;
  background: #1A1A23;
}
.scan-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}
.scan-tip {
  color: #FFFFFF;
  opacity: 0.7;
  font-size: 28rpx;
}

/* 扫描框 */
.scan-frame {
  position: relative;
  margin-top: 40rpx;
  width: 560rpx;
  height: 560rpx;
  border-radius: 48rpx;
  background: rgba(255,255,255,0.04);
}
.corner {
  position: absolute;
  width: 80rpx; height: 80rpx;
}
.corner-tl {
  left: -6rpx; top: -6rpx;
  border-left: 12rpx solid #B9FF66;
  border-top: 12rpx solid #B9FF66;
  border-top-left-radius: 24rpx;
}
.corner-tr {
  right: -6rpx; top: -6rpx;
  border-right: 12rpx solid #B9FF66;
  border-top: 12rpx solid #B9FF66;
  border-top-right-radius: 24rpx;
}
.corner-bl {
  left: -6rpx; bottom: -6rpx;
  border-left: 12rpx solid #B9FF66;
  border-bottom: 12rpx solid #B9FF66;
  border-bottom-left-radius: 24rpx;
}
.corner-br {
  right: -6rpx; bottom: -6rpx;
  border-right: 12rpx solid #B9FF66;
  border-bottom: 12rpx solid #B9FF66;
  border-bottom-right-radius: 24rpx;
}
.scan-line {
  position: absolute;
  left: 40rpx; right: 40rpx;
  top: 120rpx;
  height: 6rpx;
  background: #B9FF66;
  border-radius: 3rpx;
  box-shadow: 0 0 16rpx rgba(185,255,102,0.8);
  animation: scan 2.4s ease-in-out infinite;
}
@keyframes scan {
  0% { top: 120rpx; opacity: 1; }
  50% { top: 430rpx; opacity: 0.7; }
  100% { top: 120rpx; opacity: 1; }
}

/* 课程信息 */
.course-info {
  margin-top: 48rpx;
  width: 100%;
  background: #2A2A33;
  border-radius: 28rpx;
  padding: 24rpx;
  align-items: center;
}
.icon-clock {
  width: 36rpx; height: 36rpx;
  margin-right: 16rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="%23FFFFFF" stroke-width="2"/><path d="M12 7V12L15 14" stroke="%23FFFFFF" stroke-width="2" stroke-linecap="round"/></svg>') no-repeat center/contain;
}
.course-txt {
  color: #FFFFFF;
  font-size: 26rpx;
  flex: 1;
}

/* 操作按钮 */
.action-row {
  margin-top: 40rpx;
  width: 100%;
  gap: 24rpx;
}
.action-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}
.action-btn.outline {
  background: #2A2A33;
  border: 2rpx solid rgba(255,255,255,0.2);
  color: #FFFFFF;
}
.action-btn.lime {
  background: #B9FF66;
  color: #1A1A23;
  font-weight: 700;
}
