<view class="page">
  <view class="page-pad pt-safe">
    <view class="head-row">
      <text class="page-title">个人中心</text>
    </view>

    <!-- 会员卡预览（点击进会员等级页；能量币行 catchtap 防冒泡——BUG-LEDGER #11 修复） -->
    <view class="vip-preview" bindtap="goMemberLevel">
      <view class="vip-top">
        <text class="vip-name">我的会员</text>
        <view class="vip-lv" wx:if="{{member}}">
          <text class="vip-lv-txt">{{member.icon}} Lv.{{member.lv}}</text>
        </view>
      </view>
      <view class="vip-mid" wx:if="{{member}}">
        <view class="vip-bal">
          <text class="vip-bal-label">储值余额</text>
          <text class="vip-bal-value">¥ {{member.balance}}</text>
        </view>
        <view class="vip-btn" catchtap="goRecharge">去充值</view>
      </view>
      <view class="vip-hint" wx:if="{{member}}">{{member.hint}}</view>
      <view class="vip-loading" wx:else>加载中...</view>
      <!-- 能量币行 -->
      <view class="vip-coins" wx:if="{{member}}" catchtap="goCoinShop">
        <text class="vip-coins-label">⚡ 能量币</text>
        <text class="vip-coins-value">{{coinBalance}}</text>
        <text class="vip-coins-go">去商店 →</text>
      </view>
      <!-- 次数包（次卡）行：显示剩余次数 / 过期天数 -->
      <view class="vip-pass" wx:if="{{passInfo.hasPass}}" catchtap="goPass">
        <view class="vip-pass-left">
          <text class="vip-pass-label">次数包</text>
          <text class="vip-pass-num">{{passInfo.remaining}}<text class="vip-pass-total"> / {{passInfo.total}} 次</text></text>
        </view>
        <view class="vip-pass-right">
          <text class="vip-pass-days" wx:if="{{!passInfo.expired}}">剩余 {{passInfo.daysLeft}} 天</text>
          <text class="vip-pass-days vip-pass-days-expired" wx:else>已过期</text>
          <text class="vip-pass-go">详情 →</text>
        </view>
      </view>
      <!-- 无次数包：引导查看 -->
      <view class="vip-pass vip-pass-empty" wx:elif="{{member}}" catchtap="goPass">
        <view class="vip-pass-left">
          <text class="vip-pass-label">次数包</text>
          <text class="vip-pass-num">尚未购买</text>
        </view>
        <view class="vip-pass-right">
          <text class="vip-pass-go">去了解 →</text>
        </view>
      </view>
    </view>

    <!-- 菜单组 -->
    <view class="menu-group" wx:for="{{menus}}" wx:key="index" wx:for-item="group">
      <view class="menu-row flex-row" wx:for="{{group}}" wx:key="name"
            data-url="{{item.url}}" bindtap="goMenu">
        <view class="menu-icon {{'icon-' + item.icon}}"></view>
        <text class="menu-name">{{item.name}}</text>
        <view class="menu-badge" wx:if="{{item.badge > 0}}">{{item.badge > 99 ? '99+' : item.badge}}</view>
        <text class="icon-chevron-sm"></text>
      </view>
    </view>

    <!-- 退出登录 -->
    <view class="logout-btn" bindtap="logout">
      <text>退出登录</text>
    </view>

    <view class="list-spacer"></view>
  </view>
</view>
