.page {
  min-height: 100vh;
  background: #F9F4DF;
}
.pt-safe {
  padding-top: calc(88rpx + env(safe-area-inset-top));
}
.head-row { align-items: center; }
.back-wrap { align-items: center; gap: 12rpx; }
.icon-back {
  width: 32rpx; height: 32rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M15 5L8 12L15 19" stroke="%231A1A23" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>') no-repeat center/contain;
}
.page-title {
  font-size: 48rpx; font-weight: 800; color: #1A1A23;
}

/* 规则列表 */
.rule-list {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.rule-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.05);
}
.rule-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: #F1EFE8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
}
.rule-info {
  flex: 1;
  min-width: 0;
}
.rule-name {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #1A1A23;
}
.rule-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8A8A8A;
}
.rule-reward {
  font-size: 34rpx;
  font-weight: 800;
  color: #5B57EB;
  flex-shrink: 0;
}

/* 每日上限提示 */
.limit-tip {
  margin-top: 32rpx;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}
.limit-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #F8D044;
}
.limit-txt {
  font-size: 24rpx;
  color: #6B6B76;
}

/* 底部按钮 */
.btn-done {
  margin-top: 48rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #1A1A23;
  color: #B9FF66;
  font-size: 32rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}
.list-spacer { height: 60rpx; }
