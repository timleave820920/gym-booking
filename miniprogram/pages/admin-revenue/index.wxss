.admin-page { min-height: 100vh; background: #F9F4DF; }
.admin-top {
  background: #1A1A23;
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-top));
  align-items: center;
}
.admin-brand { align-items: center; }
.brand-logo {
  width: 64rpx; height: 64rpx;
  border-radius: 20rpx;
  background: #B9FF66;
  margin-right: 20rpx;
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" fill="none"><path d="M8.5 8.5V23.5M5 11.5V20.5M23.5 8.5V23.5M27 11.5V20.5M8.5 16H23.5" stroke="%231A1A23" stroke-width="2.4" stroke-linecap="round"/></svg>');
  background-repeat: no-repeat;
  background-position: center;
  background-size: 40rpx;
}
.brand-name { color: #FFFFFF; font-size: 32rpx; font-weight: 800; }
.admin-user { align-items: center; }
.admin-avatar {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  background: #5B57EB;
  margin-right: 16rpx;
}
.admin-name { color: #FFFFFF; font-size: 26rpx; font-weight: 600; }

.admin-content { padding: 32rpx 40rpx; }
.page-title { font-size: 40rpx; font-weight: 700; color: #1A1A23; }
.seg-mini {
  background: #F0EDDF;
  border-radius: 30rpx;
  padding: 4rpx;
  display: flex;
}
.mini-item {
  padding: 8rpx 24rpx;
  border-radius: 26rpx;
  font-size: 24rpx;
  color: #6B6B76;
}
.mini-on {
  background: #1A1A23;
  color: #FFFFFF;
  font-weight: 600;
}

/* 统计卡 */
.stats-grid {
  margin-top: 32rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}
.stat-card {
  width: calc(50% - 12rpx);
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.05);
}
.stat-dark {
  background: #1A1A23;
}
.stat-label {
  font-size: 26rpx; color: #6B6B76;
}
.label-white { color: #B0AFA8; }
.stat-value {
  font-size: 56rpx; font-weight: 800; color: #1A1A23;
  margin-top: 8rpx;
}
.stat-trend {
  font-size: 24rpx; font-weight: 600;
  margin-top: 8rpx;
}

/* 面板 */
.panel {
  margin-top: 32rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.05);
}
.panel-title {
  font-size: 32rpx; font-weight: 700; color: #1A1A23;
}

/* 柱状图 */
.bar-chart {
  margin-top: 32rpx;
  height: 380rpx;
  align-items: flex-end;
  gap: 16rpx;
}
.bar-col {
  flex: 1;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}
.bar-fill {
  width: 100%;
  max-width: 56rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
}
.bar-soft { background: #DCD8FF; }
.bar-purple { background: #5B57EB; }
.bar-lime { background: #B9FF66; }
.bar-month {
  margin-top: 12rpx;
  font-size: 22rpx; color: #6B6B76;
}

/* 环形图 */
.source-body {
  margin-top: 32rpx;
  align-items: center;
}
.donut {
  width: 280rpx; height: 280rpx;
  border-radius: 50%;
  background: conic-gradient(#5B57EB 0 55%, #B9FF66 55% 83%, var(--coin-gold) 83% 94%, #F8B7B8 94% 100%);
  position: relative;
  flex-shrink: 0;
}
.donut::after {
  content: '';
  position: absolute;
  top: 56rpx; left: 56rpx;
  width: 168rpx; height: 168rpx;
  border-radius: 50%;
  background: #FFFFFF;
}
.legend {
  margin-left: 40rpx;
  gap: 24rpx;
}
.legend-row {
  align-items: center;
}
.legend-dot {
  width: 24rpx; height: 24rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}
.legend-name {
  flex: 1;
  font-size: 26rpx; color: #1A1A23;
}
.legend-pct {
  font-size: 26rpx; font-weight: 700; color: #1A1A23;
}

.bottom-space { height: 80rpx; }

/* 退出按钮 */
.admin-exit {
  margin-left: 20rpx;
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
  background: #B9FF66;
  color: #1A1A23;
  font-size: 22rpx;
  font-weight: 600;
}

/* 后台横向导航条 */
.admin-nav {
  background: #1A1A23;
  white-space: nowrap;
  width: 100%;
}
.nav-inner {
  display: flex;
  padding: 16rpx 24rpx 24rpx;
  gap: 12rpx;
}
.nav-item {
  flex-shrink: 0;
  padding: 14rpx 32rpx;
  border-radius: 36rpx;
  background: rgba(255,255,255,0.08);
  color: #B0AFA8;
  font-size: 26rpx;
}
.nav-active {
  background: #B9FF66;
  color: #1A1A23;
  font-weight: 700;
}
