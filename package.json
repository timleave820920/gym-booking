{
  "name": "gym-server",
  "version": "1.0.0",
  "private": true,
  "description": "综合训练馆订课系统 - 后端（Node 原生 http + SQLite/MySQL 双驱动，DESIGN #D2）",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/seed.js",
    "smoke": "node minitest/smoke.js",
    "test": "node minitest/run-tests.js",
    "test:clean": "node -e \"process.env.DB_PATH=':memory:';require('child_process').execSync('node minitest/run-tests.js',{stdio:'inherit'})\""
  },
  "dependencies": {
    "mysql2": "^3.11.0",
    "cos-nodejs-sdk-v5": "^2.14.9"
  },
  "engines": {
    "node": ">=22.5"
  }
}
