.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #F9F4DF;
}
.pt-safe {
  padding-top: calc(88rpx + env(safe-area-inset-top));
}
/* 固定顶部：问候语 + 当前时间 + 周选择条（下滑时保持不动） */
.courses-head {
  flex-shrink: 0;
  background: #F9F4DF;
  z-index: 10;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.04);
}
.greet-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1A1A23;
}
.greet-date {
  font-size: 26rpx;
  color: #6B6B76;
  margin-top: 8rpx;
  display: block;
}
.bell-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
}
.icon-bell {
  width: 40rpx; height: 40rpx;
  border-radius: 12rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M6 8C6 4.69 8.69 2 12 2C15.31 2 18 4.69 18 8V11C18 14.5 19.5 16 19.5 16H4.5C4.5 16 6 14.5 6 11V8Z" stroke="%231A1A23" stroke-width="2"/><path d="M10.3 20C10.73 20.61 11.31 21 12 21C12.69 21 13.27 20.61 13.7 20" stroke="%231A1A23" stroke-width="2" stroke-linecap="round"/></svg>') no-repeat center/contain;
}

/* 日期选择条 */
.date-bar {
  margin-top: 32rpx;
  gap: 12rpx;
}
.date-item {
  flex: 1;
  height: 128rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  align-items: center;
  justify-content: center;
}
.date-active {
  background: #1A1A23;
}
.date-week {
  font-size: 22rpx; color: #6B6B76;
}
.week-active { color: #B9FF66; }
.date-num {
  font-size: 36rpx; font-weight: 700; color: #1A1A23;
  margin-top: 4rpx;
}
.num-active { color: #FFFFFF; font-weight: 800; }

/* 可滚动列表区（仅课程列表滚动，头部固定） */
.list-scroll {
  flex: 1;
  min-height: 0;
}
.list-pad {
  padding: 0 40rpx 240rpx;   /* 底部留白给自定义 TabBar */
}

/* 课程列表 */
.course-list { margin-top: 32rpx; display: flex; flex-direction: column; gap: 28rpx; }
/* 版本B：仪表盘数据卡片 */
.course-card {
  position: relative;
  overflow: hidden;
  background: #FFFFFF;
  border: 3rpx solid #1A1A23;      /* 整条细边框 */
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.05);
  display: flex;
  align-items: stretch;
  gap: 24rpx;
}
/* 左上角圆点徽章（方案C） */
.cb-dot {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #5B57EB;
  border: 3rpx solid #1A1A23;
}
.cb-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
/* 顶行：头像 + 课程名 + 会员价徽章 */
.cb-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 18rpx;      /* 标题行（头像+课程名）压场，与内容行分层 */
}
.cb-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 5rpx solid #1A1A23;
  background: #F0EDDF;
  flex-shrink: 0;
}
.cb-title {
  flex: 1;
  min-width: 0;
  padding-right: 230rpx;   /* 给右上角火焰让位 */
}
.cb-name {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  color: #1A1A23;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 课程描述：小一号 + 灰色 */
.cb-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8A8A8A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 中行：大数字时间 + 剩余席位读数 */
.cb-mid {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 16rpx;
}
/* 科技运动感数字字体栈：Windows=Bahnschrift/DIN，手机回退等宽 */
.cb-time {
  font-family: "Bahnschrift", "DIN Alternate", "Roboto Mono", "SF Mono", "Menlo", monospace;
  font-size: 40rpx;
  font-weight: 700;
  font-style: italic;                 /* 斜体提速感 */
  letter-spacing: 2rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1;
  color: #1A1A23;
}
.cb-seats {
  background: #FFFFFF;          /* 白底红边胶囊（方案B） */
  border: 3rpx solid #E5484D;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  text-align: center;
  flex-shrink: 0;
}
/* 满员：胶囊描边转金 */
.cb-seats-full {
  border-color: #EF9F27;
}
/* 纯数字席位（如 4/20） */
.cb-seat-num {
  font-family: "Bahnschrift", "DIN Alternate", "Roboto Mono", "SF Mono", "Menlo", monospace;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1;
  color: #E5484D;               /* 白底红字 */
}
.cb-seat-zero {
  color: #EF9F27;   /* 满员时 20/20 金色 */
}
/* 底行：价格 + 难度点阵 + 按钮 */
.cb-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  gap: 16rpx;
}
.cb-price {
  font-family: "Bahnschrift", "DIN Alternate", "Roboto Mono", "SF Mono", "Menlo", monospace;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  color: #1A1A23;
  flex-shrink: 0;
  white-space: nowrap;   /* 会员价与真实价同行不换行 */
}
.cb-price-mem {
  font-size: 22rpx;
  color: #B0AFA8;
  font-weight: 400;
}
.cb-stars {
  position: absolute;      /* 难度火焰：右上角，与课程名水平对齐 */
  top: 52rpx;              /* 与课程名中线对齐（头像行 96rpx 垂直居中） */
  right: 24rpx;
  display: flex;
  gap: 2rpx;
  flex-shrink: 0;
}
.cb-star {
  font-size: 40rpx;          /* 与课程名字号一致，emoji 自带配色 */
  line-height: 1;
}
/* 预约按钮 */
.cb-btn {
  background: #B9FF66;
  color: #1A1A23;
  font-size: 26rpx; font-weight: 800;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  border: 3rpx solid #1A1A23;
  flex-shrink: 0;
}
/* 已预订：深色底 */
.btn-booked {
  background: #1A1A23;
  color: #B9FF66;
}
/* 已排位 / 候补排位：紫色 */
.btn-waitlist {
  background: #5B57EB;
  color: #FFFFFF;
  border-color: #5B57EB;
}
/* 满员：置灰 */
.btn-full {
  background: #E5E2D4;
  color: #B0AFA8;
  border-color: #E0DCCB;
}
/* 进行中（红）/ 已结束（灰） */
.btn-ongoing {
  background: #E5484D;
  color: #FFFFFF;
  border-color: #E5484D;
}
.btn-ended {
  background: #E0DCCB;
  color: #8A8A8A;
  border-color: #D9D4C0;
}
/* 不可约状态：整卡弱化 */
.card-full {
  opacity: 0.75;
}
/* 剩余席位 <5：右上角"紧张"斜条 */
.ribbon {
  position: absolute;
  top: 16rpx;
  right: -58rpx;
  transform: rotate(45deg);
  background: #E5484D;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  padding: 5rpx 70rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(229,72,77,0.3);
}
/* 满员：旋转方块覆盖右上角（深金底 + 深色文字），面积较满铺版小40% */
.ribbon-full {
  position: absolute;
  top: -92rpx;
  right: -92rpx;
  width: 184rpx;
  height: 184rpx;
  transform: rotate(45deg);
  background: #BA7517;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 0 20rpx 0;      /* 覆盖 .ribbon 的 6rpx 90rpx，避免文字被挤 */
  box-sizing: border-box;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #4A3200;
  box-shadow: none;
}

/* 空状态 */
.empty-state {
  align-items: center;
  padding: 120rpx 0;
}
.offline-tip {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #B0AFA8;
  padding: 16rpx 0 0;
}
.loading-tip {
  text-align: center;
  font-size: 26rpx;
  color: #B0AFA8;
  padding: 80rpx 0;
}
.empty-icon {
  font-size: 96rpx; color: #D9D4C0;
}
.empty-txt {
  margin-top: 24rpx; color: #6B6B76; font-size: 30rpx;
}
.empty-sub {
  margin-top: 8rpx; color: #B0AFA8; font-size: 24rpx;
}

.list-spacer { height: 60rpx; }
