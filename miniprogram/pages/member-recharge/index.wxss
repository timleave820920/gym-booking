.page {
  min-height: 100vh;
  background: #F9F4DF;
}

/* ===== 顶部导航（2026-08-19 统一批：返回钮与教练详情页一致，标题同预约页「早上好」44rpx/800） ===== */
.nav-bar {
  display: flex;
  align-items: flex-start;  /* 顶部对齐：与微信胶囊按钮顶边齐平（2026-08-19） */
  padding: 0 24rpx;
  box-sizing: border-box;
}
.nav-back {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(6rpx);
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon-back {
  width: 36rpx; height: 36rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 18" fill="none"><path d="M11 4L6 9L11 14" stroke="%231A1A23" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>') no-repeat center/contain;
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 44rpx;
  font-weight: 800;
  color: #1A1A23;

  line-height: 1;
  margin-top: 8px;  /* 用户拍板：15px 降太多，回调 8px（2026-08-19） */
}
.nav-sp { width: 72rpx; }
.page-pad {
  padding: 24rpx 24rpx 60rpx;
}
.pt-safe {
  padding-top: 0;  /* 状态栏由 nav-bar 内联 style 按 statusBarH 动态补偿，标题与胶囊水平对齐 */
}

/* 余额卡 */
.bal-card {
  background: #1A1A23;
  border-radius: 24rpx;
  padding: 32rpx;
}
.bal-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
}
.bal-value {
  display: block;
  margin-top: 8rpx;
  font-size: 56rpx;
  font-weight: 800;
  color: #B9FF66;
}
.bal-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}

/* 套餐 */
.sec-title {
  margin: 40rpx 0 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A23;
}
.plans {
  display: flex;
  gap: 16rpx;
}
.plan {
  position: relative;
  flex: 1;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.plan-active {
  background: #1A1A23;
}
.plan-amount {
  font-size: 32rpx;
  font-weight: 800;
  color: #1A1A23;
}
.plan-amount-active {
  color: #FFFFFF;
}
.plan-bonus {
  font-size: 28rpx;
  font-weight: 700;
  color: #E5484D;
}
.plan-bonus-active {
  color: #B9FF66;
}
.plan-total {
  background: #F0EDDF;
  border-radius: 24rpx;
  padding: 4rpx 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #6B6B76;
}
.plan-total-active {
  background: rgba(255,255,255,0.15);
  color: #FFFFFF;
}
.plan-tag {
  position: absolute;
  top: -14rpx;
  background: #B9FF66;
  border: 3rpx solid #1A1A23;
  border-radius: 20rpx;
  padding: 2rpx 16rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #1A1A23;
}

/* 充值按钮 */
.pay-btn {
  margin-top: 40rpx;
  background: #1A1A23;
  border-radius: 44rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pay-btn-txt {
  font-size: 30rpx;
  font-weight: 700;
  color: #B9FF66;
}
/* B2：微信支付未开通 → 按钮置灰 + 提示 */
.pay-btn-off {
  background: var(--divider-strong);
}
.pay-btn-off .pay-btn-txt {
  color: var(--ink-300);
}
.pay-off-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--ink-300);
  text-align: center;
}

/* 记录 */
.rec-item {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.rec-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #1A1A23;
}
.rec-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--ink-300);
}
.rec-total {
  font-size: 30rpx;
  font-weight: 800;
  color: #3D9970;
}
.rec-empty {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #B0AFA8;
}

/* 套餐副标题 */
.sec-sub {
  margin: -10rpx 0 20rpx;
  font-size: 22rpx;
  color: #6B6B76;
}

/* 套餐标签：首充高赠（荧光绿）/ 已充过（灰色） */
.tag-first {
  background: #B9FF66;
  border: 3rpx solid #1A1A23;
  color: #1A1A23;
}
.tag-repeat {
  background: #F0EDDF;
  border: 3rpx solid var(--line-warm);
  color: var(--ink-300);
}

/* 分页提示条 */
.rec-more {
  text-align: center;
  padding: 24rpx 0 8rpx;
  font-size: 22rpx;
  color: #B0AFA8;
}