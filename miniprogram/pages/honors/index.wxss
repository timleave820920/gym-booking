.page {
  min-height: 100vh;
  background: #F9F4DF;
}

/* ===== 顶部导航（2026-08-19 统一批：返回钮与教练详情页一致，标题同预约页「早上好」44rpx/800） ===== */
.nav-bar {
  display: flex;
  align-items: flex-start;  /* 顶部对齐：与微信胶囊按钮顶边齐平（2026-08-19） */
  padding: 0 24rpx;
  box-sizing: border-box;
}
.nav-back {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(6rpx);
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon-back {
  width: 36rpx; height: 36rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 18" fill="none"><path d="M11 4L6 9L11 14" stroke="%231A1A23" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>') no-repeat center/contain;
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 44rpx;
  font-weight: 800;
  color: #1A1A23;

  line-height: 1;
  margin-top: 8px;  /* 用户拍板：15px 降太多，回调 8px（2026-08-19） */
}
.nav-sp { width: 72rpx; }
.page-pad {
  padding: 24rpx 24rpx 60rpx;
}
.pt-safe {
  padding-top: 0;  /* 状态栏由 nav-bar 内联 style 按 statusBarH 动态补偿，标题与胶囊水平对齐 */
}

/* 荣誉主卡 */
.honor-hero {
  background: #1A1A23;
  border-radius: 24rpx;
  padding: 32rpx;
}
.hh-title {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  color: #FFFFFF;
}
.hh-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}
.medals {
  margin-top: 28rpx;
  display: flex;
  gap: 16rpx;
}
.medal {
  flex: 1;
  background: rgba(255,255,255,0.1);
  border-radius: 16rpx;
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.medal-v {
  font-size: 32rpx;
  font-weight: 800;
  color: #B9FF66;
}
.medal-l {
  font-size: 20rpx;
  color: rgba(255,255,255,0.6);
}

/* 荣誉列表 */
.sec-title {
  margin: 40rpx 0 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A23;
}
.honor-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.honor-medal {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.honor-medal-txt {
  font-size: 34rpx;
  font-weight: 800;
  color: #FFFFFF;
}
.honor-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A23;
}
.honor-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-300);
}

/* 查看更多 */
.more-btn {
  margin-top: 20rpx;
  background: #1A1A23;
  border-radius: 44rpx;
  padding: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.more-txt {
  font-size: 28rpx;
  font-weight: 700;
  color: #B9FF66;
}