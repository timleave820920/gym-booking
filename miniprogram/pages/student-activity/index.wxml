<view class="page">
  <!-- 顶部问候 -->
  <view class="page-pad pt-safe">
    <view class="flex-between">
      <view class="flex-col">
        <text class="greet-title">{{greeting}}</text>
        <text class="greet-date">{{user.date}}</text>
      </view>
    </view>

    <!-- 活动 Banner → 活动中心 -->
    <view class="banner" bindtap="goMemberCenter">
      <text class="banner-tag">MEMBER CENTER</text>
      <text class="banner-title">会员活动中心</text>
      <text class="banner-sub">会员特权 · 储值优惠 · 邀请有礼</text>
      <view class="banner-btn"><view class="ico ico-enter"></view><text>进入</text></view>
      <image class="banner-img" src="/images/2_166.png" mode="aspectFill"></image>
      <view class="banner-deco"></view>
    </view>

    <!-- 功能入口（7 项，2026-08-14 图标+名称，纯线性 SVG 同 icon-* 语言） -->
    <view class="entry-grid">
      <view class="entry-item" bindtap="goEntry" data-url="/pages/member-level/index">
        <view class="entry-ico ent-lv"></view>
        <text class="entry-name">会员等级</text>
      </view>
      <view class="entry-item" bindtap="goEntry" data-url="/pages/member-recharge/index">
        <view class="entry-ico ent-recharge"></view>
        <text class="entry-name">储值会员</text>
      </view>
      <view class="entry-item" bindtap="goEntry" data-url="/pages/invite/index">
        <view class="entry-ico ent-invite"></view>
        <text class="entry-name">邀请好友</text>
      </view>
      <view class="entry-item" bindtap="goEntry" data-url="/pages/passes-buy/index">
        <view class="entry-ico ent-pass"></view>
        <text class="entry-name">次卡包</text>
      </view>
      <view class="entry-item" bindtap="goEntry" data-url="/pages/coin-shop/index">
        <view class="entry-ico ent-coin"></view>
        <text class="entry-name">能量商店</text>
      </view>
      <view class="entry-item" bindtap="goEntry" data-url="/pages/about-us/index">
        <view class="entry-ico ent-idea"></view>
        <text class="entry-name">场馆理念</text>
      </view>
      <view class="entry-item" bindtap="goEntry" data-url="/pages/honors/index">
        <view class="entry-ico ent-trophy"></view>
        <text class="entry-name">参赛荣誉</text>
      </view>
    </view>

    <!-- 今日课程 -->
    <view class="flex-between hot-head">
      <text class="section-title">{{t.todayCourses}}</text>
      <view class="flex-row more" bindtap="goCourses">
        <text class="more-txt">{{t.viewAll}}</text>
        <text class="icon-chevron"></text>
      </view>
    </view>

    <!-- 后端不可用提示 -->
    <text class="offline-tip" wx:if="{{offline}}">后端未连接，当前展示演示数据</text>

    <view class="hot-list">
      <view class="course-card {{item.disabled ? 'card-off' : ''}}" wx:for="{{hotCourses}}" wx:key="id"
            bindtap="goDetail" data-id="{{item.id}}" data-disabled="{{item.disabled}}" data-waitlist="{{item.canWaitlist}}">
        <!-- 剩余席位 0：金色"满员"斜条；1~5：红色"紧张"斜条 -->
        <view class="ribbon ribbon-full" wx:if="{{item.remaining === 0}}">满员</view>
        <view class="ribbon" wx:if="{{item.remaining > 0 && item.remaining < 5}}">紧张</view>

        <!-- 左上角圆点徽章（方案C） -->
        <view class="cb-dot"></view>

        <view class="cb-main">
          <!-- 顶行：教练头像（点击进教练介绍页）+ 课程名 + 难度点阵 -->
          <view class="cb-top">
            <image class="cb-avatar" src="{{item.coachAvatar}}" mode="aspectFill" data-idx="{{index}}" binderror="avatarError"
                   catchtap="goCoachProfile" data-coach-id="{{item.coachId}}"></image>
            <view class="cb-title">
              <text class="cb-name">{{item.name}}</text>
              <text class="cb-desc" wx:if="{{item.description}}">{{item.description}}</text>
            </view>
            <!-- 难度哑铃：余位>=5时显示；满员(0)/紧张(<5)斜条出现时隐藏 -->
            <view class="cb-stars" wx:if="{{item.remaining >= 5}}">
              <view class="cb-dumbbell" wx:for="{{[1,2,3,4,5]}}" wx:for-item="sIdx" wx:key="*this"
                    wx:if="{{sIdx <= item.level}}"></view>
            </view>
          </view>

          <!-- 中行：大数字时间 + 剩余席位读数 -->
          <view class="cb-mid">
            <text class="cb-time">{{item.start}} – {{item.end}}</text>
            <view class="cb-seats {{item.isFull ? 'cb-seats-full' : ''}}">
              <view class="icon-person"></view>
              <text class="cb-seat-num {{item.isFull ? 'cb-seat-zero' : ''}}">{{item.booked}}/{{item.capacity}}</text>
            </view>
          </view>

          <!-- 底行：价格（会员价紧跟右侧）+ 按钮 -->
          <view class="cb-bottom">
            <view class="cb-price">¥{{item.price}}<text class="cb-price-mem">（会员 ¥{{item.memberPrice}}）</text></view>
            <view class="cb-btn {{item.isBooked ? 'btn-booked' : ((item.waitlisted || item.canWaitlist) ? 'btn-waitlist' : (item.isFull ? 'btn-full' : (item.status === 'ongoing' ? 'btn-ongoing' : (item.status === 'ended' ? 'btn-ended' : ''))))}}" catchtap="goDetail" data-id="{{item.id}}" data-disabled="{{item.disabled}}" data-waitlist="{{item.canWaitlist}}">
              <view class="ico ico-booked" wx:if="{{item.isBooked}}"></view>
              <view class="ico ico-waitlist" wx:elif="{{item.waitlisted || item.canWaitlist}}"></view>
              <view class="ico ico-full" wx:elif="{{item.isFull}}"></view>
              <view class="ico ico-ongoing" wx:elif="{{item.status === 'ongoing'}}"></view>
              <view class="ico ico-ended" wx:elif="{{item.status === 'ended'}}"></view>
              <view class="ico ico-book" wx:else></view>
              <text wx:if="{{item.isBooked}}">已约</text>
              <text wx:elif="{{item.waitlisted}}">{{t.waitlisted}}</text>
              <text wx:elif="{{item.canWaitlist}}">{{t.waitlistBtn}}</text>
              <text wx:elif="{{item.isFull}}">已满</text>
              <text wx:elif="{{item.status === 'ongoing'}}">{{t.ongoing}}</text>
              <text wx:elif="{{item.status === 'ended'}}">{{t.ended}}</text>
              <text wx:else>预约</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 骨架屏：无缓存首屏加载时展示（替代白屏等待） -->
      <view class="sk-list" wx:if="{{!loaded}}">
        <view class="sk-card" wx:for="{{[1,2,3]}}" wx:key="*this">
          <view class="sk-row">
            <view class="sk-avatar"></view>
            <view class="sk-lines">
              <view class="sk-line w60"></view>
              <view class="sk-line w40"></view>
            </view>
          </view>
          <view class="sk-row">
            <view class="sk-line w30"></view>
            <view class="sk-chip"></view>
          </view>
          <view class="sk-row">
            <view class="sk-line w15"></view>
            <view class="sk-btn"></view>
          </view>
        </view>
      </view>

      <!-- 今日暂无课程 -->
      <view class="empty-today flex-col" wx:if="{{loaded && hotCourses.length === 0}}">
        <text class="empty-icon">▦</text>
        <text class="empty-txt">{{t.noTodayCourse}}</text>
      </view>
    </view>

    <view class="list-spacer"></view>
  </view>
</view>
