.page {
  min-height: 100vh;
  background: #F9F4DF;
}
.page-pad {
  padding: 24rpx 24rpx 60rpx;
}
.pt-safe {
  padding-top: 24rpx;
}

/* 会员卡 */
.card {
  background: #1A1A23;
  border-radius: 24rpx;
  padding: 32rpx;
}
.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.card-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
}
.card-lv {
  background: #B9FF66;
  border: 3rpx solid #1A1A23;
  border-radius: 16rpx;
  padding: 4rpx 16rpx;
}
.card-lv-txt {
  font-size: 22rpx;
  font-weight: 700;
  color: #1A1A23;
}
.card-no {
  display: block;
  margin-top: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.7);
}
.card-user {
  display: block;
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: #FFFFFF;
}
.card-mid {
  margin-top: 32rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  border-top: 2rpx solid rgba(255,255,255,0.15);
  padding-top: 24rpx;
}
.card-bal-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
}
.card-bal-value {
  font-size: 36rpx;
  font-weight: 800;
  color: #B9FF66;
}

/* 会员码 */
.scan-card {
  margin-top: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.qr-box {
  width: 120rpx;
  height: 120rpx;
  background: #1A1A23;
  border: 3rpx solid #B9FF66;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.qr-txt {
  font-size: 64rpx;
  color: #B9FF66;
}
.scan-t1 {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A23;
}
.scan-t2 {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--ink-300);
}

/* 快捷入口 */
.sec-title {
  margin: 40rpx 0 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A23;
}
.quicks {
  display: flex;
  gap: 16rpx;
}
.quick {
  flex: 1;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.quick-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.quick-icon-txt {
  font-size: 26rpx;
  font-weight: 800;
}
.qi-purple { background: #5B57EB; }
.qi-lime { background: #B9FF66; }
.qi-red { background: #F8B7B8; }
.qi-purple .quick-icon-txt { color: #FFFFFF; }
.qi-lime .quick-icon-txt, .qi-red .quick-icon-txt { color: #1A1A23; }
.quick-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #1A1A23;
}