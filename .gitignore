# 项目数据与本地缓存（不入库）
# 2026-08-16：.workbuddy/ 会话日志入库（评审 #4 价值：知识资产必须版本控制，本地独有数据=随时蒸发）

# 预览二维码（临时产物）
preview-qrcode.*

# 微信开发者工具本地配置（含用户级信息）
project.private.config.json
# minitest 是测试资产，入库（仅忽略运行时产物）
minitest/report.json

# 系统文件
.DS_Store
Thumbs.db
*.log

# Node 依赖（如后续引入 npm 构建）
node_modules/

# 后端数据库（本地数据，不入库）
server/data/*.db

# 局域网 IP 自动适配说明：
# miniprogram/utils/net-config.json 必须「不在」gitignore——微信开发者工具会过滤
# gitignore 文件导致它打不进预览包，真机回退 127.0.0.1 连不上后端（BUG-LEDGER #6）。
# git 侧改用 .git/info/exclude 忽略（不随仓库走，不影响工具打包）。
server/data/*.db-shm
server/data/*.db-wal
server/data/*.db.bak*
server/data/*.tmp

# 关键操作日志（运行时产物，不入库）
server/logs/

# 环境变量（含 AppSecret，严禁入库）
server/.env
.env

# Claude Code 个人本地配置（机器路径+会话授权，不入库）
.claude/settings.local.json
