<view class="tabbar-wrap safe-bottom">
  <view class="tabbar-pill">
    <view class="tab-item {{selected === index ? 'active' : ''}}"
          wx:for="{{list}}" wx:key="pagePath"
          data-index="{{index}}" data-path="{{item.pagePath}}"
          bindtap="switchTab">
      <view class="tab-icon {{'ic-' + item.icon}}"></view>
      <text>{{item.text}}</text>
    </view>
  </view>
</view>
