.page {
  min-height: 100vh;
  background: #F9F4DF;
  padding-bottom: 200rpx;
}
.pt-16 { padding-top: 16rpx; }

/* 课程信息卡 */
.course-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.05);
}
.course-cover {
  width: 152rpx; height: 152rpx;
  border-radius: 24rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.course-info { justify-content: center; }
.course-name {
  font-size: 30rpx; font-weight: 700; color: #1A1A23;
}
.course-meta {
  font-size: 24rpx; color: #6B6B76;
  margin-top: 8rpx;
}
.course-price {
  font-size: 30rpx; font-weight: 700; color: #1A1A23;
  margin-top: 12rpx;
}

/* 金额卡 */
.amount-card {
  margin-top: 32rpx;
  height: 260rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #5B57EB 0%, #7B6CD9 100%);
  align-items: center;
  justify-content: center;
}
.amount-label {
  font-size: 26rpx; color: #DCD8FF;
}
.amount-value {
  font-size: 80rpx; font-weight: 800; color: #FFFFFF;
  margin-top: 8rpx;
}

/* 支付方式 */
.section-title {
  margin-top: 40rpx;
  font-size: 32rpx; font-weight: 700; color: #1A1A23;
}
.method-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.method-row {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  border: 4rpx solid transparent;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.04);
  align-items: center;
}
.method-selected {
  border-color: #B9FF66;
}
.method-left {
  align-items: center;
}
.method-icon {
  width: 52rpx; height: 52rpx;
  border-radius: 14rpx;
  margin-right: 20rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}
.icon-wallet {
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><rect x="3" y="6" width="18" height="14" rx="2" stroke="%235B57EB" stroke-width="2"/><path d="M3 10H21" stroke="%235B57EB" stroke-width="2"/><circle cx="16.5" cy="15.5" r="1.5" fill="%235B57EB"/></svg>');
}
.icon-card {
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><rect x="2" y="5" width="20" height="14" rx="2" stroke="%235B57EB" stroke-width="2"/><path d="M2 10H22" stroke="%235B57EB" stroke-width="2"/><path d="M6 15H12" stroke="%235B57EB" stroke-width="2" stroke-linecap="round"/></svg>');
}
.method-name {
  font-size: 30rpx; font-weight: 600; color: #1A1A23;
}
.method-desc {
  font-size: 22rpx; color: #6B6B76;
  margin-top: 4rpx;
}
.radio {
  width: 44rpx; height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #C9C7BC;
  display: flex;
  align-items: center;
  justify-content: center;
}
.radio-on {
  border-color: #1A1A23;
  background: #B9FF66;
}
.radio-dot {
  width: 16rpx; height: 16rpx;
  border-radius: 50%;
  background: #1A1A23;
}

.spacer { height: 40rpx; }

/* 底部 CTA */
.cta-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #FFFFFF;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 32rpx rgba(0,0,0,0.06);
  align-items: center;
  z-index: 50;
}
.cta-price {
  font-size: 40rpx; font-weight: 800; color: #1A1A23;
}
.cta-sub {
  font-size: 22rpx; color: #6B6B76;
}
.pay-btn {
  background: #B9FF66;
  color: #1A1A23;
  font-size: 32rpx; font-weight: 700;
  width: 440rpx; height: 104rpx;
  border-radius: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(185,255,102,0.5);
}

/* 会员折扣提示 */
.member-tip {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #5B57EB;
  font-weight: 600;
}

/* 候补自动取消时间 */
.expire-section {
  margin-top: 40rpx;
}
.expire-sub {
  display: block;
  font-size: 24rpx;
  color: #8A8A8A;
  margin: 8rpx 0 20rpx;
}
.expire-list {
  gap: 20rpx;
}
.expire-item {
  flex: 1;
  align-items: center;
  padding: 24rpx 0;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 3rpx solid #E8E2CC;
}
.expire-on {
  border-color: #1A1A23;
  background: #1A1A23;
}
.expire-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A23;
}
.expire-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8A8A8A;
}
.expire-on .expire-name { color: #B9FF66; }
.expire-on .expire-desc { color: rgba(255,255,255,0.6); }
