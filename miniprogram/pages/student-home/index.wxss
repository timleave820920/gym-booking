.page {
  min-height: 100vh;
  background: #F9F4DF;
  padding-bottom: 220rpx;
}
.pt-safe {
  padding-top: calc(88rpx + env(safe-area-inset-top));
}

.greet-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1A1A23;
}
.greet-date {
  font-size: 26rpx;
  color: #6B6B76;
  margin-top: 8rpx;
  display: block;
}
.bell-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
}
.icon-bell {
  width: 40rpx; height: 40rpx;
  border-radius: 12rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M6 8C6 4.69 8.69 2 12 2C15.31 2 18 4.69 18 8V11C18 14.5 19.5 16 19.5 16H4.5C4.5 16 6 14.5 6 11V8Z" stroke="%231A1A23" stroke-width="2"/><path d="M10.3 20C10.73 20.61 11.31 21 12 21C12.69 21 13.27 20.61 13.7 20" stroke="%231A1A23" stroke-width="2" stroke-linecap="round"/></svg>') no-repeat center/contain;
}

/* Banner */
.banner {
  position: relative;
  margin-top: 32rpx;
  height: 300rpx;
  border-radius: 40rpx;
  overflow: hidden;
  background: linear-gradient(120deg, #FF6B35 0%, #FFCB47 100%);
}
.banner-tag {
  position: absolute; top: 36rpx; left: 40rpx;
  color: #FFFFFF; font-size: 24rpx; font-weight: 700;
  letter-spacing: 4rpx;
}
.banner-title {
  position: absolute; top: 88rpx; left: 40rpx;
  color: #1A1A23; font-size: 56rpx; font-weight: 900;
}
.banner-sub {
  position: absolute; top: 164rpx; left: 40rpx;
  color: #FFFFFF; font-size: 26rpx;
}
.banner-btn {
  position: absolute; top: 216rpx; left: 40rpx;
  background: #1A1A23; color: #FFFFFF;
  font-size: 26rpx; font-weight: 600;
  padding: 12rpx 32rpx; border-radius: 30rpx;
}
.banner-img {
  position: absolute; right: 0; top: 0;
  width: 300rpx; height: 300rpx;
}
.banner-deco {
  position: absolute; right: 80rpx; top: -40rpx;
  width: 180rpx; height: 180rpx; border-radius: 50%;
  background: linear-gradient(120deg, #B9FF66 0%, rgba(91,87,235,0.8) 100%);
}

/* 热门课程 */
.hot-head { margin-top: 40rpx; }
.section-title {
  font-size: 36rpx; font-weight: 700; color: #1A1A23;
}
.more { align-items: center; }
.more-txt { color: #6B6B76; font-size: 26rpx; margin-right: 4rpx; }
.icon-chevron {
  width: 28rpx; height: 28rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><path d="M9 6L15 12L9 18" stroke="%236B6B76" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>') no-repeat center/contain;
}

.hot-list { margin-top: 24rpx; display: flex; flex-direction: column; gap: 28rpx; }
.course-card {
  position: relative;
  overflow: hidden;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.05);
  display: flex;
  align-items: center;
  gap: 24rpx;
}
/* 教练圆形头像 */
.coach-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  border: 3rpx solid #1A1A23;
  background: #F0EDDF;
  flex-shrink: 0;
}
.course-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
/* 顶部：课程名（大字号） */
.course-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #1A1A23;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 时间（中等字号） */
.time-txt {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #6B6B76;
}
/* 价格 + 会员价（中等字号） */
.price-row {
  margin-top: 8rpx;
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}
.price-txt {
  font-size: 28rpx;
  font-weight: 800;
  color: #1A1A23;
}
.member-txt {
  font-size: 24rpx;
  color: #B0AFA8;
}
/* 难度与席位（小字号） */
.meta-small {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #B0AFA8;
}
.book-btn {
  background: #B9FF66;
  color: #1A1A23;
  font-size: 24rpx; font-weight: 700;
  padding: 12rpx 28rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
}
/* 已预订：按钮用品牌深色 */
.btn-booked {
  background: #1A1A23;
  color: #B9FF66;
}
/* 已排位 / 候补排位：按钮紫色 */
.btn-waitlist {
  background: #5B57EB;
  color: #FFFFFF;
}
/* 满员：按钮置灰 */
.btn-full {
  background: #E5E2D4;
  color: #B0AFA8;
}
/* 进行中（红）/ 已结束（灰） */
.btn-ongoing {
  background: #E5484D;
  color: #FFFFFF;
}
.btn-ended {
  background: #E0DCCB;
  color: #8A8A8A;
}
/* 不可约状态：整卡弱化 */
.card-off {
  opacity: 0.72;
}
/* 剩余席位 <5：右上角"紧张"斜条 */
.ribbon {
  position: absolute;
  top: 22rpx;
  right: -76rpx;
  transform: rotate(45deg);
  background: #E5484D;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 90rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(229,72,77,0.3);
}
.offline-tip {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #B0AFA8;
  padding: 16rpx 0 0;
}
/* 今日无课空状态 */
.empty-today {
  align-items: center;
  padding: 80rpx 0;
}
.empty-today .empty-icon {
  font-size: 72rpx;
  color: #D9D4C0;
}
.empty-today .empty-txt {
  margin-top: 16rpx;
  color: #B0AFA8;
  font-size: 26rpx;
}

.list-spacer { height: 60rpx; }
